{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_VERIFY_CMD": "python3 -m unittest discover -s plugins/harness/tests"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(harness-pr:*)",
      "Bash(harness-board:*)",
      "Bash(harness-work:*)",
      "Bash(harness-red:*)",
      "Bash(harness-scaffold:*)",
      "Bash(harness-digest:*)",
      "Bash(harness-standup:*)",
      "Bash(harness-projects:*)",
      "Bash(harness-worklog:*)"
    ]
  }
}
