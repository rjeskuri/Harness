#!/usr/bin/env python3
"""
The board: a project's GitHub Issues as the harness's tickets. An epic is an issue labeled `epic`, its
tasks are sub-issues, dependencies are GitHub's blocked-by, and status, type, size, risk and flags are
labels. `show` keeps a local cache of each ticket at
~/.claude/harness/repos/<repo-key>/tickets/<N>.json for the hooks and the other harness tools.

Usage:
    harness-board labels ensure
    harness-board epic create --title T --body-file F [--size S|M|L] [--risk low|high] [--proposed]
    harness-board task create --title T --body-file F [--parent N] [--type task|bug|chore|refactor]
                              [--size S|M|L] [--risk low|high] [--blocked-by N[,N]]
                              [--no-tests] [--needs-local] [--priority] [--proposed]
    harness-board show N [--markdown]
    harness-board ready
    harness-board status N ready|in-progress|in-review|blocked|needs-input|proposed [--comment TEXT]
    harness-board promote N    # a proposed epic and its open proposed tasks, or a proposed task, to ready
    harness-board comment N (--body TEXT | --body-file F)
    harness-board needs-input N --question TEXT [--evidence-file F]
    harness-board answers N [--since ISO]   # the owner's replies since the last needs-input question
    harness-board close N [--comment TEXT]
    harness-board epic-check N
    harness-board board
    harness-board tier N [--stage review]
    harness-board project check
    harness-board project sync [--repo PATH | --all-projects] [--dry-run]
    Every subcommand but `project` takes --repo PATH (default: CLAUDE_PROJECT_DIR, else the cwd's repository)
    and --json.

Every comment posted here ends with the line `<!-- harness -->` (hidden on GitHub), so `answers` can tell the
harness's own comments, posted under the owner's account, from the owner's replies.

With HARNESS_PROJECT=OWNER/NUMBER (the environment first, where an empty value means off; else `env` in
~/.claude/settings.json), `epic create` and `task create` add the issue to that GitHub Projects board with
Status Ready (and Priority High for `task create --priority`), and every status change sets the item's Status.
`status:proposed` has no Status on the board: a `--proposed` create only adds the item, `status N proposed` writes
no Status, and `project sync` leaves a proposed issue's Status as it is.
The labels stay the source of truth: a failed project call is one warning on stderr and never fails the command.
`project check` (gh project field-list) names each Status or Priority option the board lacks and exits 1 if any.
`project sync` reads the board (gh project item-list) and the open issues of the repository, or of every project
in ~/.claude/harness/projects.json with --all-projects, adds the missing issues and corrects Status and Priority
drift from the labels (an unset Priority counts as Normal, so only High against Normal is drift), one line per
change; --dry-run prints the lines and writes nothing. Both need the setting.

gh is HARNESS_GH when set, else `gh` on PATH.
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import time

_LIB = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)
try:
    from harness_lib.paths import adopt_old_state, canonical_path, path_key, repo_key, same_entry
    from harness_lib.cli import Parser, Problem, emit, exit_problem, issue_number, run_main, table, warn
    from harness_lib.text import (as_list, first_line, harness_home, home, now_iso, one_line, parse_iso, read_json,
                                  read_text, write_json)
    from harness_lib.notify import notify
    from harness_lib.repo import RepoError, repo_facts
    from harness_lib.registry import load_registry
    from harness_lib.gh import describe, gh as lib_gh, gh_json as lib_gh_json
    from harness_lib.routing import cached_code_route, code_route, label_tier, load_routing, review_route
except Exception as exc:  # no state key can be guessed without the lib: one line, exit 1
    sys.exit(f"harness-board: cannot load harness_lib from {_LIB}: {' '.join(str(exc).split())}")

# name, color, meaning (the meaning is the label's description on GitHub)
LABELS = [
    ("epic", "5319E7", "A goal; its tasks are sub-issues"),
    ("task", "0E8A16", "A unit of work under an epic"),
    ("bug", "D73A4A", "Something is broken"),
    ("chore", "BFD4F2", "Upkeep: tooling, config, docs, lessons"),
    ("refactor", "C2E0C6", "Restructure without changing behavior"),
    ("status:ready", "0052CC", "Ready to work on"),
    ("status:in-progress", "FBCA04", "An agent is working on it"),
    ("status:in-review", "D4C5F9", "A pull request awaits your review"),
    ("status:blocked", "B60205", "Cannot proceed; see the comments"),
    ("status:needs-input", "E99695", "Waiting for your answer in a comment"),
    ("status:proposed", "BFE5BF", "A plan waiting for you to promote it"),
    ("size:S", "C5DEF5", "One sitting, one or two files"),
    ("size:M", "BFDADC", "A few files, under the size cap"),
    ("size:L", "F9D0C4", "The cap: about 5 files or 300 lines; anything bigger is split"),
    ("risk:low", "E6E6E6", "Ordinary change"),
    ("risk:high", "B60205", "Data loss, money, live systems, security, minors' data"),
    ("no-tests", "EDEDED", "Docs or config only; exempt from tests-first"),
    ("needs-local", "FEF2C0", "Needs this Mac's files or credentials"),
    ("priority:high", "FF7F0E", "Dispatched first"),
    ("manual-land", "D93F0B", "Land by hand: autoland skips it"),
    ("incident", "B60205", "A live check failed; autoland is paused in this repo"),
    ("degraded", "FBCA04", "A live check is degraded; nothing was reverted"),
    ("deploy-frozen", "000000", "Deploys are stopped until you clear this"),
]
TYPES = ("epic", "bug", "refactor", "chore", "task")          # the first present wins
TASK_TYPES = ("task", "bug", "chore", "refactor")
STATUSES = ("ready", "in-progress", "in-review", "blocked", "needs-input", "proposed")
STATUS_TITLES = {"ready": "Ready", "in-progress": "In progress", "in-review": "In review", "blocked": "Blocked",
                 "needs-input": "Needs input", "proposed": "Proposed"}
MIRRORED = tuple(s for s in STATUSES if s != "proposed")   # the statuses with a Status option on the Projects board
FLAGS = ("no-tests", "needs-local", "priority:high")
TIERS = ("sonnet", "opus", "fable")
SECTIONS = [("Request", "request"), ("Outline", "outline"), ("Definition of done", "definition_of_done"),
            ("Tests that must pass", "tests"), ("Context", "context")]
ISSUE_FIELDS = "number,title,url,body,labels,state,parent,blockedBy,comments"
PRESERVED = (("branch", None), ("worktree", None), ("started_at", None), ("attempts", []))
NEEDS_INPUT = "**Needs your input**"
RESOLUTION = "**Resolution**"   # the comment `harness-pr land` posts on a ticket it lands
MARKER = "<!-- harness -->"     # the last line of every comment posted here
BOT_LOGINS = ("github-actions[bot]", "github-actions")   # the deploy guard's author (REST, GraphQL), casefolded
# the harness's own comments from before the marker, as their bodies start
HARNESS_PREFIXES = (NEEDS_INPUT, "Started on ", "PR #", "Landed in ")
EPIC_DONE = "All tasks landed."
CONTEXT_LINES = 120     # the most lines `show --markdown` prints
COMMENTS_SHOWN = 10     # the newest comments in the context
COMMENT_LINES = 20      # lines shown of each
EVIDENCE_LINES = 60     # lines of evidence in a needs-input comment
LIST_LIMIT = "200"
GH_TIMEOUT = 60         # seconds per gh call
LINK_RETRY_DELAY = 1.0  # seconds before the one retry of a sub-issue link
PROJECT_SETTING = "HARNESS_PROJECT"   # OWNER/NUMBER of the Projects board the status is mirrored to
PROJECT_VALUE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[1-9][0-9]*")
PROJECT_FIELDS = (("Status", [STATUS_TITLES[s] for s in MIRRORED] + ["Done"]), ("Priority", ["High", "Normal"]))
FIELD_LIMIT = "100"     # a project holds at most 50 fields
ITEM_LIMIT = "1000"     # the board items project sync reads
ISSUE_LIMIT = "1000"    # the open issues per repository project sync reads
CHECKBOX = re.compile(r"^[-*+]\s+\[[ xX]\]")
BULLET = re.compile(r"^\s*(?:[-*+]|\d+[.)])\s+(.*\S)")
HEADING = re.compile(r"^##\s+(.*?)\s*#*\s*$")
FENCE = re.compile(r"^\s{0,3}(```|~~~)")


# --------------------------------------------------------------- the repository
def git(path, *args):
    try:
        return subprocess.run(["git", "-C", path] + list(args), capture_output=True, text=True,
                              stdin=subprocess.DEVNULL, timeout=30)
    except FileNotFoundError:
        raise Problem("git not found on PATH") from None
    except subprocess.TimeoutExpired:
        raise Problem(f"git {args[0]} timed out in {path}") from None


class Repo:
    """The project: its toplevel, its main working tree, its state key and (on demand) OWNER/REPO and the routing
    settings."""

    def __init__(self, path):
        try:
            self.root, _common_dir, self.main, self.key = repo_facts(path, git, first_line)
        except RepoError as exc:
            raise Problem(str(exc)) from None
        self.name = os.path.basename(self.main)
        remotes = git(self.root, "remote")
        if remotes.returncode != 0 or not remotes.stdout.split():
            raise Problem(f"{self.main} has no git remote; the board lives in the project's GitHub repository "
                          "(gh repo create, or git remote add origin <url>)")
        self._slug = None
        self._routing = None

    def slug(self):
        """OWNER/REPO, from gh repo view (once)."""
        if self._slug is None:
            data = gh_json(self, ["repo", "view", "--json", "nameWithOwner"])
            slug = data.get("nameWithOwner") if isinstance(data, dict) else None
            if not isinstance(slug, str) or "/" not in slug:
                raise Problem("gh repo view did not name the repository (nameWithOwner missing)")
            self._slug = slug
        return self._slug

    def routing(self):
        """The routing settings (harness_lib.routing) of the main checkout, loaded once; each invalid value is one
        warning, printed then."""
        if self._routing is None:
            self._routing = load_routing(self.main)
            for problem in self._routing["problems"]:
                warn("harness-board", problem)
        return self._routing

    def ticket_path(self, number):
        return harness_home("repos", self.key, "tickets", f"{number}.json")


def open_repo(path):
    return Repo(path or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())


# --------------------------------------------------------------- gh
def gh(repo, args, stdin=None):
    """Run gh in the repository (None: the cwd), through harness_lib.gh; its stdout, or Problem naming the call and
    gh's first stderr line."""
    return lib_gh(args, repo.root if repo else None, stdin, GH_TIMEOUT, pick=first_line)


def gh_json(repo, args):
    """gh's output decoded as JSON (through this module's gh); Problem when it is not JSON."""
    return lib_gh_json(args, repo.root if repo else None, pick=first_line, via=lambda a, c: gh(repo, a))


def created_issue(out):
    """(number, url) from `gh issue create` output: the last issue URL it printed."""
    found = re.findall(r"https?://\S+/issues/(\d+)", out)
    urls = re.findall(r"https?://\S+/issues/\d+", out)
    if not found:
        raise Problem(f"gh issue create printed no issue URL: {first_line(out)[:80]}")
    return int(found[-1]), urls[-1]


def label_args(labels):
    out = []
    for name in labels:
        out += ["--label", name]
    return out


def body_file(path):
    """(the --body-file argument, stdin text): an absolute path, or `-` with stdin read here."""
    if path == "-":
        return "-", sys.stdin.read()
    full = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(full):
        raise Problem(f"no such file: {path}")
    return full, None


def marked(body):
    """The comment body with MARKER as its own last line (once)."""
    text = (body or "").rstrip()
    lines = text.splitlines()
    if lines and lines[-1].strip() == MARKER:
        return text
    return f"{text}\n\n{MARKER}" if text else MARKER


def by_harness(body):
    """Was this comment posted by the harness? The marker, or (older comments) a body the harness writes."""
    body = body or ""
    return MARKER in body or body.lstrip().startswith(HARNESS_PREFIXES)


# --------------------------------------------------------------- the Projects board mirror
def settings_project():
    """env.HARNESS_PROJECT of ~/.claude/settings.json when that parses as a JSON object and it is a string."""
    try:
        data = read_json(home(".claude", "settings.json"))
    except RecursionError:                      # deeply nested JSON: read_json lets it through
        return None
    env = data.get("env") if isinstance(data, dict) else None
    value = env.get(PROJECT_SETTING) if isinstance(env, dict) else None
    return value if isinstance(value, str) else None


def project_value():
    """HARNESS_PROJECT as set: the environment first (an empty value is off), else the settings file."""
    value = os.environ.get(PROJECT_SETTING)
    return settings_project() if value is None else value


def project_setting():
    """(owner, number) of the board to mirror to, or None: the environment first (an empty value is off), else
    the settings file. A value that is not OWNER/NUMBER is one warning and no mirroring."""
    value = project_value()
    if not value:
        return None
    if not PROJECT_VALUE.fullmatch(value):
        warn("harness-board", f"{PROJECT_SETTING}={value!r} is not OWNER/NUMBER; the Projects board is not updated")
        return None
    owner, number = value.split("/")
    return owner, number


def mirror(repo, project, url, fields, add=False):
    """Add the issue at `url` to the board (when `add`), then set each (field, option) by name. The first failing
    call stops the rest with one warning; the labels already changed, so this never fails the command."""
    owner, number = project
    target = [number, "--owner", owner, "--url", url]
    calls = ([["project", "item-add"] + target] if add else []) + \
        [["project", "item-edit"] + target + ["--field", field, "--value", value] for field, value in fields]
    for call in calls:
        try:
            gh(repo, call)
        except Problem as err:
            warn("harness-board", f"the Projects board {owner}/{number} was not updated: {err}")
            return


def mirror_created(repo, url, priority=False, proposed=False):
    """Add a new issue to the board with Status Ready; a proposed one gets no Status."""
    project = project_setting()
    if project:
        mirror(repo, project, url, ([] if proposed else [("Status", "Ready")])
               + ([("Priority", "High")] if priority else []), add=True)


# --------------------------------------------------------------- labels, tiers, the cache
def label_names(labels):
    names = []
    for label in labels if isinstance(labels, list) else as_list(labels):
        name = label.get("name") if isinstance(label, dict) else label
        if isinstance(name, str) and name:
            names.append(name)
    return names


def label_kind(names, closed=False):
    """type, status, size, risk and flags from label names."""
    present = set(names)
    kind = next((t for t in TYPES if t in present), "task")
    status = "closed" if closed else next((s for s in STATUSES if "status:" + s in present), None)
    size = next((s for s in ("L", "M", "S") if "size:" + s in present), None)
    risk = "high" if "risk:high" in present else "low" if "risk:low" in present else None
    return {"type": kind, "status": status, "size": size, "risk": risk, "flags": [f for f in FLAGS if f in present]}


def routing_for(repo):
    """The repository's routing settings (Repo.routing); with no repository (None, as for gh: the cwd), the cwd's."""
    return repo.routing() if repo is not None else load_routing(os.getcwd())


def classify(repo, names, closed=False):
    """label_kind plus `tier`, the effective code tier: HARNESS_CODE_TIER when set, else the labels' tier."""
    kind = label_kind(names, closed)
    kind["tier"] = routing_for(repo)["code_tier"] or label_tier(kind["type"], kind["size"], kind["risk"])
    return kind


def read_cache(repo, number):
    data = read_json(repo.ticket_path(number))
    return data if isinstance(data, dict) else None


def refresh_cache(repo, number, labels=None, status=None):
    """Bring an existing cache in line after a change made here (best effort: the change itself succeeded)."""
    record = read_cache(repo, number)
    if record is None:
        return
    if labels is not None:
        record["labels"] = labels
        record.update(classify(repo, labels, closed=record.get("status") == "closed"))
    if status is not None:
        record["status"] = status
    try:
        write_json(repo.ticket_path(number), record, prefix=".ticket-")
    except OSError:
        pass


# --------------------------------------------------------------- the ticket body
def split_sections(body):
    """{lower-cased `## ` heading: its text}; headings inside code fences do not count."""
    sections, current, fenced = {}, None, False
    for line in (body or "").splitlines():
        if FENCE.match(line):
            fenced = not fenced
        elif not fenced:
            m = HEADING.match(line)
            if m:
                current = m.group(1).strip().rstrip(":").strip().lower()
                sections.setdefault(current, [])
                continue
        if current is not None:
            sections[current].append(line)
    return {k: "\n".join(v).strip("\n") for k, v in sections.items()}


def first_paragraph(text):
    lines = []
    for line in (text or "").strip().splitlines():
        if not line.strip():
            break
        lines.append(line.strip())
    return " ".join(lines)


def parse_sections(body):
    raw = split_sections(body)
    dod = raw.get("definition of done", "")
    tests = raw.get("tests that must pass", "")
    items = [m.group(1) for m in (BULLET.match(line) for line in tests.splitlines()) if m]
    return {"request": raw.get("request", "").strip(), "outline": raw.get("outline", "").strip(),
            "definition_of_done": [line.strip() for line in dod.splitlines() if CHECKBOX.match(line.strip())],
            "tests": items or [line.strip() for line in tests.splitlines() if line.strip()],
            "context": raw.get("context", "").strip()}


# --------------------------------------------------------------- show
def fetch_record(repo, number):
    """The ticket as the cache schema has it (plus `goal` and `tasks` for an epic), fetched now."""
    data = gh_json(repo, ["issue", "view", str(number), "--json", ISSUE_FIELDS])
    if not isinstance(data, dict):
        raise Problem(f"gh issue view {number} printed no issue")
    names = label_names(data.get("labels"))
    closed = str(data.get("state", "")).upper() == "CLOSED"
    kind = classify(repo, names, closed)
    record = {"number": int(data.get("number") or number), "title": data.get("title") or "",
              "url": data.get("url") or "", "type": kind["type"], "status": kind["status"],
              "size": kind["size"], "risk": kind["risk"], "flags": kind["flags"], "labels": names,
              "tier": kind["tier"], "parent": None, "blocked_by": [], "body": data.get("body") or "",
              "sections": parse_sections(data.get("body")), "comments": [], "fetched_at": now_iso()}
    parent = data.get("parent")
    if isinstance(parent, dict) and parent.get("number"):
        if parent.get("body") is None:          # gh's parent field carries no body: the goal needs it
            pdata = gh_json(repo, ["issue", "view", str(parent["number"]), "--json", "number,title,body"])
            parent = dict(parent, **(pdata if isinstance(pdata, dict) else {}))
        record["parent"] = {"number": int(parent["number"]), "title": parent.get("title") or "",
                            "goal": first_paragraph(split_sections(parent.get("body")).get("goal", ""))}
    for b in as_list(data.get("blockedBy")):
        if b.get("number"):
            record["blocked_by"].append({"number": int(b["number"]), "state": str(b.get("state", "")).upper()})
    for c in as_list(data.get("comments")):
        author = c.get("author") if isinstance(c.get("author"), dict) else {}
        record["comments"].append({"author": author.get("login") or "ghost", "created_at": c.get("createdAt") or "",
                                   "body": c.get("body") or ""})
    if record["type"] == "epic":
        record["goal"] = first_paragraph(split_sections(record["body"]).get("goal", ""))
        subs = gh_json(repo, ["api", f"repos/{repo.slug()}/issues/{number}/sub_issues?per_page=100"])
        record["tasks"] = [task_entry(repo, s) for s in (subs if isinstance(subs, list) else []) if isinstance(s, dict)]
    return record


def task_entry(repo, sub):
    closed = str(sub.get("state", "")).upper() == "CLOSED"
    kind = classify(repo, label_names(sub.get("labels")), closed)
    return {"number": sub.get("number"), "title": sub.get("title") or "", "state": "CLOSED" if closed else "OPEN",
            "type": kind["type"], "status": kind["status"], "size": kind["size"], "risk": kind["risk"],
            "tier": kind["tier"]}


def save_record(repo, record):
    old = read_cache(repo, record["number"]) or {}
    for key, default in PRESERVED:
        record[key] = old.get(key, default)
    try:
        write_json(repo.ticket_path(record["number"]), record, prefix=".ticket-")
    except OSError as err:
        raise Problem(f"cannot write {repo.ticket_path(record['number'])}: {err.strerror or err}") from None


def all_resolutions(comments):
    """[(index, lines)] of every `**Resolution**` comment, oldest first, each with its heading, marker and outer
    blank lines dropped; a ticket reopened and landed again carries one per landing."""
    out = []
    for i, c in enumerate(comments):
        body = (c.get("body") or "").strip()
        if body.startswith(RESOLUTION):
            lines = [line.rstrip() for line in body[len(RESOLUTION):].splitlines() if line.strip() != MARKER]
            while lines and not lines[0]:
                lines.pop(0)
            while lines and not lines[-1]:
                lines.pop()
            out.append((i, lines))
    return out


def newest_resolution(comments):
    """(index, lines) of the newest `**Resolution**` comment, as in `all_resolutions`; (None, []) when none."""
    found = all_resolutions(comments)
    return found[-1] if found else (None, [])


def task_resolutions(repo, tasks):
    """{task number: its newest Resolution's lines} for the closed tasks; a task whose comments cannot be read,
    or that has no Resolution, is left out."""
    out = {}
    for t in tasks:
        if t["state"] != "CLOSED" or not t.get("number"):
            continue
        try:
            data = gh_json(repo, ["issue", "view", str(t["number"]), "--json", "comments"])
        except Problem:
            continue
        _, lines = newest_resolution(as_list(data.get("comments")) if isinstance(data, dict) else [])
        if lines:
            out[t["number"]] = lines
    return out


def fitted_resolutions(entries, room, newest=0):
    """The (number, heading and lines) Resolutions as context lines within `room`: each printed whole when it
    fits, in order, and the rest named on one pointer line; never one cut part-way. The last `newest` entries
    (a ticket's own, one per landing) are fitted newest first, so the oldest landing is the one dropped."""
    blocks = [(number, [""] + block) for number, block in entries]
    if sum(len(block) for _, block in blocks) > room:
        room -= 2                                      # the pointer line and the blank before it
    split = len(blocks) - newest
    shown = set()
    for i in list(range(split)) + list(range(len(blocks) - 1, split - 1, -1)):
        if len(blocks[i][1]) <= room:
            shown.add(i)
            room -= len(blocks[i][1])
    out, left = [], []
    for i, (number, block) in enumerate(blocks):
        if i in shown:
            out += block
        elif number not in left:
            left.append(number)
    if left:
        where = f"gh issue view {left[0]} --comments" if len(left) == 1 else "gh issue view N --comments"
        out += ["", f"Not shown for lack of room: the Resolution of {', '.join(f'#{x}' for x in left)} ({where})"]
    return out


def context_markdown(record, resolutions=None, tier_from=None):
    """The ticket context: header, epic and blockers, the task list and the closed tasks' Resolutions
    (`resolutions`), the sections, a closed ticket's own Resolutions, then the newest comments that fit. `tier_from`
    names the setting that decided the tier, when one did."""
    n = record["number"]
    raw = split_sections(record.get("body"))
    state = "closed" if record.get("status") == "closed" else "open"
    origin = f" from {tier_from}" if tier_from else ""
    lines = [f"# #{n} {record['title']}",
             f"Labels: {', '.join(record['labels']) or 'none'} (tier {record['tier']}{origin}, {state})"]
    if record.get("url"):
        lines.append(record["url"])
    if record.get("goal"):
        lines.append(f"Goal: {record['goal']}")
    parent = record.get("parent")
    if parent:
        lines.append(f"Epic #{parent['number']}: {parent['title']}")
        if parent.get("goal"):
            lines.append(f"Epic goal: {parent['goal']}")
    if record["blocked_by"]:
        lines.append("Blocked by: " + ", ".join(f"#{b['number']} ({b['state'].lower() or 'unknown'})"
                                                for b in record["blocked_by"]))
    tasks = record.get("tasks")
    if tasks:
        done = sum(t["state"] == "CLOSED" for t in tasks)
        lines += ["", f"## Tasks ({done} of {len(tasks)} closed)"]
        for t in tasks:
            detail = "closed" if t["state"] == "CLOSED" else ", ".join(
                [t["status"] or "no status", t["size"] or "-", t["risk"] or "-", f"tier {t['tier']}"])
            lines.append(f"- #{t['number']} {t['title']} ({detail})")
    entries = [(t["number"], [f"### #{t['number']} {t['title']}: Resolution"] + (resolutions or {})[t["number"]])
               for t in tasks or [] if t["state"] == "CLOSED" and (resolutions or {}).get(t["number"])]
    at = len(lines)                                    # an epic's Resolutions go under its task list
    for heading, _ in SECTIONS:
        text = raw.get(heading.lower(), "").strip("\n")
        if text.strip():
            lines += ["", f"## {heading}"] + text.splitlines()
    comments = record["comments"]
    own = []
    if record.get("status") == "closed":
        own = [(index, body) for index, body in all_resolutions(comments) if body]
        if own:
            taken = {index for index, _ in own}
            comments = [c for i, c in enumerate(comments) if i not in taken]
            if not entries:
                at = len(lines)                        # a ticket's own Resolutions go after its sections
            for k, (_, body) in enumerate(own, 1):     # one per landing, oldest first
                heading = "## Resolution" if len(own) == 1 else f"## Resolution (landing {k} of {len(own)})"
                entries.append((n, [heading] + body))
    if entries:
        lines[at:at] = fitted_resolutions(entries, CONTEXT_LINES - len(lines) - 2, newest=len(own))
    blocks = []
    for c in comments[-COMMENTS_SHOWN:]:
        body = (c["body"] or "").strip("\n").splitlines()
        block = ["", f"**{c['author']}** ({c['created_at'][:10]}):"] + body[:COMMENT_LINES]
        if len(body) > COMMENT_LINES:
            block.append(f"[... {len(body) - COMMENT_LINES} more lines]")
        blocks.append(block)
    room = CONTEXT_LINES - len(lines) - 2
    chosen = []
    for block in reversed(blocks):                     # newest first, whole comments only
        if len(block) > room:
            break
        chosen.insert(0, block)
        room -= len(block)
    if chosen:
        lines += ["", f"## Comments (newest {len(chosen)} of {len(comments)})"]
        for block in chosen:
            lines += block
    elif comments:
        lines += ["", f"{len(comments)} comments not shown: gh issue view {n} --comments"]
    if len(lines) > CONTEXT_LINES:
        lines = lines[:CONTEXT_LINES - 1] + [f"[... cut at {CONTEXT_LINES} lines; harness-board show {n} has it all]"]
    return "\n".join(lines)


# --------------------------------------------------------------- output
def issue_line(item):
    return f"#{item['number']} {item['title']} ({item['type']}, {item['size'] or '-'}, {item['risk'] or '-'})"


# --------------------------------------------------------------- commands
def cmd_labels_ensure(repo, args):
    for name, color, meaning in LABELS:
        gh(repo, ["label", "create", name, "--color", color, "--description", meaning, "--force"])
    emit(args.json, {"labels": [name for name, _, _ in LABELS], "count": len(LABELS)},
         f"{len(LABELS)} labels created or updated.")


def initial_status(args):
    return "status:proposed" if args.proposed else "status:ready"


def cmd_epic_create(repo, args):
    path, stdin = body_file(args.body_file)
    labels = ["epic", initial_status(args)] + ([f"size:{args.size}"] if args.size else []) \
        + ([f"risk:{args.risk}"] if args.risk else [])
    out = gh(repo, ["issue", "create", "--title", args.title, "--body-file", path] + label_args(labels), stdin)
    number, url = created_issue(out)
    mirror_created(repo, url, proposed=args.proposed)
    emit(args.json, {"number": number, "url": url}, f"#{number} {url}")


def blocker_numbers(values):
    out = []
    for value in values or []:
        for part in value.split(","):
            part = part.strip().lstrip("#")
            if not part:
                continue
            if not part.isdigit() or int(part) <= 0:
                raise Problem(f"--blocked-by: not an issue number: {part!r}")
            if int(part) not in out:
                out.append(int(part))
    return out


def link_sub_issue(repo, parent, number):
    """Link `number` under `parent`, retrying once. (None, id) on success, (the error, id) on failure."""
    issue_id, error = None, None
    for attempt in range(2):
        if attempt:
            time.sleep(LINK_RETRY_DELAY)
        try:
            if issue_id is None:
                found = gh(repo, ["api", f"repos/{repo.slug()}/issues/{number}", "--jq", ".id"]).strip()
                if not found.isdigit():
                    raise Problem(f"gh api repos/{repo.slug()}/issues/{number} gave no numeric id: {found[:40]!r}")
                issue_id = found
            gh(repo, ["api", "-X", "POST", f"repos/{repo.slug()}/issues/{parent}/sub_issues",
                      "-F", f"sub_issue_id={issue_id}"])
            return None, issue_id
        except Problem as err:
            error = err
    return error, issue_id


def cmd_task_create(repo, args):
    path, stdin = body_file(args.body_file)
    blockers = blocker_numbers(args.blocked_by)
    if args.parent:
        repo.slug()                    # fails before anything is created when gh cannot see the repository
    labels = [args.type, initial_status(args)] + ([f"size:{args.size}"] if args.size else []) \
        + ([f"risk:{args.risk}"] if args.risk else []) + (["no-tests"] if args.no_tests else []) \
        + (["needs-local"] if args.needs_local else []) + (["priority:high"] if args.priority else [])
    out = gh(repo, ["issue", "create", "--title", args.title, "--body-file", path] + label_args(labels), stdin)
    number, url = created_issue(out)
    mirror_created(repo, url, args.priority, args.proposed)
    result = {"number": number, "url": url, "parent": args.parent, "linked": None, "blocked_by": []}

    def fail(message):
        emit(args.json, result, f"#{number} {url}")
        raise Problem(f"created #{number} ({url}) but {message}")

    if args.parent:
        error, issue_id = link_sub_issue(repo, args.parent, number)
        result["linked"] = error is None
        if error is not None:
            slug = repo.slug()
            skipped = "; blocked-by not added" if blockers else ""
            id_hint = issue_id or f"$(gh api repos/{slug}/issues/{number} --jq .id)"
            fail(f"could not link it under #{args.parent} after a retry: {error}{skipped}; link it with: "
                 f"gh api -X POST repos/{slug}/issues/{args.parent}/sub_issues -F sub_issue_id={id_hint}")
    for b in blockers:
        try:
            gh(repo, ["issue", "edit", str(number), "--add-blocked-by", str(b)])
        except Problem as err:
            fail(f"could not mark it blocked by #{b}: {err}")
        result["blocked_by"].append(b)
    emit(args.json, result, f"#{number} {url}")


def cmd_show(repo, args):
    record = fetch_record(repo, args.number)
    save_record(repo, record)
    if args.markdown:
        tier_from = "HARNESS_CODE_TIER" if routing_for(repo)["code_tier"] else None
        print(context_markdown(record, task_resolutions(repo, record.get("tasks") or []), tier_from))
    else:
        emit(True, record, "")


def cmd_ready(repo, args):
    items = gh_json(repo, ["issue", "list", "--state", "open", "--label", "status:ready", "--json",
                           "number,title,labels,blockedBy", "--limit", LIST_LIMIT])
    rows = []
    for item in items if isinstance(items, list) else []:
        if not isinstance(item, dict):
            continue
        names = label_names(item.get("labels"))
        if "epic" in names or "status:proposed" in names:
            continue
        if any(str(b.get("state", "")).upper() != "CLOSED" for b in as_list(item.get("blockedBy"))):
            continue
        kind = classify(repo, names)
        rows.append({"number": item.get("number"), "title": item.get("title") or "", "type": kind["type"],
                     "size": kind["size"], "risk": kind["risk"], "tier": kind["tier"], "flags": kind["flags"]})
    rows.sort(key=lambda r: ("priority:high" not in r["flags"], r["number"] or 0))
    if args.json:
        emit(args.json, rows, "")
    elif not rows:
        print("No ready tickets.")
    else:
        print(table([("#", "TITLE", "TYPE", "SIZE", "RISK", "TIER", "FLAGS")]
                    + [(str(r["number"]), r["title"], r["type"], r["size"] or "-", r["risk"] or "-", r["tier"],
                        ",".join(r["flags"])) for r in rows]))


def set_status(repo, number, status, comment=None):
    """Swap the status label (remove every other status:*, add the new one), mirror it to the Projects board when
    one is configured (proposed has no Status there), comment when asked."""
    project = project_setting() if status in MIRRORED else None
    data = gh_json(repo, ["issue", "view", str(number), "--json", "labels,url" if project else "labels"])
    names = label_names(data.get("labels") if isinstance(data, dict) else None)
    new = "status:" + status
    removed = [name for name in names if name.startswith("status:") and name != new]
    cmd = ["issue", "edit", str(number), "--add-label", new]
    for name in removed:
        cmd += ["--remove-label", name]
    gh(repo, cmd)
    if project:
        url = data.get("url") if isinstance(data, dict) else None
        if isinstance(url, str) and url.strip():
            mirror(repo, project, url.strip(), [("Status", STATUS_TITLES[status])])
        else:
            warn("harness-board",
                 f"gh issue view {number} gave no url; the Projects board {'/'.join(project)} is not updated")
    if comment:
        gh(repo, ["issue", "comment", str(number), "--body", marked(comment)])
    labels = [name for name in names if name not in removed] + ([new] if new not in names else [])
    refresh_cache(repo, number, labels=labels, status=status)
    return removed


def cmd_status(repo, args):
    removed = set_status(repo, args.number, args.status, args.comment)
    emit(args.json, {"number": args.number, "status": args.status, "removed": removed},
         f"#{args.number} status:{args.status}")


def cmd_promote(repo, args):
    """A proposed ticket to ready through set_status: an epic's open proposed sub-issues first, then the epic."""
    n = args.number
    data = gh_json(repo, ["issue", "view", str(n), "--json", "labels,state"])
    data = data if isinstance(data, dict) else {}
    names = label_names(data.get("labels"))
    if str(data.get("state", "")).upper() == "CLOSED":
        raise Problem(f"#{n} is closed; only an open status:proposed ticket can be promoted")
    if "status:proposed" not in names:
        status = next((s for s in STATUSES if "status:" + s in names), None)
        raise Problem(f"#{n} is {'status:' + status if status else 'without a status label'}, not status:proposed; "
                      "nothing promoted")
    tasks = []
    if "epic" in names:
        subs = gh_json(repo, ["api", f"repos/{repo.slug()}/issues/{n}/sub_issues?per_page=100"])
        tasks = sorted(int(s["number"]) for s in (subs if isinstance(subs, list) else [])
                       if isinstance(s, dict) and s.get("number") and str(s.get("state", "")).upper() != "CLOSED"
                       and "status:proposed" in label_names(s.get("labels")))
    done = []
    for number in tasks + [n]:
        try:
            set_status(repo, number, "ready")
        except Problem as err:
            so_far = f" (promoted so far: {', '.join(f'#{x}' for x in done)})" if done else ""
            raise Problem(f"#{number} was not promoted: {err}{so_far}; run promote {n} again") from None
        done.append(number)
    k = len(tasks)
    text = f"promoted #{n} and {k} task{'' if k == 1 else 's'}" if "epic" in names else f"promoted #{n}"
    emit(args.json, {"number": n, "tasks": tasks}, text)


def cmd_comment(repo, args):
    if args.body is not None:
        out = gh(repo, ["issue", "comment", str(args.number), "--body", marked(args.body)])
    else:
        path, stdin = body_file(args.body_file)
        text = stdin if path == "-" else read_text(path, "body file")
        out = gh(repo, ["issue", "comment", str(args.number), "--body-file", "-"], marked(text))
    url = first_line(out.strip().splitlines()[-1] if out.strip() else "")
    emit(args.json, {"number": args.number, "url": url}, url or f"commented on #{args.number}")


def needs_input_body(number, question, evidence):
    parts = [NEEDS_INPUT, question.strip()]
    lines = (evidence or "").strip("\n").splitlines()
    if any(line.strip() for line in lines):
        if len(lines) > EVIDENCE_LINES:
            keep = EVIDENCE_LINES - 1
            lines = [f"[... {len(lines) - keep} earlier lines omitted]"] + lines[-keep:]
        longest = max((len(run) for run in re.findall(r"`{3,}", "\n".join(lines))), default=0)
        fence = "`" * max(3, longest + 1)
        parts.append("\n".join([fence] + lines + [fence]))
    parts.append(f"Reply in a comment; /harness:work {number} picks it up.")
    return marked("\n\n".join(parts))


def cmd_needs_input(repo, args):
    if not args.question.strip():
        raise Problem("--question is empty")
    evidence = read_text(args.evidence_file, "evidence file") if args.evidence_file else None
    set_status(repo, args.number, "needs-input")
    out = gh(repo, ["issue", "comment", str(args.number), "--body",
                    needs_input_body(args.number, args.question, evidence)])
    url = first_line(out.strip().splitlines()[-1] if out.strip() else "")
    notified = notify(f"{repo.name} #{args.number} needs input", f"harness-{repo.key}-{args.number}")
    emit(args.json, {"number": args.number, "url": url, "notified": notified}, url or f"#{args.number} needs input")


def cmd_answers(repo, args):
    """The owner's comments after `since`, without the harness's own (posted under the same login). `since`:
    --since, else the newest needs-input question, else the cache's fetched_at, else no lower bound. A question
    is the owner's own or the deploy guard's (github-actions, marker required); the bot's are never answers."""
    since = None
    if args.since is not None:
        since = parse_iso(args.since)
        if since is None:
            raise Problem(f"--since: not an ISO-8601 time: {args.since!r}")
    login = gh(repo, ["api", "user", "--jq", ".login"]).strip()
    if not login:
        raise Problem("gh api user printed no login")
    data = gh_json(repo, ["issue", "view", str(args.number), "--json", "comments"])
    mine, asked = [], []
    for c in as_list(data.get("comments") if isinstance(data, dict) else None):
        author = (c.get("author") or {}).get("login") if isinstance(c.get("author"), dict) else None
        body, when = c.get("body") or "", parse_iso(c.get("createdAt"))
        question = when is not None and body.lstrip().startswith(NEEDS_INPUT)
        if author and author.casefold() == login.casefold():
            mine.append((author, c, body, when))
            if question:
                asked.append(when)
        elif author and author.casefold() in BOT_LOGINS and question and MARKER in body:
            asked.append(when)
    if args.since is None:
        since = max(asked) if asked else parse_iso((read_cache(repo, args.number) or {}).get("fetched_at"))
    out = []
    for author, c, body, when in mine:
        if by_harness(body) or (since is not None and (when is None or when <= since)):
            continue
        out.append({"author": author, "created_at": c.get("createdAt"), "body": body, "url": c.get("url")})
    emit(True, out, "")


def cmd_close(repo, args):
    gh(repo, ["issue", "close", str(args.number)] + (["--comment", marked(args.comment)] if args.comment else []))
    refresh_cache(repo, args.number, status="closed")
    emit(args.json, {"number": args.number, "closed": True}, f"closed #{args.number}")


def cmd_epic_check(repo, args):
    data = gh_json(repo, ["issue", "view", str(args.number), "--json", "state,subIssuesSummary"])
    data = data if isinstance(data, dict) else {}
    summary = data.get("subIssuesSummary") if isinstance(data.get("subIssuesSummary"), dict) else {}
    total, completed = int(summary.get("total") or 0), int(summary.get("completed") or 0)
    result = {"number": args.number, "total": total, "completed": completed, "closed": False}
    if str(data.get("state", "")).upper() == "CLOSED":
        result["closed"] = True
        emit(args.json, result, f"#{args.number} is already closed")
    elif total > 0 and completed == total:
        gh(repo, ["issue", "close", str(args.number), "--comment", marked(EPIC_DONE)])
        refresh_cache(repo, args.number, status="closed")
        result["closed"] = True
        emit(args.json, result, f"closed epic #{args.number}: all {total} tasks landed")
    else:
        emit(args.json, result, f"#{args.number}: {completed} of {total} tasks closed; left open")


def cmd_board(repo, args):
    items = gh_json(repo, ["issue", "list", "--state", "open", "--json", "number,title,labels,subIssuesSummary",
                           "--limit", LIST_LIMIT])
    groups = {"epics": []}
    groups.update({s: [] for s in STATUSES})
    groups["no-status"] = []
    for item in sorted((i for i in (items if isinstance(items, list) else []) if isinstance(i, dict)),
                       key=lambda i: i.get("number") or 0):
        kind = label_kind(label_names(item.get("labels")))
        entry = {"number": item.get("number"), "title": item.get("title") or "", "type": kind["type"],
                 "size": kind["size"], "risk": kind["risk"]}
        if kind["type"] == "epic":
            summary = item.get("subIssuesSummary") if isinstance(item.get("subIssuesSummary"), dict) else {}
            entry.update(total=int(summary.get("total") or 0), completed=int(summary.get("completed") or 0))
            groups["epics"].append(entry)
        else:
            groups[kind["status"] or "no-status"].append(entry)
    if args.json:
        emit(args.json, groups, "")
        return
    lines = [f"# Board: {repo.name}"]
    if groups["epics"]:
        lines += ["", f"## Epics ({len(groups['epics'])})"]
        lines += [f"- #{e['number']} {e['title']} ({e['completed']} of {e['total']} tasks closed)"
                  for e in groups["epics"]]
    for status in STATUSES:
        if status == "proposed" and not groups[status]:
            continue
        lines += ["", f"## {STATUS_TITLES[status]} ({len(groups[status])})"]
        lines += ["- " + issue_line(e) for e in groups[status]]
    if groups["no-status"]:
        lines += ["", f"## No status ({len(groups['no-status'])})"]
        lines += ["- " + issue_line(e) for e in groups["no-status"]]
    print("\n".join(lines))


def cmd_tier(repo, args):
    routing = routing_for(repo)

    def route(names):
        # harness_lib.routing: the labels decide unless HARNESS_CODE_TIER (code) or HARNESS_REVIEW_TIER (review) is set
        kind = label_kind(names)
        if args.stage == "review":
            return review_route(kind["risk"], routing)
        return code_route(kind["type"], kind["size"], kind["risk"], routing)

    cached = read_cache(repo, args.number)
    if cached and isinstance(cached.get("labels"), list):
        found, source = route(label_names(cached["labels"])), "cache"
    elif cached and cached.get("tier") in TIERS and not args.stage:
        # no labels to route: the cached tier stands in for the labels' tier, and the setting still decides
        found, source = cached_code_route(cached["tier"], routing), "cache"
    else:
        data = gh_json(repo, ["issue", "view", str(args.number), "--json", "labels"])
        found, source = route(label_names(data.get("labels") if isinstance(data, dict) else None)), "github"
    emit(args.json, {"number": args.number, "tier": found["tier"], "source": source, "stage": args.stage or "code",
                     "from": found["from"], "labels_tier": found["labels_tier"], "effort": found["effort"]},
         found["tier"])


# --------------------------------------------------------------- project check, project sync
def required_project():
    """(owner, number) from HARNESS_PROJECT, or Problem naming the setting: these commands need a board."""
    value = project_value()
    if not value:
        raise Problem(f"{PROJECT_SETTING} is not set; set it to OWNER/NUMBER of the Projects board (in the "
                      "environment or under env in ~/.claude/settings.json)")
    if not PROJECT_VALUE.fullmatch(value):
        raise Problem(f"{PROJECT_SETTING}={value!r} is not OWNER/NUMBER")
    owner, number = value.split("/")
    return owner, number


def cmd_project_check(args):
    owner, number = required_project()
    data = gh_json(None, ["project", "field-list", number, "--owner", owner, "--format", "json",
                          "--limit", FIELD_LIMIT])
    fields = {f.get("name"): f for f in as_list(data.get("fields") if isinstance(data, dict) else None)}
    missing = []
    for name, options in PROJECT_FIELDS:
        field = fields.get(name)
        if field is None:
            missing.append(f"missing field: {name} (a single select with the options {', '.join(options)})")
            continue
        present = {o.get("name") for o in as_list(field.get("options"))}
        missing += [f"missing option: {name} {option}" for option in options if option not in present]
    if missing:
        print("\n".join(missing))
        print(f"harness-board: the Projects board {owner}/{number} lacks {len(missing)} of the fields and options "
              "the harness writes", file=sys.stderr)
        return 1
    print(f"The Projects board {owner}/{number} has every Status and Priority option the harness writes.")
    return 0


def load_projects():
    """The registered project paths, in registry order (the registry harness-standup and harness-digest read)."""
    return [p.path for p in load_registry(path=harness_home("projects.json"))]


def label_status(url, names):
    """The Status option an issue's labels give, or None: no status label means no Status write, and an unknown
    or doubled one is one warning naming the issue and no Status write; status:proposed has no Status: None."""
    found = [name for name in names if name.startswith("status:")]
    if not found or found == ["status:proposed"]:
        return None
    if len(found) == 1 and found[0][len("status:"):] in MIRRORED:
        return STATUS_TITLES[found[0][len("status:"):]]
    what = f"the status labels {', '.join(found)}" if len(found) > 1 else f"{found[0]}, not a harness status,"
    warn("harness-board", f"{url} has {what} so its Status on the board is left as it is")
    return None


def open_issues(repo):
    issues = gh_json(repo, ["issue", "list", "--state", "open", "--json", "number,url,labels,state",
                            "--limit", ISSUE_LIMIT])
    if not isinstance(issues, list):
        raise Problem("gh issue list printed no list")
    return [i for i in issues if isinstance(i, dict) and str(i.get("state") or "OPEN").upper() == "OPEN"
            and isinstance(i.get("url"), str) and i["url"]]


def cmd_project_sync(args):
    """Add the open issues missing from the board and correct Status and Priority drift, by the labels; an unset
    Priority is Normal, so an added issue gets a Priority write only for High. Exit 1
    when a write fails, a repository is skipped or a read was cut at its limit; the rest still runs."""
    owner, number = required_project()
    if args.all_projects and getattr(args, "repo", None):
        raise Problem("--repo and --all-projects cannot be combined")
    failed = False
    if args.all_projects:
        repos, seen = [], set()
        for path in load_projects():
            try:
                repo = Repo(path)
            except Problem as err:
                warn("harness-board", f"the registered project {path} is skipped: {err}")
                failed = True
                continue
            if repo.main not in seen:
                seen.add(repo.main)
                repos.append(repo)
        if not repos:
            print("No registered projects to sync.")
            return 1 if failed else 0
        board_repo = None
    else:
        repos = [open_repo(getattr(args, "repo", None))]
        board_repo = repos[0]
    data = gh_json(board_repo, ["project", "item-list", number, "--owner", owner, "--format", "json",
                                "--limit", ITEM_LIMIT])
    if not isinstance(data, dict) or not isinstance(data.get("items"), list):
        raise Problem(f"gh project item-list {number} printed no items")
    items = as_list(data["items"])
    on_board = {}
    for item in items:
        url = item.get("content", {}).get("url") if isinstance(item.get("content"), dict) else None
        if isinstance(url, str) and url:
            on_board[url] = item
    total = data.get("totalCount")
    total = total if isinstance(total, int) and not isinstance(total, bool) else None
    truncated = total > len(items) if total is not None else len(items) >= int(ITEM_LIMIT)
    if truncated:
        warn("harness-board",
             f"the Projects board {owner}/{number} holds {total if total is not None else 'at least ' + ITEM_LIMIT} "
             f"items and item-list read {len(items)}, so no issue is added; archive Done items, then sync again")
        failed = True
    changes, errors, synced = 0, 0, 0
    for repo in repos:
        try:
            issues = open_issues(repo)
        except Problem as err:
            if not args.all_projects:
                raise
            warn("harness-board", f"{repo.main} is skipped: {err}")
            failed = True
            continue
        if len(issues) >= int(ISSUE_LIMIT):
            warn("harness-board",
                 f"{repo.main}: gh issue list stopped at its limit of {ISSUE_LIMIT}; later open issues are not synced")
            failed = True
        synced += len(issues)
        for issue in issues:
            url = issue["url"]
            names = label_names(issue.get("labels"))
            status = label_status(url, names)
            priority = "High" if "priority:high" in names else "Normal"
            item = on_board.get(url)
            if item is None and truncated:
                continue
            target = [number, "--owner", owner, "--url", url]
            steps = [] if item is not None else [(["project", "item-add"] + target, f"{url}: add to the board")]
            for field, value in (("Status", status), ("Priority", priority)):
                old = item.get(field.lower()) if item is not None else None
                # an unset Priority is Normal, so only High against Normal is drift (and an add sets only High)
                current = (old or "Normal") if field == "Priority" else old
                if value and current != value:
                    steps.append((["project", "item-edit"] + target + ["--field", field, "--value", value],
                                  f"{url}: {field} {old or '(unset)'} -> {value}"))
            for call, line in steps:
                changes += 1
                if not args.dry_run:
                    try:
                        gh(repo, call)
                    except Problem as err:
                        errors += 1
                        added = "; its Status and Priority are not set" if call[1] == "item-add" else ""
                        print(f"harness-board: {url}: {one_line(err)}{added}", file=sys.stderr)
                        if call[1] == "item-add":
                            break
                        continue
                print(line)
    where = (f"the Projects board {owner}/{number} ({synced} open issues in {len(repos)} "
             f"{'repository' if len(repos) == 1 else 'repositories'})")
    if args.dry_run:
        print(f"--dry-run: {changes} changes to {where}, none made.")
    elif errors:
        print(f"harness-board: {errors} of the {changes} changes to {where} failed", file=sys.stderr)
    else:
        print(f"{changes} changes made to {where}." if changes else f"No changes: {where} agrees with the labels.")
    return 1 if failed or errors else 0


# --------------------------------------------------------------- arguments
def parser():
    repo_help = "the project (default: CLAUDE_PROJECT_DIR, else the cwd's repository)"
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--repo", metavar="PATH", default=argparse.SUPPRESS, help=repo_help)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="print JSON")
    ap = Parser(prog="harness-board", description="The board: GitHub Issues as tickets (epics, tasks, status labels).")
    ap.add_argument("--repo", metavar="PATH", help=repo_help)
    ap.add_argument("--json", action="store_true", help="print JSON")
    sub = ap.add_subparsers(dest="cmd", metavar="{labels,epic,task,show,ready,status,promote,comment,needs-input,"
                                               "answers,close,epic-check,board,tier,project}")
    sub.required = True

    labels = sub.add_parser("labels", help="the board's label set")
    labels_sub = labels.add_subparsers(dest="action", metavar="{ensure}")
    labels_sub.required = True
    labels_sub.add_parser("ensure", parents=[common], help="create or update every board label")

    epic = sub.add_parser("epic", help="epics")
    epic_sub = epic.add_subparsers(dest="action", metavar="{create}")
    epic_sub.required = True
    ec = epic_sub.add_parser("create", parents=[common],
                             help="create an epic (labels epic, status:ready or with --proposed status:proposed)")
    ec.add_argument("--title", required=True)
    ec.add_argument("--body-file", required=True, metavar="F", help="the body (- for stdin)")
    ec.add_argument("--size", choices=("S", "M", "L"))
    ec.add_argument("--risk", choices=("low", "high"))
    ec.add_argument("--proposed", action="store_true", help="label status:proposed in place of status:ready")

    task = sub.add_parser("task", help="tasks")
    task_sub = task.add_subparsers(dest="action", metavar="{create}")
    task_sub.required = True
    tc = task_sub.add_parser("create", parents=[common], help="create a task, link it under an epic, add blockers")
    tc.add_argument("--title", required=True)
    tc.add_argument("--body-file", required=True, metavar="F", help="the body (- for stdin)")
    tc.add_argument("--parent", type=issue_number, metavar="N", help="the epic to link it under")
    tc.add_argument("--type", choices=TASK_TYPES, default="task")
    tc.add_argument("--size", choices=("S", "M", "L"))
    tc.add_argument("--risk", choices=("low", "high"))
    tc.add_argument("--blocked-by", action="append", metavar="N[,N]", help="issues that must close first")
    tc.add_argument("--no-tests", action="store_true", help="docs or config only; exempt from tests-first")
    tc.add_argument("--needs-local", action="store_true", help="needs this Mac's files or credentials")
    tc.add_argument("--priority", action="store_true", help="label priority:high (and Priority High on the board)")
    tc.add_argument("--proposed", action="store_true", help="label status:proposed in place of status:ready")

    show = sub.add_parser("show", parents=[common], help="fetch a ticket, write its cache, print it")
    show.add_argument("number", type=issue_number, metavar="N")
    show.add_argument("--markdown", action="store_true", help=f"the ticket context (at most {CONTEXT_LINES} lines)")

    sub.add_parser("ready", parents=[common], help="open, unblocked status:ready tickets in dispatch order")

    status = sub.add_parser("status", parents=[common], help="set a ticket's status label")
    status.add_argument("number", type=issue_number, metavar="N")
    status.add_argument("status", choices=STATUSES)
    status.add_argument("--comment", metavar="TEXT")

    promote = sub.add_parser("promote", parents=[common],
                             help="a proposed epic and its open proposed tasks, or a proposed task, to ready")
    promote.add_argument("number", type=issue_number, metavar="N")

    comment = sub.add_parser("comment", parents=[common], help="comment on a ticket")
    comment.add_argument("number", type=issue_number, metavar="N")
    body = comment.add_mutually_exclusive_group(required=True)
    body.add_argument("--body", metavar="TEXT")
    body.add_argument("--body-file", metavar="F", help="- for stdin")

    ni = sub.add_parser("needs-input", parents=[common], help="ask the user on the ticket and notify")
    ni.add_argument("number", type=issue_number, metavar="N")
    ni.add_argument("--question", required=True, metavar="TEXT")
    ni.add_argument("--evidence-file", metavar="F", help=f"shown fenced, at most {EVIDENCE_LINES} lines (the tail)")

    answers = sub.add_parser("answers", parents=[common],
                             help="your replies on a ticket since its last needs-input question (JSON)")
    answers.add_argument("number", type=issue_number, metavar="N")
    answers.add_argument("--since", metavar="ISO", help="default: the newest needs-input question, else the "
                                                        "cache's fetched_at, else every reply")

    close = sub.add_parser("close", parents=[common], help="close a ticket")
    close.add_argument("number", type=issue_number, metavar="N")
    close.add_argument("--comment", metavar="TEXT")

    check = sub.add_parser("epic-check", parents=[common], help="close an epic whose tasks are all closed")
    check.add_argument("number", type=issue_number, metavar="N")

    sub.add_parser("board", parents=[common], help="open issues by status")

    tier = sub.add_parser("tier", parents=[common],
                          help="sonnet, opus or fable: HARNESS_CODE_TIER when set, else from the ticket's labels "
                               "(sonnet or opus; --json adds the effort, xhigh for size:L or risk:high)")
    tier.add_argument("number", type=issue_number, metavar="N")
    tier.add_argument("--stage", choices=("review",),
                      help="the review stage: HARNESS_REVIEW_TIER when set, else opus (at effort xhigh for a "
                           "risk:high ticket)")

    project = sub.add_parser("project", help=f"the Projects board named by {PROJECT_SETTING}")
    project_sub = project.add_subparsers(dest="action", metavar="{check,sync}")
    project_sub.required = True
    project_sub.add_parser("check", help="name each Status or Priority field or option the board lacks (exit 1)")
    ps = project_sub.add_parser("sync", help="add missing open issues, correct Status and Priority from the labels")
    where = ps.add_mutually_exclusive_group()
    where.add_argument("--repo", metavar="PATH", default=argparse.SUPPRESS, help=repo_help)
    where.add_argument("--all-projects", action="store_true",
                       help="every project in ~/.claude/harness/projects.json")
    ps.add_argument("--dry-run", action="store_true", help="print the changes, make none")
    return ap


COMMANDS = {"labels ensure": cmd_labels_ensure, "epic create": cmd_epic_create, "task create": cmd_task_create,
            "show": cmd_show, "ready": cmd_ready, "status": cmd_status, "promote": cmd_promote,
            "comment": cmd_comment,
            "needs-input": cmd_needs_input, "answers": cmd_answers, "close": cmd_close,
            "epic-check": cmd_epic_check, "board": cmd_board, "tier": cmd_tier}
PROJECT_COMMANDS = {"project check": cmd_project_check, "project sync": cmd_project_sync}   # open their own repos


def main():
    args = parser().parse_args()
    name = args.cmd + (f" {args.action}" if getattr(args, "action", None) else "")
    try:
        if name in PROJECT_COMMANDS:
            sys.exit(PROJECT_COMMANDS[name](args))
        COMMANDS[name](open_repo(getattr(args, "repo", None)), args)
    except Problem as err:
        exit_problem("harness-board", err)


if __name__ == "__main__":
    run_main("harness-board", main)
