#!/usr/bin/env python3
"""
The cross-project standup. For each project in ~/.claude/harness/projects.json (registry order):
git state, last Claude Code session, next steps (as the session brief reads them), latest spec,
hours this month on a billable project, and the sessions running in it; for a project whose `origin`
remote is on github.com, when gh is found (HARNESS_GH, else gh on PATH): the board counts, your pull
requests awaiting review, the tickets that need your input and the stale ticket worktrees. Then the
fleet of every running Claude Code session, waiting ones first; the exhausted budgets; and the headless
and background runs alive or ended in the last 24 hours. Markdown, or --json for the structure behind it.

Usage:
    harness-standup                  # every registered project
    harness-standup HKTrack          # one project, by name or path
    harness-standup --json
"""
from __future__ import annotations

import argparse
import concurrent.futures
import csv
import datetime as dt
import glob
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import unicodedata

BUDGET = 4            # seconds for the projects' git calls (they run side by side)
FLEET_TIMEOUT = 4     # seconds for `claude agents --json`, started before the projects and read after
NEXT_LINES = 5        # next steps per project
WIDTH = 160           # a longer next-step line is cut
GH_BUDGET = 6         # seconds for one project's gh calls (side by side, beside the git calls) and worktree reads
STALE_DAYS = 7        # a ticket worktree with no commit for this long and no open PR is stale
RUNS_WINDOW = 86400   # runs that ended this many seconds ago or less are listed
NEEDS_INPUT = "**Needs your input**"
HEADING = re.compile(r"^\s{0,3}#{1,6}\s")
NEXT_STEPS = re.compile(r"^(\s*)(#{1,6}\s+|[-*+]\s+)?(\*\*|__)?\s*next steps?\b\s*:?\s*(?:\*\*|__)?\s*:?\s*(.*)$", re.I)
BOLD_LABEL = re.compile(r"^(\s*)([-*+]\s+)?(\*\*|__)\S")


class Problem(Exception):
    """A bad invocation or an unreadable registry (one line, exit 1), or a failed gh call (one board line)."""


class Parser(argparse.ArgumentParser):
    """argparse that reports a bad invocation in one line and exits 1."""

    def error(self, message):
        sys.exit(f"{self.prog}: error: {message}")


def home(*parts):
    return os.path.join(os.path.expanduser("~"), *parts)


def encode(path):
    """Claude Code's folder name for a project: its path with every non-alphanumeric as '-'."""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def same_path(a, b):
    return os.path.realpath(os.path.abspath(os.path.expanduser(a))) == os.path.realpath(os.path.abspath(os.path.expanduser(b)))


def under(cwd, path):
    """Whether the directory `cwd` is `path` or inside it."""
    if not isinstance(cwd, str) or not cwd:
        return False
    cwd, path = os.path.realpath(cwd), os.path.realpath(path)
    return cwd == path or cwd.startswith(path.rstrip(os.sep) + os.sep)


def age(then, now):
    """'just now', '5m ago', '3h ago', '2d ago', '4mo ago' or '2y ago'."""
    s = max(0, now - then)
    if s < 60:
        return "just now"
    if s < 3600:
        return f"{int(s // 60)}m ago"
    if s < 86400:
        return f"{int(s // 3600)}h ago"
    if s < 86400 * 60:
        return f"{int(s // 86400)}d ago"
    if s < 86400 * 730:
        return f"{int(s // (86400 * 30))}mo ago"
    return f"{int(s // (86400 * 365))}y ago"


def stamp(then, now):
    return {"time": dt.datetime.fromtimestamp(then).astimezone().isoformat(timespec="seconds"), "age": age(then, now)}


def clip(line):
    line = " ".join(line.split())
    return line if len(line) <= WIDTH else line[:WIDTH - 1].rstrip() + "…"


# --------------------------------------------------------------- registry
def load_projects():
    """The registered projects in registry order; Problem when the registry cannot be read."""
    path = home(".claude", "harness", "projects.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return []
    except ValueError as err:
        raise Problem(f"{path} is not valid JSON ({err}); fix it or remove it")
    except OSError as err:
        raise Problem(f"cannot read {path}: {err.strerror or err}")
    if not isinstance(data, dict) or not isinstance(data.get("projects"), list):
        raise Problem(f'{path}: expected {{"version": 1, "projects": [...]}}')
    if data.get("version", 1) != 1:
        raise Problem(f"{path} is version {data.get('version')!r}; this tool reads version 1")
    out = []
    for p in data["projects"]:
        if isinstance(p, dict) and isinstance(p.get("path"), str) and p["path"].strip():
            out.append({"name": str(p.get("name") or os.path.basename(p["path"].rstrip("/")) or p["path"]),
                        "path": p["path"], "billable": bool(p.get("billable")), "client": str(p.get("client") or "")})
    return out


def pick(projects, key):
    """The project named `key` (in any case) or registered at the path `key`."""
    for match in (lambda p: p["name"] == key, lambda p: p["name"].casefold() == key.casefold(),
                  lambda p: same_path(p["path"], key)):
        hits = [p for p in projects if match(p)]
        if len(hits) == 1:
            return hits[0]
        if hits:
            raise Problem(f"{key!r} matches {len(hits)} projects; give its path instead")
    raise Problem(f"no registered project named or at {key!r} (harness-projects list shows them)")


# --------------------------------------------------------------- one project
def git(path, args, deadline):
    """A read-only git command in `path` (no optional locks, so the index is never rewritten)."""
    timeout = max(0.2, deadline - time.monotonic())
    try:
        return subprocess.run(["git", "--no-optional-locks", "-C", path] + args, capture_output=True,
                              encoding="utf-8", errors="replace", timeout=timeout, stdin=subprocess.DEVNULL,
                              env=dict(os.environ, LC_ALL="C"))
    except subprocess.TimeoutExpired:
        raise TimeoutError(f"git {args[0]} timed out") from None


def git_state(path, deadline, now):
    """{"repo": false} outside git; else branch, uncommitted, upstream/ahead/behind and the last commit
    ({"repo": true, "error": "..."} when git fails)."""
    try:
        status = git(path, ["status", "--porcelain=v2", "--branch"], deadline)
        if status.returncode != 0:
            if "not a git repository" in status.stderr:
                return {"repo": False}
            return {"repo": True, "error": (status.stderr.strip().splitlines() or [f"git status exited {status.returncode}"])[-1]}
        state = {"repo": True, "branch": None, "detached": False, "uncommitted": 0, "upstream": None,
                 "ahead": None, "behind": None, "last_commit": None}
        oid = None
        for line in status.stdout.splitlines():
            if line.startswith("# branch.oid "):
                oid = line.split(" ", 2)[2]
            elif line.startswith("# branch.head "):
                head = line.split(" ", 2)[2]
                state["detached"] = head == "(detached)"
                state["branch"] = None if state["detached"] else head
            elif line.startswith("# branch.upstream "):
                state["upstream"] = line.split(" ", 2)[2]
            elif line.startswith("# branch.ab "):
                m = re.match(r"# branch\.ab \+(\d+) -(\d+)", line)
                if m:
                    state["ahead"], state["behind"] = int(m.group(1)), int(m.group(2))
            elif line and not line.startswith("#"):
                state["uncommitted"] += 1
        if state["detached"]:
            state["branch"] = f"detached at {oid[:7]}" if oid and oid != "(initial)" else "detached"
        log = git(path, ["log", "-1", "--format=%ct%x09%s"], deadline)
        if log.returncode == 0 and "\t" in log.stdout:
            when, subject = log.stdout.strip("\n").split("\t", 1)
            state["last_commit"] = dict(stamp(int(when), now), subject=subject.strip())
        return state
    except (TimeoutError, OSError) as err:
        return {"repo": True, "error": str(err)}


def last_session(path):
    """The newest mtime among the project's Claude Code transcripts, or None."""
    stamps = []
    for name in glob.glob(os.path.join(glob.escape(home(".claude", "projects", encode(path))), "*.jsonl")):
        try:
            stamps.append(os.path.getmtime(name))
        except OSError:
            pass
    return max(stamps) if stamps else None


def read(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def unbullet(line):
    return re.sub(r"^[-*+]\s+", "", line.strip())


def handoff_next(text):
    """docs/agent/handoff.md: its Next steps section (first 12 lines), else its first 20 lines."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = NEXT_STEPS.match(line)
        if not m:
            continue
        kind_heading, indent = bool(m.group(2) and m.group(2).startswith("#")), len(m.group(1))
        out = [m.group(4)] if m.group(4).strip() and not kind_heading else []   # "**Next steps**: do X"
        for nxt in lines[i + 1:]:
            if HEADING.match(nxt):
                break
            label = BOLD_LABEL.match(nxt)
            if not kind_heading and label and len(label.group(1)) <= indent and bool(label.group(2)) == bool(m.group(2)):
                break                      # the next **Label** section at the same level
            if nxt.strip():
                out.append(nxt)
        return [unbullet(x) for x in out][:12]
    return [x.strip() for x in lines if x.strip()][:20]


def progress_next(text):
    """docs/PROGRESS.md: the lines of its last `## ` block that start with Next (at most 6)."""
    lines = text.splitlines()
    starts = [i for i, line in enumerate(lines) if line.startswith("## ")]
    if not starts:
        return []
    return [line.strip() for line in lines[starts[-1] + 1:] if line.lstrip().startswith("Next")][:6]


def pending_features(path):
    """docs/plans/feature_list.json: its first three items with passes false, when it is a list with
    passes fields."""
    try:
        data = json.loads(read(path))
    except (OSError, ValueError):
        return []
    if not isinstance(data, list) or not any(isinstance(x, dict) and "passes" in x for x in data):
        return []
    out = []
    for x in data:
        if isinstance(x, dict) and x.get("passes") is False:
            text = x.get("description") or x.get("name") or x.get("title") or json.dumps(x, ensure_ascii=False)
            out.append(f"pending {x['id']}: {text}" if x.get("id") else f"pending: {text}")
            if len(out) == 3:
                break
    return out


def next_steps(path):
    """At most NEXT_LINES lines, from the session brief's sources in its order: the handoff's Next steps,
    else PROGRESS.md's Next lines; then the feature list's pending items."""
    handoff, progress = os.path.join(path, "docs", "agent", "handoff.md"), os.path.join(path, "docs", "PROGRESS.md")
    if os.path.isfile(handoff):
        lines = handoff_next(read(handoff))
    elif os.path.isfile(progress):
        lines = progress_next(read(progress))
    else:
        lines = []
    lines += pending_features(os.path.join(path, "docs", "plans", "feature_list.json"))
    return [clip(line) for line in lines[:NEXT_LINES]]


def latest_spec(path):
    """The most recently modified file in docs/agent/specs/, relative to the project, or None."""
    folder = os.path.join(path, "docs", "agent", "specs")
    if not os.path.isdir(folder):
        return None
    with os.scandir(folder) as found:
        files = [(e.stat().st_mtime, e.name) for e in found if e.is_file() and not e.name.startswith(".")]
    return os.path.join("docs", "agent", "specs", max(files)[1]) if files else None


def hours_this_month(path, today):
    """The sum of this month's rows of worklog/worklog.csv, or None without one."""
    log = os.path.join(path, "worklog", "worklog.csv")
    if not os.path.isfile(log):
        return None
    month = today.strftime("%Y-%m-")
    with open(log, encoding="utf-8", newline="") as fh:
        return round(sum(float(r.get("hours") or 0) for r in csv.DictReader(fh)
                         if (r.get("date") or "").startswith(month)), 2)


def report(project, deadline, now):
    """Everything the standup says about one project; one error line when it cannot be read."""
    out = dict(project, error=None, git=None, last_session=None, next=[], latest_spec=None,
               hours_this_month=None, sessions=None)
    try:
        path = project["path"]
        if not os.path.isdir(path):
            out["error"] = "path not found"
            return out
        out["git"] = git_state(path, deadline, now)
        newest = last_session(path)
        out["last_session"] = stamp(newest, now) if newest else None
        out["next"] = next_steps(path)
        out["latest_spec"] = latest_spec(path)
        if project["billable"]:
            out["hours_this_month"] = hours_this_month(path, dt.date.fromtimestamp(now))
    except Exception as err:      # one project never stops the others
        out["error"] = f"could not read it: {type(err).__name__}: {' '.join(str(err).split())}"
    return out


# --------------------------------------------------------------- fleet
def claude_binary():
    found = shutil.which("claude")
    if found:
        return found
    local = home(".local", "bin", "claude")
    return local if os.path.isfile(local) and os.access(local, os.X_OK) else None


def read_fleet(timeout=FLEET_TIMEOUT):
    """(sessions, None) from `claude agents --json`, or (None, why it could not be read)."""
    binary = claude_binary()
    if not binary:
        return None, "`claude` is not on PATH or in ~/.local/bin"
    try:
        p = subprocess.run([binary, "agents", "--json"], capture_output=True, encoding="utf-8", errors="replace",
                           timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, f"`claude agents --json` timed out after {timeout} s"
    except OSError as err:
        return None, f"`claude agents --json` could not start ({err.strerror or err})"
    if p.returncode != 0:
        tail = (p.stderr.strip().splitlines() or [""])[-1]
        return None, f"`claude agents --json` exited {p.returncode}" + (f": {tail}" if tail else "")
    try:
        data = json.loads(p.stdout)
    except ValueError:
        return None, "`claude agents --json` did not print JSON"
    if not isinstance(data, list):
        return None, "`claude agents --json` did not print a JSON array"
    return [e for e in data if isinstance(e, dict)], None


def read_fleet_into(box):
    """read_fleet() for the reader thread: an unexpected error becomes the reason, never a traceback."""
    try:
        box["fleet"] = read_fleet()
    except Exception as err:
        box["fleet"] = (None, f"`claude agents --json` failed: {type(err).__name__}: {' '.join(str(err).split())}")


def session_text(e):
    """'<name> <status> (<waitingFor>)'; fields may be absent."""
    sid = e.get("sessionId")
    name = e.get("name") or (str(sid)[:8] if sid else None) or (f"pid {e['pid']}" if e.get("pid") else "session")
    return f"{name} {e.get('status') or 'unknown'}" + (f" ({e['waitingFor']})" if e.get("waitingFor") else "")


def fleet_text(e):
    cwd = e.get("cwd")
    where = os.path.basename(cwd.rstrip(os.sep)) or cwd if isinstance(cwd, str) and cwd else "unknown cwd"
    return f"{session_text(e)} in {where}" + (" [background]" if e.get("kind") == "background" else "")


# --------------------------------------------------------------- board (gh)
def first_line(text):
    return next((line.strip() for line in (text or "").splitlines() if line.strip()), "")


def parse_iso(text):
    """Seconds since the epoch for an ISO-8601 time (Z allowed; naive means local), or None."""
    if not isinstance(text, str) or not text.strip():
        return None
    try:
        when = dt.datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return (when if when.tzinfo else when.astimezone()).timestamp()


def gh_binary():
    """The gh to run (HARNESS_GH, else gh on PATH), or None when it cannot be found."""
    gh = os.environ.get("HARNESS_GH", "gh")
    if os.sep in gh:
        return gh if os.path.isfile(gh) and os.access(gh, os.X_OK) else None
    return shutil.which(gh)


def repo_slug(url):
    """OWNER/REPO (HOST/OWNER/REPO off github.com) for gh -R, from an origin URL; None for a local path."""
    url = url.strip()
    m = re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://(?:[^@/]*@)?([^/:]+)(?::\d*)?/(.+)$", url)
    if not m or url.lower().startswith("file:"):
        m = re.match(r"^(?:[^@/:]+@)?([^/:]+):(?!/)(.+)$", url)         # scp-like: git@host:owner/repo
    if not m:
        return None
    host, parts = m.group(1), [p for p in m.group(2).split("/") if p]
    if len(parts) != 2:
        return None
    owner, name = parts[0], parts[1][:-4] if parts[1].endswith(".git") else parts[1]
    if not owner or not name:
        return None
    return f"{owner}/{name}" if host.lower() in ("github.com", "www.github.com") else f"{host}/{owner}/{name}"


def describe(args):
    """`gh pr list`, `gh issue list --label status:needs-input`: the call, for an error line."""
    words = "gh " + " ".join(args[:2])
    if "--label" in args[:-1]:
        words += " --label " + args[args.index("--label") + 1]
    return words


class GhBatch:
    """gh calls started side by side; results() waits for each until the shared deadline."""

    def __init__(self, gh, calls, cwd, deadline):
        self.calls, self.deadline, self.procs = calls, deadline, []
        env = dict(os.environ, GH_PROMPT_DISABLED="1", GH_NO_UPDATE_NOTIFIER="1", NO_COLOR="1")
        try:
            for args in calls:
                self.procs.append(subprocess.Popen([gh] + args, cwd=cwd, stdin=subprocess.DEVNULL,
                                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
                                                   start_new_session=True))
        except OSError as err:
            self.close()
            raise Problem(f"cannot run gh ({gh}): {err.strerror or err}") from None

    def results(self):
        """One list of objects per call, in order; Problem naming the first call that failed."""
        out = []
        for args, proc in zip(self.calls, self.procs):
            try:
                stdout, stderr = proc.communicate(timeout=max(0.1, self.deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                raise Problem(f"{describe(args)} timed out after {GH_BUDGET} s") from None
            text = stdout.decode("utf-8", "replace")
            if proc.returncode != 0:
                why = first_line(stderr.decode("utf-8", "replace")) or f"exit {proc.returncode}"
                raise Problem(f"{describe(args)} failed: {why}")
            try:
                data = json.loads(text)
            except ValueError:
                raise Problem(f"{describe(args)} printed something other than JSON: {first_line(text)[:80]}") from None
            if not isinstance(data, list):
                raise Problem(f"{describe(args)} did not print a JSON list")
            out.append([x for x in data if isinstance(x, dict)])
        return out

    def close(self):
        """Stop every call still running and release the pipes."""
        for proc in self.procs:
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
            for pipe in (proc.stdout, proc.stderr):
                try:
                    if pipe:
                        pipe.close()
                except OSError:
                    pass
            try:
                proc.wait(timeout=1)
            except (OSError, subprocess.SubprocessError):
                pass


def question(comments):
    """The first line after **Needs your input** in the newest comment that asks, or None."""
    asking = [c for c in comments if isinstance(c, dict) and NEEDS_INPUT in str(c.get("body") or "")]
    if not asking:
        return None
    newest = max(enumerate(asking), key=lambda ic: (str(ic[1].get("createdAt") or ""), ic[0]))[1]
    body = str(newest["body"])
    rest = body[body.index(NEEDS_INPUT) + len(NEEDS_INPUT):]
    return next((clip(line.strip()) for line in rest.splitlines() if line.strip()), None)


def worktrees(path, deadline):
    """[{"path", "branch", "head"}] from `git worktree list --porcelain`; the main working tree first."""
    out = git(path, ["worktree", "list", "--porcelain"], deadline)
    if out.returncode != 0:
        raise Problem(f"git worktree list failed: {first_line(out.stderr) or f'exit {out.returncode}'}")
    found, current = [], None
    for line in out.stdout.splitlines():
        if line.startswith("worktree "):
            current = {"path": line[len("worktree "):], "branch": None, "head": None}
            found.append(current)
        elif current is not None and line.startswith("HEAD "):
            current["head"] = line[len("HEAD "):].strip()
        elif current is not None and line.startswith("branch "):
            ref = line[len("branch "):].strip()
            current["branch"] = ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ref
    return found


def old_worktrees(path, now, deadline):
    """Worktrees under .claude/worktrees/ whose last commit is older than STALE_DAYS (open PRs not checked)."""
    found = worktrees(path, deadline)
    out = []
    for w in found[1:]:
        if "/.claude/worktrees/" not in w["path"].replace(os.sep, "/"):
            continue
        ref = w["head"] or w["branch"]
        if not ref:
            continue
        log = git(path, ["log", "-1", "--format=%ct", ref], deadline)
        when = log.stdout.strip()
        if log.returncode != 0 or not when.isdigit():
            continue
        if now - int(when) > STALE_DAYS * 86400:
            out.append({"path": w["path"], "relative": os.path.relpath(w["path"], found[0]["path"]),
                        "branch": w["branch"], "last_commit": stamp(int(when), now)})
    return out


def label_names(issue):
    labels = issue.get("labels") if isinstance(issue.get("labels"), list) else []
    return {str(lb.get("name")) if isinstance(lb, dict) else str(lb) for lb in labels}


def board_report(project, now):
    """The project's board: counts by status, your open non-draft PRs, the needs-input tickets with their
    question and the stale ticket worktrees. Every field None when the path is gone, there is no origin
    remote whose URL contains github.com or gh is not found; board_error (and the rest None) when the
    calls fail or run out of time."""
    out = {"board": None, "prs_awaiting": None, "needs_input": None, "stale_worktrees": None, "board_error": None}
    deadline = time.monotonic() + GH_BUDGET
    try:
        path, gh = project["path"], gh_binary()
        if gh is None or not os.path.isdir(path):
            return out
        remote = git(path, ["remote", "get-url", "origin"], deadline)
        if remote.returncode != 0 or "github.com" not in remote.stdout.lower():
            return out            # no origin, or one gh cannot read (a local path, another host)
        slug = repo_slug(remote.stdout)
        flag = ["-R", slug] if slug else []
        batch = GhBatch(gh, [["issue", "list", "--state", "open", "--json", "labels", "--limit", "200"] + flag,
                             ["pr", "list", "--author", "@me", "--state", "open", "--json",
                              "number,title,isDraft,createdAt,url,headRefName", "--limit", "100"] + flag,
                             ["issue", "list", "--state", "open", "--label", "status:needs-input", "--json",
                              "number,title,url,comments", "--limit", "100"] + flag,
                             ["pr", "list", "--state", "open", "--json", "headRefName", "--limit", "200"] + flag],
                        path, deadline)
        try:
            old = old_worktrees(path, now, deadline)
            issues, mine, asking, open_prs = batch.results()
        finally:
            batch.close()
        board = {"ready": 0, "in_progress": 0, "in_review": 0, "needs_input": 0}
        for issue in issues:
            names = label_names(issue)
            if "epic" in names:
                continue
            for key in board:
                board[key] += int(f"status:{key.replace('_', '-')}" in names)
        prs = []
        for pr in mine:
            if pr.get("isDraft") is False:
                created = parse_iso(pr.get("createdAt"))
                prs.append({"number": pr.get("number"), "title": clip(pr.get("title") or ""), "url": pr.get("url"),
                            "branch": pr.get("headRefName"), "created_at": pr.get("createdAt"),
                            "age": age(created, now) if created is not None else None})
        needs = [{"number": i.get("number"), "title": clip(i.get("title") or ""), "url": i.get("url"),
                  "question": question(i.get("comments") if isinstance(i.get("comments"), list) else [])}
                 for i in asking]
        heads = {str(p.get("headRefName") or "") for p in open_prs + mine}
        out.update(board=board, prs_awaiting=prs, needs_input=needs,
                   stale_worktrees=[w for w in old if not (w["branch"] and w["branch"] in heads)])
    except Problem as err:
        out["board_error"] = str(err)
    except Exception as err:      # one project never stops the others
        out["board_error"] = f"{type(err).__name__}: {' '.join(str(err).split())}"
    return out


# --------------------------------------------------------------- budgets and runs
def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def exhausted_budgets(now):
    """[{"name", "until", "reason"}] for each budget budgets.json marks exhausted until a time ahead."""
    data = read_json(home(".claude", "harness", "budgets.json"))
    out = []
    for name, entry in (data.items() if isinstance(data, dict) else []):
        until = entry.get("exhausted_until") if isinstance(entry, dict) else None
        when = parse_iso(until)
        if when is not None and when > now:
            out.append({"name": name, "until": until.strip(), "reason": " ".join(str(entry.get("reason") or "").split())})
    return out


def canonical_path(path):
    """The real path of `path` with each component spelled as its parent directory lists
    it, so every spelling of one directory on a case-insensitive file system gives one
    string. From the first component that cannot be found on, the rest stays as spelled."""
    real = os.path.realpath(path)
    done, parts = os.sep, [part for part in real.split(os.sep) if part]
    for i, part in enumerate(parts):
        try:
            names = os.listdir(done)
        except OSError:
            return os.path.join(done, *parts[i:])
        if part not in names:
            fold = unicodedata.normalize("NFC", part).casefold()
            given = os.path.join(done, part)
            for name in names:
                if unicodedata.normalize("NFC", name).casefold() == fold and same_entry(
                    given, os.path.join(done, name)
                ):
                    part = name
                    break
            else:
                return os.path.join(done, *parts[i:])
        done = os.path.join(done, part)
    return done


def same_entry(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def path_key(path):
    """The first 12 hex digits of the sha1 of the path string as it is spelled."""
    return hashlib.sha1(str(path).encode("utf-8", "surrogateescape")).hexdigest()[:12]


def repo_key(path):
    """The state key of a main working tree: path_key of its canonical path."""
    return path_key(canonical_path(path))


def run_project(record, filename, projects):
    """The registered project a run belongs to (by its repo field, else its file's key), else a short name."""
    repo = record.get("repo") if isinstance(record.get("repo"), str) else ""
    for p in projects:
        if repo and (p["name"] == repo or same_path(p["path"], repo) or repo_key(p["path"]) == repo_key(repo)):
            return p["name"]
    key = os.path.basename(filename)[:12]
    for p in projects:                  # the canonical key, or the old key of the registered spelling
        if key in (repo_key(p["path"]), path_key(os.path.realpath(p["path"]))):
            return p["name"]
    return (os.path.basename(repo.rstrip("/")) or repo) if repo else key


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (OSError, OverflowError, ValueError):
        return False
    return True


def recent_runs(projects, now):
    """Headless and background runs that are alive or ended in the last RUNS_WINDOW seconds: running ones
    first, then the newest ended. A run with no end recorded whose process is gone is `exited` (not swept)."""
    out = []
    for name in sorted(glob.glob(os.path.join(glob.escape(home(".claude", "harness", "runs")), "*.json"))):
        record = read_json(name)
        if not isinstance(record, dict):
            continue
        started, ended, pid = parse_iso(record.get("started_at")), parse_iso(record.get("ended_at")), record.get("pid")
        if ended is None and not record.get("outcome"):
            if isinstance(pid, int) and not isinstance(pid, bool) and pid > 0 and not pid_alive(pid):
                state = "exited"                       # gone, not swept yet: when its log last changed
                try:
                    ended = os.path.getmtime(record["log"]) if isinstance(record.get("log"), str) else os.path.getmtime(name)
                except OSError:
                    ended = started
            else:
                state = "running"
        else:
            state = str(record.get("outcome") or "ended")
            if ended is None:
                try:
                    ended = os.path.getmtime(name)
                except OSError:
                    continue
        if state != "running" and (ended is None or now - ended > RUNS_WINDOW):
            continue
        when = started if state == "running" else ended          # running: since it started; else: since it ended
        out.append(((state != "running", -(when or 0)),
                    {"id": record.get("id") or os.path.basename(name)[:-5], "project": run_project(record, name, projects),
                     "ticket": record.get("ticket"), "venue": record.get("venue"), "state": state,
                     "exit": record.get("exit"), "started_at": record.get("started_at"),
                     "ended_at": record.get("ended_at"), "log": record.get("log"),
                     "age": age(when, now) if when is not None else None}))
    out.sort(key=lambda pair: pair[0])
    return [run for _, run in out]


# --------------------------------------------------------------- output
def board_lines(r):
    """The board lines of one project (none when it was not read)."""
    if r.get("board_error"):
        return [f"- Board: could not read it ({r['board_error']})"]
    b = r.get("board")
    if b is None:
        return []
    out = [f"- Board: {b['ready']} ready, {b['in_progress']} in progress, {b['in_review']} in review, "
           f"{b['needs_input']} needs input"]
    if r["prs_awaiting"]:
        out += ["- PRs awaiting you:"] + [f"  - #{x['number']} {x['title']}" + (f" (opened {x['age']})" if x["age"] else "")
                                         for x in r["prs_awaiting"]]
    if r["needs_input"]:
        out += ["- Needs input:"] + [f"  - #{x['number']} {x['title']}" + (f": {x['question']}" if x["question"] else "")
                                    for x in r["needs_input"]]
    if r["stale_worktrees"]:
        out += ["- Stale worktrees:"] + [f"  - {w['branch'] or 'detached'} at {w['relative']}, "
                                        f"last commit {w['last_commit']['age']}" for w in r["stale_worktrees"]]
    return out


def run_text(r):
    ticket = f" #{r['ticket']}" if r.get("ticket") is not None else ""
    head = f"- {r['project']}{ticket} {r.get('venue') or 'run'}: "
    if r["state"] == "running":
        return head + "running" + (f", started {r['age']}" if r["age"] else "")
    exit_code = f" (exit {r['exit']})" if r.get("exit") is not None else ""
    text = head + r["state"] + exit_code + (f", ended {r['age']}" if r["age"] else "")
    if r["state"] == "exited":
        text += ", not swept yet"
    if r["state"] not in ("ok", "running") and r.get("log"):
        text += f"; log {r['log']}"
    return text


def git_text(g):
    if not g.get("repo"):
        return "not a git repo"
    if g.get("error"):
        return g["error"]
    parts = [g["branch"] or "unknown branch", f"{g['uncommitted']} uncommitted"]
    if g["upstream"]:
        if g["ahead"] is None:
            parts.append(f"upstream {g['upstream']} is gone")
        elif g["ahead"] == g["behind"] == 0:
            parts.append(f"up to date with {g['upstream']}")
        else:
            parts.append(f"{g['ahead']} ahead / {g['behind']} behind {g['upstream']}")
    c = g["last_commit"]
    parts.append(f"last commit {c['age']}: {c['subject']}" if c else "no commits yet")
    return ", ".join(parts)


def markdown(reports, fleet, fleet_error, registered, budgets=(), runs=()):
    out = []
    if not registered:
        out += ["No projects registered: `harness-projects discover` lists candidates, "
                "`harness-projects add <path>` registers one.", ""]
    for r in reports:
        out.append(f"## {r['name']} `{r['path']}`")
        if r["error"]:
            out += [f"- {r['error']}", ""]
            continue
        out.append(f"- git: {git_text(r['git'])}")
        out.append(f"- last session: {r['last_session']['age'] if r['last_session'] else 'none recorded'}")
        if r["next"]:
            out += ["- next:"] + [f"  - {line}" for line in r["next"]]
        else:
            out.append("- next: none recorded")
        if r["latest_spec"]:
            out.append(f"- latest spec: {r['latest_spec']}")
        if r["billable"]:
            h = r["hours_this_month"]
            out.append(f"- hours this month: {h:.2f}" if h is not None else "- hours this month: no worklog/worklog.csv")
        out += board_lines(r)
        if r["sessions"] is not None:
            out.append("- sessions: " + (", ".join(session_text(e) for e in r["sessions"]) or "none"))
        out.append("")
    out.append("## Fleet")
    if fleet_error:
        out.append(f"- could not read the fleet: {fleet_error}")
    elif not fleet:
        out.append("- no sessions running")
    else:
        out += [f"- {fleet_text(e)}" for e in sorted(fleet, key=lambda e: e.get("status") != "waiting")]
    if budgets:
        out += ["", "## Budgets"] + [f"- {b['name']} exhausted until {b['until']}" + (f" ({b['reason']})" if b["reason"] else "")
                                     for b in budgets]
    if runs:
        out += ["", "## Runs"] + [run_text(r) for r in runs]
    return "\n".join(out)


def main():
    ap = Parser(prog="harness-standup", description="The cross-project standup: every registered project, "
                                                    "then the fleet of running Claude Code sessions.")
    ap.add_argument("project", nargs="?", help="only this project, by name or path")
    ap.add_argument("--json", action="store_true", help="print the structure behind the Markdown")
    args = ap.parse_args()
    now = time.time()
    deadline = time.monotonic() + BUDGET
    try:
        registered = load_projects()
        projects = [pick(registered, args.project)] if args.project else registered
    except Problem as err:
        sys.exit(f"harness-standup: {err}")
    box = {}
    reader = threading.Thread(target=read_fleet_into, args=(box,), daemon=True)
    reader.start()
    workers = max(1, min(8, len(projects)))
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as gh_pool:
        boards = [gh_pool.submit(board_report, p, now) for p in projects]       # gh side by side with git
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            reports = list(pool.map(lambda p: report(p, deadline, now), projects))
        for r, board in zip(reports, boards):
            r.update(board.result())
            if r["error"]:
                r.update(board=None, prs_awaiting=None, needs_input=None, stale_worktrees=None, board_error=None)
    budgets, runs = exhausted_budgets(now), recent_runs(registered, now)
    reader.join(FLEET_TIMEOUT + 1)
    fleet, fleet_error = box.get("fleet", (None, f"`claude agents --json` timed out after {FLEET_TIMEOUT} s"))
    if fleet is not None:
        for r in reports:
            if not r["error"]:
                r["sessions"] = [e for e in fleet if under(e.get("cwd"), r["path"])]
    if args.json:
        print(json.dumps({"generated": dt.datetime.fromtimestamp(now).astimezone().isoformat(timespec="seconds"),
                          "projects": reports, "fleet": fleet, "fleet_error": fleet_error, "budgets": budgets,
                          "runs": runs}, indent=2, ensure_ascii=False))
    else:
        print(markdown(reports, fleet, fleet_error, bool(registered), budgets, runs))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:                      # the reader went away (| head): stop quietly
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
    except Exception as err:                     # never a traceback: one line, exit 1
        sys.exit(f"harness-standup: {type(err).__name__}: {' '.join(str(err).split())}")
