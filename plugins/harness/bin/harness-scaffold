#!/usr/bin/env python3
"""
Sets a project up for the harness: CLAUDE.md, .claude/settings.json, scripts/verify.sh, CI and deploy
workflows with scripts/smoke.sh and scripts/deploy_guard.py, the PR and issue templates, a pre-commit
hook, .gitignore and .worktreeinclude, plus a skeleton for the stack. Then commits it (a repo with no
commits) or lands it through a ticket and a pull request (a repo that already has commits), and
optionally creates the GitHub repository and registers the project.

Usage:
    harness-scaffold init [PATH] --name NAME [--stack python|node|none] [--verify CMD] [--test-cmd CMD]
                          [--github] [--register [--billable] [--client C]] [--no-ci] [--force] [--dry-run]
    harness-scaffold labels [PATH]          # harness-board labels ensure, for an existing repo

Templates live in ../templates next to this script and are rendered by plain substitution of
{{name}}, {{pkg}}, {{stack}}, {{verify_cmd}}, {{test_cmd}}, {{tests_dirs}}, {{python_version}}, {{year}}:
- Only those known keys are replaced, and never right after a `$`, so GitHub Actions expressions
  such as ${{ github.ref }} and unknown tokens such as {{number}} pass through untouched.
- In a text template, a line that holds a placeholder whose value is empty is left out (the none
  stack has no test command, so CLAUDE.md drops that line).
- JSON templates (settings.json, package.json) are parsed first and substituted inside their string
  values, so a command with quotes stays valid JSON; empty env values are dropped from settings.json.
- A template with a stack variant is looked up as <stem>-<stack><ext> first: verify-python.sh,
  ci-node.yml, pre-commit-python. The plain file (verify.sh, ci.yml, pre-commit) serves the rest.
- {{pkg}} is the package name in the stack's own convention: the import name for python
  (demo-app -> demo_app), the lower-cased name for node.
- --verify CMD replaces the stack's checks in scripts/verify.sh and is written as is (no substitution
  in CMD). Stack none then points CLAUDE_VERIFY_CMD at scripts/verify.sh; python and node keep CMD.
- {{tests_dirs}} (CLAUDE.md) is the -s directory of a `unittest discover` in --verify, else the tests/,
  test/ and plugins/*/tests directories on disk, else the tests/ of a skeleton about to be written
  (none when the project keeps its own layout), else empty (the line is dropped).

Rules: an existing file is never overwritten without --force, and each path is reported as
created, kept or updated. A kept .claude/settings.json is never edited, but `warn:` lines (--dry-run
and the real run alike) name each ask or deny rule that would stop a dispatched run on a loop command
(git, gh, harness-*, the file's own CLAUDE_VERIFY_CMD, else the rendered one), each allow entry of the
stack's template that no allow rule covers (an allow rule Bash(harness-*:*), which matches no tool since
a ':*' rule is a literal prefix, gets one line naming the template's harness-<tool> rules in place of
theirs) and each env key of it that is absent, with the value to add; a file that is not usable
settings gets one warn line.
The scaffolded ci.yml runs on pull requests and by hand only (no push to main). Run again on a project whose
ci.yml has the old template's `on:` mapping exactly (push on main, pull_request, workflow_dispatch, nothing
else in it), init drops the two push lines and no other byte, reports `updated .github/workflows/ci.yml` and a
line naming the dropped push trigger, and on the adopt path counts it as a changed file, rewritten from the
worktree's own ci.yml; any other `on:` is kept. A run that would leave ci.yml without a push trigger (created,
rewritten or replaced) while the deploy.yml it leaves in place runs on workflow_run of CI (its top-level `on:`,
then `workflow_run:`, then `workflows:` holding CI) is refused with one line before anything is written, also
with --dry-run. The workflow files are read by a small indentation-scoped YAML reader (yaml_lines, block_node).
The stack skeleton (pyproject.toml, src/<pkg>/__init__.py,
tests/test_smoke.py; package.json, tests/smoke.test.js) is written only when the project has no
manifest of any stack, no Makefile with a test or check target and no tests (a tests/, test/ or spec/
directory, or a file matching the test patterns outside dot-directories, node_modules, __pycache__
and virtualenvs); otherwise both --dry-run and the real run say
`kept the project's own layout (<what was found>)`.
Sibling tools (harness-board, harness-work, harness-pr, harness-projects) are called by name on
PATH, else from this script's folder. `gh` is os.environ.get("HARNESS_GH", "gh").
"""
from __future__ import annotations

import datetime as dt
import fnmatch
import json
import keyword
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

_LIB = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)
try:
    from harness_lib.cli import Parser, Problem, run_main
    from harness_lib.text import last_line, one_line
except Exception as exc:  # one line, exit 1, like run_main
    sys.exit(f"harness-scaffold: cannot load harness_lib from {_LIB}: {' '.join(str(exc).split())}")

TEMPLATES = Path(__file__).resolve().parent.parent / "templates"
HERE = Path(__file__).resolve().parent
STACKS = ("python", "node", "none")
PYTHON_VERSION = "3.10"
NAME_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$")
TOKEN = re.compile(r"(?<!\$)\{\{(\w+)\}\}")
EXCLUDE_LINE = ".claude/worktrees/"
ADOPT_TITLE = "Adopt the harness scaffold"
NO_RULESET = ("Branch protection is unavailable on this plan for a private repo; "
              "the local branch guard is the only block.")
TOOL_TIMEOUT = 1800          # harness-work start runs the worktree setup (uv sync, npm ci)

# Test runners each stack's settings.json allows on top of the template's list.
STACK_ALLOW = {
    "python": ["Bash(uv run pytest:*)", "Bash(uv run ruff:*)", "Bash(python3 -m pytest:*)"],
    "node": ["Bash(npm test:*)", "Bash(npm run lint:*)", "Bash(node --test:*)"],
    "none": [],
}

# Commands a dispatched run needs, as words: an ask or deny rule on any of them (or inside or around one)
# stops it, since a headless run cannot answer. The verify command and every harness-* tool come on top.
LOOP_COMMANDS = [["git", "add"], ["git", "commit"], ["git", "push"], ["git", "fetch"], ["git", "worktree"],
                 ["gh", "issue"], ["gh", "pr"], ["gh", "api"]]
KEPT = ".claude/settings.json"
# The old allow spelling for every harness tool. It matches none: a rule ending in ':*' is a literal prefix
# (here 'harness-*'); a kept file holding it is told to use the template's own harness-<tool> rules instead.
OLD_HARNESS_RULE = "Bash(harness-*:*)"
HARNESS_TOOL_RULE = re.compile(r"Bash\(harness-[a-z]+:\*\)")

# The skeleton of each stack: (template, destination). Written only when own_layout() finds nothing.
SKELETON = {
    "python": [("pyproject.toml", "pyproject.toml"), (None, "src/{pkg}/__init__.py"),
               ("test_smoke.py", "tests/test_smoke.py")],
    "node": [("package.json", "package.json"), ("smoke.test.js", "tests/smoke.test.js")],
    "none": [],
}
MANIFEST = {"python": "pyproject.toml", "node": "package.json"}
# Any of these, of any stack, means the project has its own layout.
MANIFESTS = ("pyproject.toml", "package.json", "setup.py", "setup.cfg", "requirements.txt", "Cargo.toml", "go.mod")
MAKEFILES = ("GNUmakefile", "makefile", "Makefile")           # the names GNU make reads
TESTS_DIRS = ("tests", "test", "spec")
# The file-name half of the HARNESS_TEST_PATTERNS default (harness-red, tests_first.py), at any depth;
# its tests/**, test/** and spec/** are TESTS_DIRS.
TEST_FILE_PATTERNS = ("test_*.py", "*_test.py", "conftest.py", "*_test.js", "*.test.js", "*.test.ts", "*_test.ts")
# Not searched for test files, besides every dot-directory and any directory holding a pyvenv.cfg.
WALK_SKIP = ("node_modules", "__pycache__")
LAYOUT_SHOWN = 10                                             # loose test files named before `+N more`
# A rule line: its targets, then `:` or `::` followed by neither `=` nor `:` (that would be a :=, ::= or
# :::= assignment).
MAKE_RULE = re.compile(r"^([^:=#]*?)\s*::?(?![:=])")
INIT_PY = '"""{{name}}."""\n\n__version__ = "0.1.0"\n'

CI_YML = ".github/workflows/ci.yml"
DEPLOY_YML = ".github/workflows/deploy.yml"
# The `on:` mapping of every scaffolded ci.yml before #339. Run again, init drops its two push lines (and
# touches no other byte), so CI runs on pull requests and by hand only, as the templates now do.
OLD_CI_ON = ["on:", "  push:", "    branches: [main]", "  pull_request:", "  workflow_dispatch:"]
# A YAML block mapping key: quoted, or plain up to a `:` that ends the line or is followed by a blank.
YAML_KEY = re.compile(r"""("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^\s"'#\[\]{},&*!|>%@`-][^#]*?|-\S[^#]*?)\s*:"""
                      r"(?:[ \t]+(.*))?$")
BLOCK_SCALAR = re.compile(r"[|>][1-9+-]{0,2}")                # `run: |`, `>-`: the value is the lines below

# GitHub reads an issue template from .github/ISSUE_TEMPLATE only with this front matter.
ISSUE_FRONT = {
    "task.md": ("Task", "One ticket: request, outline, definition of done, the tests that must pass",
                ["task", "status:ready"]),
    "epic.md": ("Epic", "A goal split into sub-issue tasks", ["epic", "status:ready"]),
}

RULESET = {
    "name": "main",
    "target": "branch",
    "enforcement": "active",
    "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
    "rules": [
        {"type": "pull_request", "parameters": {
            "required_approving_review_count": 0, "dismiss_stale_reviews_on_push": False,
            "require_code_owner_review": False, "require_last_push_approval": False,
            "required_review_thread_resolution": False}},
        {"type": "non_fast_forward"},
        {"type": "deletion"},
    ],
}


def say(text=""):
    print(text, flush=True)


def last_line_collapsed(text):
    """The last non-empty line of a command's output, whitespace collapsed."""
    return one_line(last_line(text))


# --------------------------------------------------------------- processes
def run(cmd, cwd=None, check=True, input=None, env=None, timeout=300):
    """Run a command; a missing program or (with check) a non-zero exit becomes a Problem."""
    try:
        p = subprocess.run(cmd, cwd=cwd, input=input, env=env, capture_output=True, text=True,
                           timeout=timeout, stdin=None if input is not None else subprocess.DEVNULL)
    except FileNotFoundError:
        raise Problem(f"{cmd[0]} not found")
    except subprocess.TimeoutExpired:
        raise Problem(f"{' '.join(cmd[:3])} timed out after {timeout} s")
    if check and p.returncode != 0:
        why = last_line_collapsed(p.stderr) or last_line_collapsed(p.stdout) or f"exit {p.returncode}"
        raise Problem(f"{' '.join(cmd[:3])} failed: {why}")
    return p


def git(root, *args, check=True):
    return run(["git", "-C", str(root)] + list(args), check=check)


def gh_cmd():
    return os.environ.get("HARNESS_GH", "gh")


def sibling(name):
    """A sibling bin tool: on PATH, else next to this script."""
    found = shutil.which(name)
    if found:
        return found
    here = HERE / name
    if here.is_file() and os.access(here, os.X_OK):
        return str(here)
    raise Problem(f"{name} not found on PATH or in {HERE}")


def call(name, *args, cwd, project):
    """Run a sibling tool in `cwd` with CLAUDE_PROJECT_DIR pointing at `project`; its stdout."""
    env = dict(os.environ, CLAUDE_PROJECT_DIR=str(project))
    p = run([sibling(name)] + list(args), cwd=cwd, env=env, check=False, timeout=TOOL_TIMEOUT)
    if p.returncode != 0:
        why = last_line_collapsed(p.stderr) or last_line_collapsed(p.stdout) or f"exit {p.returncode}"
        raise Problem(f"{name} {' '.join(args[:2])} failed: {why}")
    return p.stdout


def quoted(args):
    return " ".join(shlex.quote(str(a)) for a in args)


# --------------------------------------------------------------- repository
def toplevel(path):
    """The repository toplevel containing `path`, or None outside a repository."""
    if not path.is_dir():
        return None
    p = git(path, "rev-parse", "--show-toplevel", check=False)
    return Path(p.stdout.strip()).resolve() if p.returncode == 0 and p.stdout.strip() else None


def has_commits(root):
    return git(root, "rev-parse", "--verify", "--quiet", "HEAD", check=False).returncode == 0


def has_origin(root):
    return git(root, "remote", "get-url", "origin", check=False).returncode == 0


def detect_stack(root):
    """python when pyproject.toml or a top-level *.py is present, node when package.json is, else none."""
    if (root / "pyproject.toml").is_file() or any(p.is_file() for p in root.glob("*.py")):
        return "python"
    if (root / "package.json").is_file():
        return "node"
    return "none"


def make_targets(text):
    """The targets a makefile's rule lines define; recipe lines, comments and assignments are not rules."""
    targets = set()
    for line in text.splitlines():
        if line.startswith("\t"):
            continue
        m = MAKE_RULE.match(line.split("#", 1)[0].lstrip(" "))
        if m:
            targets.update(m.group(1).split())
    return targets


def own_layout(root):
    """What shows the project has its own layout: manifests of any stack, a makefile with a test or
    check target, tests/, test/ and spec/ directories, and test files anywhere else (dot-directories,
    node_modules, __pycache__ and virtualenvs left out). Empty for a new or empty folder, which gets
    the stack skeleton."""
    try:
        names = set(os.listdir(root))                 # exact names, also on a case-insensitive disk
    except OSError:
        return []
    found = [m for m in MANIFESTS if m in names and (root / m).is_file()]
    for name in MAKEFILES:
        if name in names and (root / name).is_file():
            try:
                text = (root / name).read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if make_targets(text) & {"test", "check"}:
                found.append(name)
    dirs = [d for d in TESTS_DIRS if d in names and (root / d).is_dir()]
    found += [f"{d}/" for d in dirs]
    loose = []
    for here, subdirs, files in os.walk(root):
        top = Path(here) == root
        subdirs[:] = sorted(d for d in subdirs
                            if not d.startswith(".") and d not in WALK_SKIP and not (top and d in dirs)
                            and not os.path.isfile(os.path.join(here, d, "pyvenv.cfg")))
        rel = Path(here).relative_to(root)
        loose += [(rel / f).as_posix() for f in sorted(files)
                  if any(fnmatch.fnmatchcase(f, p) for p in TEST_FILE_PATTERNS)]
    if len(loose) > LAYOUT_SHOWN:
        loose = loose[:LAYOUT_SHOWN] + [f"+{len(loose) - LAYOUT_SHOWN} more test files"]
    return found + loose


def package_name(name, stack):
    if stack == "node":
        return name.lower()
    pkg = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")
    if keyword.iskeyword(pkg):
        return pkg + "_"
    return "_" + pkg if pkg[0].isdigit() else pkg


def shell_commands(line):
    """The simple commands of a shell line, each a list of its unquoted words. Splits at ;, &&, ||, |
    and newlines outside quotes only."""
    commands, words, word, in_word, quote, i = [], [], "", False, "", 0

    def end_word():
        nonlocal word, in_word
        if in_word:
            words.append(word)
        word, in_word = "", False

    while i < len(line):
        c = line[i]
        if quote:
            if c == quote:
                quote = ""
            elif c == "\\" and quote == '"' and line[i + 1:i + 2] in ('"', "\\", "$", "`"):
                i += 1
                word += line[i]
            else:
                word += c
        elif c in "'\"":
            quote, in_word = c, True
        elif c == "\\" and i + 1 < len(line):
            i += 1
            word, in_word = word + line[i], True
        elif c in " \t":
            end_word()
        elif c in ";\n|" or line.startswith("&&", i):
            end_word()
            commands.append(words)
            words = []
            i += 1 if line.startswith(("&&", "||"), i) else 0
        else:
            word, in_word = word + c, True
        i += 1
    end_word()
    commands.append(words)
    return [c for c in commands if c]


def discover_start_dir(command):
    """The -s/--start-directory value (any argparse spelling) of a `unittest discover` in a shell
    command, or None. A -s on another command is not a tests directory."""
    found = None
    for words in shell_commands(command):
        for at in range(len(words) - 1):
            if words[at:at + 2] != ["unittest", "discover"]:
                continue
            rest = words[at + 2:]
            for n, word in enumerate(rest):
                if word in ("-s", "--start-directory"):
                    found = rest[n + 1] if n + 1 < len(rest) else found
                elif word.startswith("--start-directory="):
                    found = word.split("=", 1)[1]
                elif word.startswith("-s") and not word.startswith("--"):
                    found = word[2:].lstrip("=")
    return found or None


def tests_dirs(root, stack, verify, layout):
    """The tests directories CLAUDE.md names: the verify command's discover start directory, else those
    on disk (tests/, test/, plugins/*/tests), else the stack skeleton's tests/, else none. `layout` is
    own_layout(root): the skeleton is written only when it is empty."""
    start = discover_start_dir(verify) if verify else None
    if start:
        return [start.rstrip("/") or start]
    found = [d for d in ("tests", "test") if (root / d).is_dir()]
    found += sorted(p.relative_to(root).as_posix() for p in root.glob("plugins/*/tests") if p.is_dir())
    skeleton = bool(SKELETON[stack]) and not layout                           # plan() writes it only then
    return found or (["tests"] if skeleton else [])


def default_test_cmd(root, stack, layout):
    """uv when the project is a uv project (uv.lock) or the skeleton is about to make it one (`layout`,
    own_layout(root), is empty), else the stack's plain runner."""
    if stack == "python":
        uv_project = (root / "uv.lock").exists() or not layout
        return "uv run pytest -q {files}" if uv_project else "python3 -m pytest -q {files}"
    if stack == "node":
        return "npm test -- {files}"
    return ""


# --------------------------------------------------------------- rendering
def substitute(text, values):
    return TOKEN.sub(lambda m: values[m.group(1)] if m.group(1) in values else m.group(0), text)


def render_text(text, values):
    """Substitute the known placeholders; drop a line that holds one whose value is empty."""
    out = []
    for line in text.splitlines(keepends=True):
        keys = [m.group(1) for m in TOKEN.finditer(line) if m.group(1) in values]
        if any(values[k] == "" for k in keys):
            continue
        out.append(substitute(line, values))
    return "".join(out)


def render_json(text, values):
    def walk(node):
        if isinstance(node, str):
            return substitute(node, values)
        if isinstance(node, list):
            return [walk(x) for x in node]
        if isinstance(node, dict):
            return {substitute(k, values): walk(v) for k, v in node.items()}
        return node
    return walk(json.loads(text))


def template_path(name, stack):
    stem, ext = os.path.splitext(name)
    variant = TEMPLATES / f"{stem}-{stack}{ext}"
    path = variant if variant.is_file() else TEMPLATES / name
    if not path.is_file():
        raise Problem(f"template {name} missing from {TEMPLATES}")
    return path


def read_template(name, stack):
    return template_path(name, stack).read_text(encoding="utf-8")


def settings_json(values, stack, verify):
    if verify is not None and stack == "none":     # verify.sh runs the command; this stack has no default
        values = dict(values, verify_cmd="scripts/verify.sh")
    data = render_json(read_template("settings.json", stack), values)
    data["env"] = {k: v for k, v in data.get("env", {}).items() if v != ""}
    allow = data.setdefault("permissions", {}).setdefault("allow", [])
    allow.extend(rule for rule in STACK_ALLOW[stack] if rule not in allow)
    return json.dumps(data, indent=2) + "\n"


def verify_script(values, stack, verify):
    """scripts/verify.sh: the stack's checks, or only --verify (written as is) when it is given."""
    text = render_text(read_template("verify.sh", stack), values)
    if verify is None:
        return text
    lines = text.splitlines(keepends=True)
    start = next(i for i, ln in enumerate(lines) if ln.startswith("cd ")) + 1
    end = next(i for i, ln in enumerate(lines) if ln.startswith("echo VERIFY OK"))
    return "".join(lines[:start] + ["\n", verify + "\n", "\n"] + lines[end:])


def issue_template(name, stack, dest, values):
    title, about, labels = ISSUE_FRONT[dest]
    front = (f"---\nname: {json.dumps(title)}\nabout: {json.dumps(about)}\ntitle: \"\"\n"
             f"labels: [{', '.join(json.dumps(x) for x in labels)}]\n---\n\n")
    return front + render_text(read_template(name, stack), values)


def plan(root, stack, values, ci, verify=None, layout=()):
    """[(destination, content, mode)] for every file the scaffold writes into `root`; the stack skeleton
    only when `layout` (own_layout) is empty."""
    files = [
        ("CLAUDE.md", render_text(read_template("CLAUDE.md", stack), values), 0o644),
        (".claude/settings.json", settings_json(values, stack, verify), 0o644),
        ("scripts/verify.sh", verify_script(values, stack, verify), 0o755),
    ]
    if ci:
        files += [(".github/workflows/ci.yml", render_text(read_template("ci.yml", stack), values), 0o644),
                  (".github/workflows/deploy.yml", render_text(read_template("deploy.yml", stack), values),
                   0o644),
                  ("scripts/smoke.sh", render_text(read_template("smoke.sh", stack), values), 0o755),
                  ("scripts/deploy_guard.py", render_text(read_template("deploy_guard.py", stack), values),
                   0o755)]
    files += [
        (".github/pull_request_template.md",
         render_text(read_template("pull_request_template.md", stack), values), 0o644),
        (".github/ISSUE_TEMPLATE/task.md", issue_template("ticket_task.md", stack, "task.md", values), 0o644),
        (".github/ISSUE_TEMPLATE/epic.md", issue_template("ticket_epic.md", stack, "epic.md", values), 0o644),
        (".githooks/lib.sh", render_text(read_template("githooks-lib.sh", stack), values), 0o644),
        (".githooks/pre-commit", render_text(read_template("pre-commit", stack), values), 0o755),
        (".githooks/pre-merge-commit", render_text(read_template("pre-merge-commit", stack), values), 0o755),
        (".githooks/pre-push", render_text(read_template("pre-push", stack), values), 0o755),
        (".gitignore", render_text(read_template("gitignore", stack), values), 0o644),
        (".worktreeinclude", render_text(read_template("worktreeinclude", stack), values), 0o644),
    ]
    manifest = MANIFEST.get(stack)
    if manifest and (root / manifest).exists():
        files.append((manifest, None, 0o644))          # reported as kept
    if layout:                                         # the project's own layout: no skeleton added
        return files
    for template, dest in SKELETON[stack]:
        dest = dest.format(pkg=values["pkg"])
        if template is None:
            content = render_text(INIT_PY, values)
        elif template.endswith(".json"):
            content = json.dumps(render_json(read_template(template, stack), values), indent=2) + "\n"
        else:
            content = render_text(read_template(template, stack), values)
        files.append((dest, content, 0o644))
    return files


# --------------------------------------------------------------- workflows
def uncomment(line):
    """`line` without its comment: from a `#` at the start or after a blank, outside a quoted scalar (one
    that opens where a scalar starts: the line's start, after `[`, `{` or `,`, or after `: ` or `- `)."""
    quote, i = "", 0
    while i < len(line):
        c = line[i]
        if quote:
            if c == "\\" and quote == '"':
                i += 1
            elif c == quote == "'" and line[i + 1:i + 2] == "'":
                i += 1
            elif c == quote:
                quote = ""
        elif c in "\"'":
            before = line[:i].rstrip(" \t")
            if before[-1:] in ("", "[", "{", ",") or (before[-1:] in (":", "-") and len(before) < i):
                quote = c
        elif c == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i]
        i += 1
    return line


def is_item(text):
    return text == "-" or text.startswith(("- ", "-\t"))


def yaml_lines(text):
    """The content lines of a YAML document as [line number, indent, text]: blank lines, comments, document
    markers and the body of each block scalar (`run: |`, whatever it holds) left out."""
    out, scalar = [], None
    for n, line in enumerate(text.split("\n")):
        line = line.rstrip("\r")
        if scalar is not None and (not line.strip() or len(line) - len(line.lstrip(" ")) > scalar):
            continue
        scalar = None
        body = uncomment(line).rstrip()
        indent = len(body) - len(body.lstrip(" "))
        body = body.lstrip(" ")
        if not body or (indent == 0 and (body in ("---", "...") or body.startswith(("--- ", "%")))):
            continue
        out.append([n, indent, body])
        item = re.match(r"(?:-[ \t]+)*", body).end()          # the `- ` of sequence items before the node
        key = YAML_KEY.match(body[item:])
        if BLOCK_SCALAR.fullmatch(((key.group(2) or "") if key else body[item:]).strip()):
            scalar = indent + item if key else indent + item - 2 if item else indent - 1
    return out


def flow_node(s, i, inner=True):
    """(value, end) of the flow node at s[i]: [..] a list, {..} a dict, a quoted scalar unquoted, a plain one
    stripped (inside a collection it ends at `,`, a bracket or `: `). IndexError or ValueError when it is
    not one."""
    while s[i:i + 1] in (" ", "\t"):
        i += 1
    c = s[i:i + 1]
    if c in ("[", "{"):
        close, out = ("]", []) if c == "[" else ("}", {})
        i += 1
        while s[i:i + 1] in (" ", "\t"):
            i += 1
        while s[i] != close:
            item, i = flow_node(s, i)
            pair, value = False, None
            while s[i] in " \t":
                i += 1
            if s[i] == ":":                                    # a pair: a key of a mapping, else a one-pair one
                pair = True
                value, i = flow_node(s, i + 1)
                while s[i] in " \t":
                    i += 1
            if isinstance(out, dict):
                out[str(item)] = value
            else:
                out.append({str(item): value} if pair else item)
            if s[i] == ",":
                i += 1
                while s[i] in " \t":
                    i += 1
            elif s[i] != close:
                raise ValueError(s)
        return out, i + 1
    if c in ('"', "'"):
        j, chars = i + 1, []
        while s[j] != c or (c == "'" and s[j + 1:j + 2] == "'"):
            if s[j] == "'" == c or (s[j] == "\\" and c == '"'):  # '' is one ', \x is x
                j += 1
            chars.append(s[j])
            j += 1
        return "".join(chars), j + 1
    j = i
    while j < len(s) and not (inner and (s[j] in ",[]{}" or (s[j] == ":" and s[j + 1:j + 2] in ("", " ", "\t")))):
        j += 1
    return s[i:j].strip(), j


def flow(text):
    """The value of a flow node (flow_node); text that is not one node, the text stripped."""
    try:
        value, end = flow_node(text, 0, inner=False)
    except (IndexError, ValueError):
        return text.strip()
    return value if not text[end:].strip() else text.strip()


def entries(lines):
    """(start, end) of each entry of the block collection in `lines`: a line no deeper than the first and
    the deeper lines after it; a key without a value also takes the `- ` lines at its own indent."""
    indent, i = lines[0][1], 0
    while i < len(lines):
        start, text = i, lines[i][2]
        key = None if is_item(text) else YAML_KEY.match(text)
        bare = key is not None and not (key.group(2) or "").strip()
        i += 1
        while i < len(lines) and (lines[i][1] > indent or (bare and lines[i][1] == indent and is_item(lines[i][2]))):
            i += 1
        yield start, i


def block_node(lines):
    """The value of the block node in `lines` (yaml_lines), the first of them the least indented: a dict, a
    list, a string ("" for a block scalar) or None."""
    if not lines:
        return None
    if is_item(lines[0][2]):
        out = []
        for start, end in entries(lines):
            n, indent, text = lines[start]
            rest = text[1:].lstrip(" \t")
            if is_item(text):
                head = [[n, indent + len(text) - len(rest), rest]] if rest else []
                out.append(block_node(head + lines[start + 1:end]))
        return out
    if not YAML_KEY.match(lines[0][2]):                        # a scalar, maybe over several lines
        return flow(" ".join(text for _, _, text in lines))
    out = {}
    for start, end in entries(lines):
        key = None if is_item(lines[start][2]) else YAML_KEY.match(lines[start][2])
        if key is None:
            continue
        value, below = (key.group(2) or "").strip(), lines[start + 1:end]
        if BLOCK_SCALAR.fullmatch(value):
            out[flow(key.group(1))] = ""
        elif value:
            out[flow(key.group(1))] = flow(" ".join([value] + [text for _, _, text in below]))
        else:
            out[flow(key.group(1))] = block_node(below)
    return out


def waits_for_ci(text):
    """Whether a workflow runs on workflow_run of the workflow named CI: its top-level `on:` (or `"on":`)
    mapping has a workflow_run whose `workflows:` (a flow or block list, or one name) holds `CI` exactly."""
    doc = block_node(yaml_lines(text))
    on = doc.get("on") if isinstance(doc, dict) else None
    run = on.get("workflow_run") if isinstance(on, dict) else None
    names = run.get("workflows") if isinstance(run, dict) else None
    return "CI" in (names if isinstance(names, list) else [names])


def drop_old_push(text):
    """`text` without its two push lines when its top-level `on:` mapping is exactly OLD_CI_ON: those five
    lines in a row, and the next content line (blank and comment lines are not) at the top level. None for
    any other `on:`. Every other byte stays, a missing final newline included."""
    lines = yaml_lines(text)
    at = next((k for k, (_, indent, body) in enumerate(lines)
               if indent == 0 and YAML_KEY.match(body) and flow(YAML_KEY.match(body).group(1)) == "on"), None)
    if at is None:
        return None
    raw = text.split("\n")
    first, size = lines[at][0], len(OLD_CI_ON)
    block, after = lines[at:at + size], lines[at + size:at + size + 1]
    if [n for n, _, _ in block] != list(range(first, first + size)) or (after and after[0][1] > 0) \
            or [raw[n].rstrip("\r") for n in range(first, first + size)] != OLD_CI_ON:
        return None
    return "\n".join(raw[:first + 1] + raw[first + 3:])


def refreshed_ci(path):
    """The ci.yml at `path` without the old template's push lines (drop_old_push); None when its `on:` is
    another, or it is not readable UTF-8."""
    try:
        return drop_old_push(path.read_bytes().decode("utf-8"))
    except (OSError, UnicodeDecodeError):
        return None


def refuse_a_deploy_on_ci(root, stack, ci, force):
    """A Problem, before anything is written, when this run leaves ci.yml without a push trigger (creates it
    from the template, drops the old template's push lines, or replaces it with --force) while the deploy.yml
    it leaves in place (the project's own, else the template's) runs on workflow_run of CI, which would then
    never run on the push to main, so the deploy would never run again."""
    if not ci:
        return
    path = root / CI_YML
    if not path.exists():
        change = "is created from the template"
    elif force:
        change = "is replaced by the template"
    elif refreshed_ci(path) is not None:
        change = "drops its push trigger"
    else:
        return                                                 # ci.yml is kept as it is
    deploy = root / DEPLOY_YML
    try:
        text = deploy.read_bytes().decode("utf-8") if deploy.exists() and not force else \
            read_template("deploy.yml", stack)
    except (OSError, UnicodeDecodeError):
        return
    if waits_for_ci(text):
        raise Problem(f"{DEPLOY_YML} runs on workflow_run of CI, but CI runs on pull requests and by hand only "
                      f"once {CI_YML} {change}, so that deploy would never run again; trigger it on the push "
                      "to main (as the template's deploy.yml does) or pass --no-ci, then run init again; "
                      "nothing was written")


def target(root, dest, content, force):
    """(status, content to write) of one scaffold file at `root`: create when it is missing; with --force,
    update to the template unless it is the same; else keep, except a ci.yml whose `on:` is the old
    template's, updated to `root`'s own copy minus the two push lines (refreshed_ci)."""
    path = root / dest
    if not path.exists():
        return "create", content
    if content is not None and force:
        try:
            same = path.read_text(encoding="utf-8") == content
        except (OSError, UnicodeDecodeError):
            same = False
        return ("keep" if same else "update"), content
    refreshed = refreshed_ci(path) if dest == CI_YML else None
    return ("keep", None) if refreshed is None else ("update", refreshed)


def status_of(root, dest, content, force):
    return target(root, dest, content, force)[0]


def refreshing(dest, status, force):
    """Whether this status is ci.yml losing the old template's push lines (not --force's template)."""
    return dest == CI_YML and status == "update" and not force


PAST = {"create": "created", "keep": "kept", "update": "updated"}


def report(dest, status, force, dry):
    """`created|kept|updated <path>` (`would ...` when dry), plus a line for the push trigger a ci.yml loses."""
    say(f"would {status} {dest}" if dry else f"{PAST[status]} {dest}")
    if refreshing(dest, status, force):
        say(f"{'would drop' if dry else 'dropped'} the push trigger from {dest} (the old template's `on:`): "
            "CI runs on pull requests and by hand only")


def write_files(root, files, force, dry):
    """Write each file per its status, printing `created|kept|updated <path>` (`would ...` when dry).
    The paths written, or that would be."""
    written = []
    for dest, content, mode in files:
        status, content = target(root, dest, content, force)
        report(dest, status, force, dry)
        if status == "keep":
            continue
        written.append(dest)
        if dry:
            continue
        path = root / dest
        if refreshing(dest, status, force):                    # the project's own file: its mode stays
            path.write_bytes(content.encode("utf-8"))
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        os.chmod(path, mode)
    return written


def preview(root, files, force):
    return [(dest, status_of(root, dest, content, force)) for dest, content, _ in files]


def bash_rule(rule):
    """(words, prefix) of a Bash permission rule, None for any other rule. `prefix` is true when the rule
    ends in `:*` (or ` *`) and so covers every command that starts with those words; bare `Bash` and
    `Bash(*)` are the empty prefix. A rule without it matches that one command. A `*` word elsewhere
    stays in `words`: it matches one or more words."""
    if rule == "Bash":
        return [], True
    m = re.fullmatch(r"Bash\((.*)\)", rule, re.S)
    if not m:
        return None
    inner = m.group(1).strip()
    prefix = inner.endswith((":*", " *"))
    if prefix:
        inner = inner[:-2].strip()
    return ([] if inner == "*" else inner.split()), prefix or inner == "*"


def match_kinds(pattern, prefix, command):
    """How a rule's words can match a command: {"covers"} when it can match the command itself (or any
    start of it, for a prefix rule), {"overlaps"} when it can match only longer commands that start with
    the command. A `*` word matches one or more words."""
    if not command:
        return {"covers"} if not pattern else {"overlaps"}
    if not pattern:
        return {"covers"} if prefix else set()
    if pattern[0] == "*":
        return set().union(*(match_kinds(pattern[1:], prefix, command[k:]) for k in range(1, len(command) + 1)))
    return match_kinds(pattern[1:], prefix, command[1:]) if pattern[0] == command[0] else set()


def stops_run(rule, loop, verify):
    """(firm, command text) when an ask or deny rule stops a dispatched run for sure: a prefix rule that
    covers a loop command, or any rule that matches a verify command, which runs verbatim. (False, text)
    when it only may: it is narrower than a command, a `*` word could make it match one, or it is exactly
    a loop command, which a run never issues bare. None when it leaves them all alone. Any harness-*
    command counts."""
    parsed = bash_rule(rule)
    if parsed is None:
        return None
    words, prefix = parsed
    if words[:1] and words[0].startswith("harness-"):
        return prefix and len(words) == 1, "harness-*"
    found = None
    for cmds, verbatim in ((verify, True), (loop, False)):
        for cmd in cmds:
            kinds = match_kinds(words, prefix, cmd) if cmd else set()
            if "covers" in kinds and (verbatim or prefix):
                return True, " ".join(cmd)
            if kinds and found is None:
                found = (False, " ".join(cmd))
    return found


def covers(allow_rule, entry):
    """Whether an allow rule covers a template entry, by match_kinds as an ask or deny is matched (a `*`
    word matches one or more words): a prefix rule that matches the entry's words or a start of them, or
    a rule without a prefix that matches an entry without one exactly."""
    a, e = bash_rule(allow_rule), bash_rule(entry)
    if a is None or e is None or (not a[1] and e[1]):
        return False
    return "covers" in match_kinds(a[0], a[1], e[0])


def read_kept_settings(path):
    """[ask, deny, allow, env] of a kept settings.json, env the dict as it is; ValueError says why it is
    not usable."""
    try:
        text = path.read_bytes().decode("utf-8")
    except UnicodeDecodeError:
        raise ValueError("it is not UTF-8")
    except OSError as err:
        raise ValueError(f"it cannot be read: {err.strerror or err}")
    try:
        data = json.loads(text)
    except (ValueError, RecursionError):
        raise ValueError("it is not JSON")
    if not isinstance(data, dict):
        raise ValueError("the top level is not an object")
    perms = data.get("permissions", {})
    env = data.get("env", {})
    if not isinstance(perms, dict) or not isinstance(env, dict):
        raise ValueError("permissions and env must be objects")
    lists = []
    for key in ("ask", "deny", "allow"):
        rules = perms.get(key, [])
        if not isinstance(rules, list) or not all(isinstance(r, str) for r in rules):
            raise ValueError(f"permissions.{key} is not a list of strings")
        lists.append(rules)
    return lists + [env]


def kept_settings_report(root, files):
    """The `warn:` lines for a kept .claude/settings.json (never edited): ask and deny rules that stop a
    dispatched run on a loop command or the verify command (the file's own CLAUDE_VERIFY_CMD, which is
    what a run issues, else the rendered one), template allow entries that no allow rule covers (one line
    for the old Bash(harness-*:*) spelling in place of the harness-<tool> entries), and template env keys
    it lacks, each with the value to add. One line when the file is not usable settings."""
    template = json.loads(dict((d, c) for d, c, _ in files)[KEPT])
    allow_wanted = template["permissions"]["allow"]
    env_wanted = template["env"]
    try:
        ask, deny, allow, env = read_kept_settings(root / KEPT)
    except ValueError as err:
        return [f"warn: {KEPT} is not usable settings ({err}), so it was not checked; fix it, or --force "
                "replaces it with the template"]
    own = env.get("CLAUDE_VERIFY_CMD")
    if not (isinstance(own, str) and own.strip()):
        own = env_wanted.get("CLAUDE_VERIFY_CMD", "")
    verify = shell_commands(own)
    lines = []
    for kind, rules, why in (("ask", ask, "a headless run cannot answer an ask"),
                             ("deny", deny, "a deny cannot be overridden")):
        for r in dict.fromkeys(rules):
            hit = stops_run(r, LOOP_COMMANDS, verify)
            if hit and hit[0]:
                fix = "move it to allow" if kind == "ask" else "remove it or narrow it"
                lines.append(f"warn: {KEPT} {kind} rule {r} stops a dispatched run ({why}); {fix}")
            elif hit:
                fix = "move it to allow" if kind == "ask" else "narrow it if it does"
                lines.append(f"warn: {KEPT} {kind} rule {r} may stop a dispatched run: it overlaps the loop "
                             f"command `{hit[1]}` ({why}); {fix}")
    missing = [e for e in allow_wanted if not any(covers(r, e) for r in allow)]
    if OLD_HARNESS_RULE in allow:          # one line for the old spelling, in place of one per harness tool
        tools = [e for e in allow_wanted if HARNESS_TOOL_RULE.fullmatch(e)]
        missing = [e for e in missing if e not in tools]
        lines.append(f"warn: {KEPT} allow rule {OLD_HARNESS_RULE} matches no harness tool (a ':*' rule is a "
                     f"literal prefix); replace it with the nine harness-<tool> rules: {', '.join(tools)}")
    lines += [f"warn: {KEPT} allow entry {e} is missing, so a dispatched run would be stopped by a prompt "
              "no one can answer; add it to permissions.allow" for e in missing]
    lines += [f"warn: {KEPT} env key {k} is not set (the template sets it); add {json.dumps({k: v})[1:-1]} "
              "to env" for k, v in env_wanted.items() if k not in env]
    return lines


# --------------------------------------------------------------- steps
def git_common_dir(root):
    common = Path(git(root, "rev-parse", "--git-common-dir").stdout.strip())
    return common if common.is_absolute() else root / common


def own_hooks(root):
    """The project's active hooks in .git/hooks (anything but the *.sample files git init leaves)."""
    folder = git_common_dir(root) / "hooks"
    try:
        return sorted(p.name for p in folder.iterdir() if p.is_file() and not p.name.endswith(".sample"))
    except OSError:
        return []


def configure_repo(root, force, dry):
    """core.hooksPath .githooks, and .claude/worktrees/ in .git/info/exclude. A project's own hooks
    (another core.hooksPath, or scripts in .git/hooks) are kept unless --force."""
    is_repo = toplevel(root) is not None
    current = git(root, "config", "--get", "core.hooksPath", check=False).stdout.strip() if is_repo else ""
    hooks = own_hooks(root) if is_repo and not current else []
    if current == ".githooks":
        say("kept core.hooksPath .githooks")
    elif current and not force:
        say(f"kept core.hooksPath {current} (the project's own hooks; --force replaces it with .githooks)")
    elif hooks and not force:
        say(f"kept .git/hooks ({', '.join(hooks)}): the project's own hooks; --force sets core.hooksPath .githooks")
    elif dry:
        say("would set core.hooksPath .githooks")
    else:
        git(root, "config", "core.hooksPath", ".githooks")
        say("set core.hooksPath .githooks")

    if not is_repo:                                 # a dry run before git init
        say(f"would add {EXCLUDE_LINE} to .git/info/exclude")
        return
    exclude = git_common_dir(root) / "info" / "exclude"
    try:
        text = exclude.read_text(encoding="utf-8")
    except FileNotFoundError:
        text = None
    if text is not None and any(ln.strip() in (EXCLUDE_LINE, EXCLUDE_LINE.rstrip("/")) for ln in text.splitlines()):
        say("kept .git/info/exclude")
        return
    if dry:
        say(f"would add {EXCLUDE_LINE} to .git/info/exclude")
        return
    exclude.parent.mkdir(parents=True, exist_ok=True)
    prefix = "" if not text or text.endswith("\n") else "\n"
    with open(exclude, "a", encoding="utf-8") as fh:
        fh.write(f"{prefix}{EXCLUDE_LINE}\n")
    say(f"{'created' if text is None else 'updated'} .git/info/exclude")


def lock(root, stack, written, dry):
    """Create the lock file CI's install step needs when this run made the manifest. Its path or None."""
    if stack == "python" and "pyproject.toml" in written:
        cmd, lockfile, ci = ["uv", "lock"], "uv.lock", "uv sync --locked"
    elif stack == "node" and "package.json" in written:
        cmd, lockfile, ci = ["npm", "install", "--package-lock-only", "--no-audit", "--no-fund"], \
            "package-lock.json", "npm ci"
    else:
        return None
    if (root / lockfile).exists():
        return None
    if dry:
        say(f"would run: {quoted(cmd)}")
        return None
    hint = f"CI's `{ci}` needs it: run `{quoted(cmd)}` and commit {lockfile}"
    if not shutil.which(cmd[0]):
        say(f"note: {cmd[0]} is not on PATH, so there is no {lockfile}; {hint}")
        return None
    try:
        p = run(cmd, cwd=root, check=False, timeout=600)
        why = None if p.returncode == 0 and (root / lockfile).exists() else \
            last_line_collapsed(p.stderr) or last_line_collapsed(p.stdout) or f"exit {p.returncode}"
    except Problem as err:                          # a timeout: the scaffold goes on without the lock
        why = str(err)
    if why:
        say(f"note: `{quoted(cmd)}` failed ({why}); {hint}")
        return None
    say(f"created {lockfile}")
    return lockfile


def first_commit(root, name, dry):
    subject = f"Scaffold {name} with the harness"
    if dry:
        say(f"would commit everything on main: {subject}")
        return
    if git(root, "symbolic-ref", "--short", "HEAD", check=False).stdout.strip() != "main":
        git(root, "symbolic-ref", "HEAD", "refs/heads/main")
    git(root, "add", "-A")
    git(root, "commit", "-q", "-m", subject)
    sha = git(root, "rev-parse", "--short", "HEAD").stdout.strip()
    say(f"committed {sha} on main: {subject}")


def github(root, name, create, push, dry):
    """The private repository (`create`), main pushed to it (`push`), the labels,
    delete-branch-on-merge and the ruleset."""
    gh = gh_cmd()
    if create:
        cmd = [gh, "repo", "create", name, "--private", "--source", ".", "--remote", "origin"]
        if dry:
            say(f"would run: {quoted(cmd)}")
        else:
            out = run(cmd, cwd=root).stdout.strip()
            say(f"created GitHub repository {out or name}")
            if not has_origin(root):
                raise Problem("gh repo create left no origin remote; add it and push main by hand")
    if push:
        if dry:
            say("would run: git push -u origin main")
        else:
            # the first push of main itself; the pre-push hook refuses main otherwise
            run(["git", "-C", str(root), "push", "-u", "origin", "main"], timeout=600,
                env=dict(os.environ, HARNESS_ALLOW_MAIN="1"))
            say("pushed main to origin")
    if dry:
        say("would run: harness-board labels ensure")
        say(f"would run: {quoted([gh, 'repo', 'edit', 'O/R', '--delete-branch-on-merge'])}")
        say(f"would run: {quoted([gh, 'api', '-X', 'POST', 'repos/O/R/rulesets', '--input', '-'])}")
        return
    out = call("harness-board", "labels", "ensure", cwd=root, project=root).strip()
    say(out or "labels ensured")
    repo = run([gh, "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"], cwd=root).stdout.strip()
    if not re.match(r"^[\w.-]+/[\w.-]+$", repo):
        raise Problem(f"gh repo view gave no OWNER/REPO (got {repo!r})")
    run([gh, "repo", "edit", repo, "--delete-branch-on-merge"], cwd=root)
    say(f"set delete-branch-on-merge on {repo}")
    p = run([gh, "api", "-X", "POST", f"repos/{repo}/rulesets", "--input", "-"], cwd=root, check=False,
            input=json.dumps(RULESET))
    if p.returncode == 0:
        say(f"created ruleset main on {repo}")
    elif "403" in p.stderr or "Upgrade to GitHub Pro" in p.stderr:
        say(NO_RULESET)
    else:
        say(f"warning: ruleset not created on {repo}: {last_line_collapsed(p.stderr) or last_line_collapsed(p.stdout)}")


def adopt_body(name, stack, values, statuses, force):
    added = [d for d, s in statuses if s == "create"]
    refreshed = [d for d, s in statuses if refreshing(d, s, force)]
    replaced = [d for d, s in statuses if s == "update" and d not in refreshed]
    lines = ["## Request",
             f"Add the harness scaffold to {name} (`harness-scaffold init`, stack {stack}): the files it "
             "lacks, written on this ticket's branch. Files the project already has are kept.", "",
             "## Outline",
             "1. `harness-scaffold init` writes the missing files in this ticket's worktree.",
             "2. Commit, open the pull request, mark it ready for review.", "",
             "## Definition of done"]
    lines += [f"- [ ] `{d}` is added" for d in added]
    lines += [f"- [ ] `{d}` is replaced by the template" for d in replaced]
    lines += [f"- [ ] `{d}` loses the two `push` lines under `on:`, so CI runs on pull requests and by hand "
              "only; no other line changes" for d in refreshed]
    lines += ["- [ ] No other file changes", "",
              "## Tests that must pass",
              f"None: configuration and templates only (`no-tests`). The existing suite (`{values['verify_cmd']}`) "
              "stays green.", "",
              "## Context",
              "- `core.hooksPath` is set to `.githooks`, so the pre-commit hook starts working when this lands.",
              "- Must not change: the project's existing files"
              + (", except the ones listed as replaced" if replaced else "")
              + (f"{' and' if replaced else ', except'} the push lines of `{CI_YML}`" if refreshed else "") + ".", ""]
    return "\n".join(lines)


def ticket_number(out):
    try:
        data = json.loads(out)
        if isinstance(data, dict) and str(data.get("number", "")).isdigit():
            return int(data["number"])
    except ValueError:
        pass
    m = re.search(r"#(\d+)", out) or re.search(r"/issues/(\d+)", out)
    if not m:
        raise Problem(f"harness-board task create printed no issue number: {last_line_collapsed(out)!r}")
    return int(m.group(1))


def json_out(name, out):
    try:
        data = json.loads(out)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        raise Problem(f"{name} printed no JSON object: {last_line_collapsed(out)!r}")
    return data


def adopt(root, name, stack, values, files, statuses, force, dry):
    """The scaffold as a chore ticket: issue, worktree, commit there, pull request, ready."""
    create = ["harness-board", "task", "create", "--title", ADOPT_TITLE, "--type", "chore", "--no-tests",
              "--size", "S", "--risk", "low", "--body-file"]
    if dry:
        say(f"would run: {quoted(create + ['<body>'])}")
        say("would run: harness-work start <N> --json")
        say("would write the files above in that worktree and commit them: Adopt the harness scaffold (#<N>)")
        say("would run: harness-pr open <N> --json")
        say("would run: harness-pr ready <P>")
        return
    fd, body = tempfile.mkstemp(prefix="harness-scaffold-", suffix=".md")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(adopt_body(name, stack, values, statuses, force))
        out = call(*create, body, cwd=root, project=root)
    finally:
        os.unlink(body)
    n = ticket_number(out)
    say(f"created ticket #{n}: {ADOPT_TITLE}")
    started = json_out("harness-work start", call("harness-work", "start", str(n), "--json", cwd=root, project=root))
    if not started.get("worktree"):
        raise Problem(f"harness-work start {n} gave no worktree")
    wt = Path(started["worktree"]).resolve()
    say(f"started #{n} on {started.get('branch') or '?'} in {wt}")
    written = write_files(wt, files, force, False)
    lockfile = lock(wt, stack, written, False)
    paths = written + ([lockfile] if lockfile else [])
    if not paths:
        raise Problem(f"nothing to commit in {wt}; ticket #{n} is open without a pull request")
    git(wt, "add", "--", *paths)
    subject = f"{ADOPT_TITLE} (#{n})"
    git(wt, "commit", "-q", "-m", subject)
    say(f"committed {git(wt, 'rev-parse', '--short', 'HEAD').stdout.strip()} on {started.get('branch') or '?'}: "
        f"{subject}")
    pr = json_out("harness-pr open", call("harness-pr", "open", str(n), "--json", cwd=wt, project=root))
    if not str(pr.get("number", "")).isdigit():
        raise Problem(f"harness-pr open {n} gave no PR number")
    say(f"opened PR #{pr['number']} {pr.get('url', '')}".rstrip())
    call("harness-pr", "ready", str(pr["number"]), cwd=wt, project=root)
    say(f"PR #{pr['number']} is ready for review")


def register(root, name, billable, client, dry):
    args = ["add", str(root), "--name", name] + (["--billable"] if billable else []) + \
        (["--client", client] if client else [])
    if dry:
        say(f"would run: harness-projects {quoted(args)}")
        return
    p = run([sibling("harness-projects")] + args, check=False, timeout=60)
    if p.returncode == 0:
        say(f"registered {name} in the project registry")
    elif "already registered" in p.stderr:
        say(f"kept registry entry for {root}")
    else:
        raise Problem(f"harness-projects add failed: {last_line_collapsed(p.stderr) or last_line_collapsed(p.stdout)}")


# --------------------------------------------------------------- commands
def cmd_init(args):
    name = args.name.strip()
    if not NAME_RE.match(name):
        raise Problem(f"--name {name!r}: use letters, digits, '.', '_' or '-', starting and ending with a "
                      "letter or digit (it names the GitHub repository and the package)")
    if args.verify is not None and not args.verify.strip():
        raise Problem("--verify needs a command (a blank one would leave scripts/verify.sh checking nothing)")
    if (args.billable or args.client) and not args.register:
        raise Problem("--billable and --client go with --register")
    root = Path(os.path.abspath(os.path.expanduser(args.path or "."))).resolve()
    dry = args.dry_run
    if root.exists() and not root.is_dir():
        raise Problem(f"not a directory: {root}")
    stack = args.stack or (detect_stack(root) if root.is_dir() else "none")

    top = toplevel(root)
    if top is not None and top != root:
        raise Problem(f"{root} is inside the repository {top}; scaffold its toplevel or a folder outside it")
    refuse_a_deploy_on_ci(root, stack, not args.no_ci, args.force)
    if not root.exists():
        if dry:
            say(f"would create {root}")
        else:
            root.mkdir(parents=True)
    if top is None:
        if dry:
            say("would run: git init -b main")
        else:
            git(root, "init", "-q", "-b", "main")
            say(f"initialized {root} (git init -b main)")
    committed = top is not None and has_commits(root)
    layout = own_layout(root) if SKELETON[stack] and root.is_dir() else []

    values = {
        "name": name,
        "pkg": package_name(name, stack),
        "stack": stack,
        "verify_cmd": args.verify if args.verify is not None else "scripts/verify.sh",
        "test_cmd": args.test_cmd if args.test_cmd is not None else default_test_cmd(root, stack, layout),
        "tests_dirs": ", ".join(f"`{d}/`" for d in tests_dirs(root, stack, args.verify, layout)),
        "python_version": PYTHON_VERSION,
        "year": str(dt.date.today().year),
    }
    files = plan(root, stack, values, ci=not args.no_ci, verify=args.verify, layout=layout)
    if layout:
        say(f"kept the project's own layout ({', '.join(layout)}): no {stack} skeleton")
    if (root / KEPT).exists() and not args.force:      # --force replaces it with the template
        for line in kept_settings_report(root, files):
            say(line)

    if not committed:
        written = write_files(root, files, args.force, dry)
        lock(root, stack, written, dry)
        first_commit(root, name, dry)
        configure_repo(root, args.force, dry)          # after the commit: the scaffold lands as it is
        if args.github:
            github(root, name, create=not has_origin(root), push=True, dry=dry)
    else:
        statuses = preview(root, files, args.force)
        origin = has_origin(root)
        if all(s == "keep" for _, s in statuses):
            for dest, _ in statuses:
                say(f"{'would keep' if dry else 'kept'} {dest}")
            configure_repo(root, args.force, dry)
            if args.github:
                github(root, name, create=not origin, push=not origin, dry=dry)
            say("nothing to adopt: every scaffold file is already here")
        else:
            if not origin and not args.github:
                raise Problem(f"{root} has commits but no origin remote; adopting the scaffold goes through a "
                              "ticket and a pull request, so pass --github to create the repository first")
            configure_repo(root, args.force, dry)
            if args.github:
                github(root, name, create=not origin, push=not origin, dry=dry)
            if dry:
                for dest, status in statuses:
                    report(dest, status, args.force, True)
            adopt(root, name, stack, values, files, statuses, args.force, dry)
    if args.register:
        register(root, name, args.billable, args.client, dry)


def cmd_labels(args):
    root = Path(os.path.abspath(os.path.expanduser(args.path or "."))).resolve()
    top = toplevel(root)
    if top is None:
        raise Problem(f"not a git repository: {root}")
    out = call("harness-board", "labels", "ensure", cwd=top, project=top).strip()
    say(out or "labels ensured")


def parser():
    ap = Parser(prog="harness-scaffold", description="Set a project up for the harness.")
    sub = ap.add_subparsers(dest="cmd", metavar="{init,labels}")
    init = sub.add_parser("init", help="write the scaffold, then commit it or adopt it through a ticket")
    init.add_argument("path", nargs="?", help="the project folder (default: the current one)")
    init.add_argument("--name", required=True, help="the project and GitHub repository name")
    init.add_argument("--stack", choices=STACKS, help="default: detected (pyproject.toml or *.py, package.json)")
    init.add_argument("--verify", metavar="CMD", help="the verify command, written into scripts/verify.sh (default: the stack's checks)")
    init.add_argument("--test-cmd", metavar="CMD", help="HARNESS_TEST_CMD, with {files} (default: per stack)")
    init.add_argument("--github", action="store_true", help="create the private GitHub repository and push main")
    init.add_argument("--register", action="store_true", help="add the project to the harness-projects registry")
    init.add_argument("--billable", action="store_true", help="with --register: hours count toward an invoice")
    init.add_argument("--client", help="with --register: who is billed")
    init.add_argument("--no-ci", action="store_true",
                      help="skip the CI and deploy workflows, scripts/smoke.sh and scripts/deploy_guard.py")
    init.add_argument("--force", action="store_true", help="overwrite existing files with the templates")
    init.add_argument("--dry-run", action="store_true", help="print the plan, write nothing")
    labels = sub.add_parser("labels", help="harness-board labels ensure for an existing repository")
    labels.add_argument("path", nargs="?", help="the project folder (default: the current one)")
    return ap


def main():
    ap = parser()
    args = ap.parse_args()
    if not args.cmd:
        ap.error("give a subcommand: init or labels")
    try:
        {"init": cmd_init, "labels": cmd_labels}[args.cmd](args)
    except Problem as err:
        sys.exit(f"harness-scaffold: {err}")


if __name__ == "__main__":
    run_main("harness-scaffold", main)
