#!/usr/bin/env python3
"""
The red proof: a ticket's new tests fail before the implementation exists, and the source is untouched.

Runs in a ticket worktree (the cwd, or --worktree PATH). The record is written to
~/.claude/harness/repos/<repo-key>/red/<branch-slug>.json, where tests_first.py looks for it:
{"branch", "base_sha", "test_files", "run_files", "test_hash", "cmd", "exit", "kind", "tail", "at"}.
`test_files` (hashed into `test_hash`) is every changed file matching HARNESS_TEST_PATTERNS, fixtures and
conftest.py included; `run_files`, the ones the command runs, are those whose basename names a test module.
The files' bytes go to the side file red-files/<branch-slug>.json beside red/, so the record stays current
across a merge of main that only brings in main's edits to those files (harness_lib/redproof.py); a test
change of the branch's own makes it stale.

Usage:
    harness-red check [--base origin/main]   # run the branch's changed tests; red exits 0, anything else 1
                                             # (no tests ran, or they failed to load: refused, nothing recorded)
    harness-red status                       # the record for this branch, and current: yes|no
    harness-red scratch create               # a detached worktree of HEAD for the test-breaker; prints its path
    harness-red scratch run                  # the record's tests in the scratch: cheat passed (0) or cheat failed (1)
    harness-red scratch remove
    check and status take --json; every subcommand takes --worktree PATH.

Settings: HARNESS_TEST_PATTERNS and HARNESS_SOURCE_EXEMPT (comma-separated globs) come from the
environment, then `env` in the main checkout's tracked .claude/settings.json only, as in tests_first;
the others come from the environment, then `env` in the worktree's .claude/settings.json, with
.claude/settings.local.json over it: HARNESS_TEST_CMD ({files} becomes the test files, shell-quoted; detected when unset) and
HARNESS_TEST_TIMEOUT (seconds, default 300).
"""
from __future__ import annotations

import argparse
import datetime as dt
import fnmatch
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys

_LIB = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)
try:
    from harness_lib.paths import adopt_old_state, canonical_path, repo_key
    from harness_lib.redproof import read_files, record_current, save_red_files, tests_hash
    from harness_lib.repo import NotARepository, RepoError, repo_facts
    from harness_lib.settings import glob_match, patterns, setting, settings_env  # also read by tests/test_red.py
    from harness_lib.settings import DEFAULT_TEST_PATTERNS as TEST_PATTERNS  # also read by tests/test_red.py
    from harness_lib.settings import DEFAULT_SOURCE_EXEMPT as SOURCE_EXEMPT  # also read by tests/test_red.py
    from harness_lib.cli import Parser, Problem, run_main  # Problem also caught by tests/test_red.py
    from harness_lib.text import last_line, write_json
except Exception as exc:  # one line, exit 1, like the __main__ wrapper below
    sys.exit(f"harness-red: cannot load harness_lib from {_LIB}: {' '.join(str(exc).split())}")

DEFAULT_TIMEOUT = 300.0
TAIL_LINES = 40
CANNOT_START = (126, 127)          # the shell's "not executable" and "command not found"
IMPORT_RE = re.compile(r"ModuleNotFoundError|ImportError|No module named|Cannot find module|ERR_MODULE_NOT_FOUND")
ASSERTION_RE = re.compile(r"AssertionError|assert |FAILED|failed|✗|not ok")
# A run that proves nothing: no record. Exit 5 is pytest's and (3.12+) unittest's "no tests ran".
NO_TESTS_EXIT = 5
NO_TESTS_RE = re.compile(r"no tests ran|NO TESTS RAN")
COLLECTED_NONE_RE = re.compile(r"collected 0 items")
BAD_SYNTAX_RE = re.compile(r"^[ \t]*(?:E[ \t]+)?(?:SyntaxError|IndentationError|TabError)\b", re.M)  # its own line
LOAD_ERROR_RE = re.compile(r"error during collection|ERROR collecting")
MISSING_RE = re.compile(r"ModuleNotFoundError|ImportError: cannot import name|No module named|Cannot find module|"
                        r"ERR_MODULE_NOT_FOUND")    # the code under test does not exist yet: the usual first red
NO_TESTS, NOT_LOADED = "no tests ran", "tests failed to load"
GREEN = "Tests pass before the implementation; they do not test this change."
RUNNABLE = ("test_*.py", "*_test.py", "*.test.js", "*_test.js", "*.test.ts", "*_test.ts", "*.test.mjs",
            "*.spec.js", "*.spec.ts")      # basenames passed as {files}; other test files are hashed, not run


# --------------------------------------------------------------- globs and settings
def globs(name, file_env, default):
    raw = setting(name, file_env)
    return patterns(default if raw is None else raw)


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def detect_test_cmd(root, files):
    """The default HARNESS_TEST_CMD for these test files in this project, or None."""
    names = [f.rsplit("/", 1)[-1] for f in files]
    if any(n.endswith(".py") for n in names):
        if os.path.isfile(os.path.join(root, "uv.lock")):
            return "uv run pytest -q {files}"
        if any("pytest" in read_text(os.path.join(root, cfg)) for cfg in ("pyproject.toml", "pytest.ini")):
            return "python3 -m pytest -q {files}"
    if any(fnmatch.fnmatch(n, "test_*.py") or fnmatch.fnmatch(n, "*_test.py") for n in names):
        return "python3 -m unittest {files}"
    try:
        with open(os.path.join(root, "package.json"), encoding="utf-8") as fh:
            scripts = json.load(fh).get("scripts")
        if isinstance(scripts, dict) and scripts.get("test"):
            return "npm test -- {files}"
    except (OSError, ValueError, AttributeError):
        pass
    if any(n.endswith(".test.js") for n in names):
        return "node --test {files}"
    return None


def test_timeout(file_env):
    raw = setting("HARNESS_TEST_TIMEOUT", file_env)
    try:
        value = float(raw) if raw is not None else DEFAULT_TIMEOUT
    except ValueError:
        value = DEFAULT_TIMEOUT
    return value if value > 0 else DEFAULT_TIMEOUT       # also catches nan


# --------------------------------------------------------------- git and the repository
def git(root, *args, check=True):
    try:
        p = subprocess.run(["git", "-C", root, *args], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           encoding="utf-8", errors="surrogateescape", timeout=60)
    except FileNotFoundError:
        raise Problem("git is not on PATH")
    except subprocess.TimeoutExpired:
        raise Problem(f"git {args[0]} timed out")
    if check and p.returncode != 0:
        said = [ln.strip() for ln in p.stderr.splitlines() if ln.strip()]
        raise Problem(f"git {' '.join(args)} failed: {said[-1] if said else f'exit {p.returncode}'}")
    return p


def facts_git(root, *args):
    """git for repo_facts: the toplevel probe may fail (Repo says `not inside a git working tree`); any other
    failure is raised with git's own last line."""
    return git(root, *args, check="--show-toplevel" not in args)


class Repo:
    """The worktree harness-red runs in: its top level, branch, settings and the per-repository state paths."""

    def __init__(self, start):
        # The main working tree is the parent of the common git dir, so a linked worktree and its main
        # checkout share one state directory.
        try:
            self.top, _common_dir, self.main, self.key = repo_facts(start, facts_git, last_line)
        except NotARepository as exc:
            raise Problem(f"not inside a git working tree: {exc.path}") from None
        except RepoError as exc:
            raise Problem(str(exc)) from None
        repos = os.path.join(os.path.expanduser("~"), ".claude", "harness", "repos")
        branch = git(self.top, "symbolic-ref", "--quiet", "--short", "HEAD", check=False).stdout.strip()
        if not branch:
            raise Problem(f"HEAD is detached in {self.top}; harness-red runs on a ticket branch")
        self.branch = branch
        self.slug = branch.replace("/", "-")
        state = os.path.join(repos, self.key)
        self.record_path = os.path.join(state, "red", self.slug + ".json")
        self.scratch = os.path.join(state, "scratch", self.slug)
        self.env = settings_env(self.top)
        # What counts as a test is decided by the main checkout's tracked settings.json only, as in
        # tests_first: the worktree's files and settings.local.json are agent-editable.
        classify_env = settings_env(self.main, ("settings.json",))
        self.test_globs = globs("HARNESS_TEST_PATTERNS", classify_env, TEST_PATTERNS)
        self.exempt_globs = globs("HARNESS_SOURCE_EXEMPT", classify_env, SOURCE_EXEMPT)

    def classify(self, path):
        """'test', 'exempt' or 'source'."""
        if any(glob_match(g, path) for g in self.test_globs):
            return "test"
        if any(glob_match(g, path) for g in self.exempt_globs):
            return "exempt"
        return "source"

    def test_command(self, files):
        cmd = setting("HARNESS_TEST_CMD", self.env) or detect_test_cmd(self.top, files)
        if not cmd:
            raise Problem("no test command for these files: set HARNESS_TEST_CMD under env in "
                          ".claude/settings.json ({files} becomes the test files)")
        return cmd.replace("{files}", " ".join(shlex.quote(f) for f in files))

    def resolve_base(self, base):
        """The commit `base` names; without one, origin/main when it exists, else main."""
        for ref in [base] if base else ["origin/main", "main"]:
            p = git(self.top, "rev-parse", "--verify", "--quiet", ref + "^{commit}", check=False)
            if p.returncode == 0 and p.stdout.strip():
                return ref
        if base:
            raise Problem(f"unknown base {base!r}")
        raise Problem("neither origin/main nor main exists here; pass --base REF")

    def changed_paths(self, merge_base):
        """Paths that differ from the merge base, committed or not, plus what git status lists."""
        diff = git(self.top, "diff", "--name-only", "--no-renames", "-z", merge_base).stdout
        paths = {p for p in diff.split("\0") if p}
        status = git(self.top, "status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames").stdout
        for entry in status.split("\0"):
            if len(entry) > 3:
                paths.add(entry[3:].rstrip("/"))
        return sorted(paths)


def runnable(files):
    """The test files the command runs: a test module's basename, not a fixture, helper or conftest.py.
    None runnable is a failed precondition."""
    run = [f for f in files if any(fnmatch.fnmatch(f.rsplit("/", 1)[-1], p) for p in RUNNABLE)]
    if not run:
        raise Problem(f"No runnable test files among the test changes: {', '.join(files)}. "
                      f"A runnable test file is named {', '.join(RUNNABLE)}.")
    return run


def current(repo, record):
    """The files hash to test_hash, or are the red-time files with main's merged changes (redproof.py)."""
    return record_current(repo.top, record, repo.record_path)


# --------------------------------------------------------------- records
def load_record(repo):
    try:
        with open(repo.record_path, encoding="utf-8") as fh:
            record = json.load(fh)
    except FileNotFoundError:
        raise Problem(f"No red run recorded for {repo.branch}; run harness-red check.")
    except ValueError as err:
        raise Problem(f"{repo.record_path} is not valid JSON ({err}); run harness-red check again")
    files = record.get("test_files") if isinstance(record, dict) else None
    if not isinstance(files, list) or not files or not all(isinstance(f, str) and f for f in files):
        raise Problem(f"{repo.record_path} has no test_files; run harness-red check again")
    return record


# --------------------------------------------------------------- running tests
def kill_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        try:
            proc.kill()
        except OSError:
            pass


def run_command(cmd, cwd, timeout):
    """(exit status, combined output) of `cmd` through the shell. Raises TimeoutExpired or OSError."""
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    # A session of its own, so a timeout or an interrupt can stop the shell and everything it started.
    proc = subprocess.Popen(cmd, shell=True, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, env=env, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_group(proc)
        try:
            proc.communicate(timeout=5)
        except (subprocess.SubprocessError, OSError, ValueError):
            pass
        raise
    except BaseException:
        kill_group(proc)
        raise
    return proc.returncode, out.decode("utf-8", "replace")


def tail(text, n=TAIL_LINES):
    lines = [ln.rstrip() for ln in text.splitlines() if ln.strip()]
    return "\n".join(lines[-n:])


def unproven(code, output):
    """Why a failing run proves nothing, or None. A missing module still counts as red, even when pytest reports
    it as a collection error; a syntax error in a test file does not."""
    if code == 0:
        return None
    if code == NO_TESTS_EXIT or NO_TESTS_RE.search(output):
        return NO_TESTS
    if BAD_SYNTAX_RE.search(output):
        return NOT_LOADED
    if MISSING_RE.search(output):
        return None
    if LOAD_ERROR_RE.search(output):
        return NOT_LOADED
    if COLLECTED_NONE_RE.search(output):
        return NO_TESTS
    return None


def kind_of(code, output):
    if code == 0:
        return "green"
    if IMPORT_RE.search(output):
        return "import"
    if ASSERTION_RE.search(output):
        return "assertion"
    return "error"


def run_tests(repo, files, cwd):
    """(cmd, exit, output, timed out) for the test files run in `cwd`; refuses a command that cannot start."""
    cmd = repo.test_command(files)
    timeout = test_timeout(repo.env)
    try:
        code, output = run_command(cmd, cwd, timeout)
    except subprocess.TimeoutExpired:
        return cmd, None, f"timed out after {timeout:g}s and was stopped", timeout
    except OSError as err:
        raise Problem(f"could not start {cmd}: {err.strerror or err}")
    if code in CANNOT_START:
        said = [ln.strip() for ln in output.splitlines() if ln.strip()]
        raise Problem(f"could not start {cmd}: {said[-1] if said else f'exit {code}'}; set HARNESS_TEST_CMD")
    return cmd, code, output, None


# --------------------------------------------------------------- commands
def no_tests_message(repo):
    """`(N, "ticket N is no-tests: no red run needed")` when the ticket cache of this t/<n>- branch carries the
    flag, else None (a missing or corrupt cache, no flags, another branch name: the normal path)."""
    m = re.match(r"t/(\d+)-", repo.branch)
    if not m:
        return None
    path = os.path.join(os.path.dirname(os.path.dirname(repo.record_path)), "tickets", m.group(1) + ".json")
    try:
        with open(path, encoding="utf-8") as fh:
            ticket = json.load(fh)
    except (OSError, ValueError):
        return None
    flags = ticket.get("flags") if isinstance(ticket, dict) else None
    if isinstance(flags, list) and "no-tests" in flags:
        return int(m.group(1)), f"ticket {m.group(1)} is no-tests: no red run needed"
    return None


def print_no_tests(note, as_json):
    number, message = note
    if as_json:
        print(json.dumps({"no_tests": True, "ticket": number, "message": message}, ensure_ascii=False))
    else:
        print(message)


def cmd_check(repo, args):
    note = no_tests_message(repo)
    if note:
        print_no_tests(note, args.json)
        return 0
    base = repo.resolve_base(args.base)
    mb = git(repo.top, "merge-base", "HEAD", base, check=False)
    merge_base = mb.stdout.strip()
    if mb.returncode != 0 or not merge_base:
        raise Problem(f"HEAD and {base} have no common ancestor")
    changed = repo.changed_paths(merge_base)
    tests = [p for p in changed if repo.classify(p) == "test" and os.path.isfile(os.path.join(repo.top, p))]
    if not tests:
        raise Problem("No test changes on this branch; write the tests first.")
    sources = [p for p in changed if repo.classify(p) == "source"]
    if sources:
        raise Problem(f"Source already changed before the red run: {', '.join(sources)}. "
                      "Revert them or move them to the coder step.")
    run_files = runnable(tests)
    contents = read_files(repo.top, tests)         # the bytes the run proves, hashed and kept beside the record
    digest = tests_hash(contents)
    cmd, code, output, timed_out = run_tests(repo, run_files, repo.top)
    if timed_out:
        raise Problem(f"{cmd} timed out after {timed_out:g}s and was stopped; no red run recorded. "
                      "Raise HARNESS_TEST_TIMEOUT or fix the hang.")
    why = unproven(code, output)
    if why:
        if args.json:
            print(json.dumps({"refused": why, "cmd": cmd, "exit": code, "tail": tail(output)}, indent=2,
                             ensure_ascii=False))
        else:
            print(f"{why}: {len(tests)} test files, exit {code}")
            print(tail(output))
        fix = ("make the test files define tests the command collects" if why == NO_TESTS
               else "fix the error its output shows")
        raise Problem(f"no red run recorded: {why} (exit {code}); {fix}, then run harness-red check again.")
    kind = kind_of(code, output)
    record = {"branch": repo.branch, "base_sha": merge_base, "test_files": tests, "run_files": run_files,
              "test_hash": digest, "cmd": cmd, "exit": code, "kind": kind, "tail": tail(output),
              "at": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
    save_red_files(repo.record_path, contents)       # first: a record never names files the side file lacks
    write_json(repo.record_path, record, prefix=".red-")
    if args.json:
        print(json.dumps(record, indent=2, ensure_ascii=False))
    elif kind == "green":
        print(f"green: {len(tests)} test files, exit {code}")
        print(record["tail"])
    else:
        print(f"red ({kind}): {len(tests)} test files, exit {code}")
        print(record["tail"])
    if kind == "green":
        raise Problem(GREEN)
    return 0


def cmd_status(repo, args):
    note = no_tests_message(repo)
    if note:
        print_no_tests(note, args.json)
        return 0
    record = load_record(repo)
    fresh = current(repo, record)
    if args.json:
        print(json.dumps(dict(record, current=fresh), indent=2, ensure_ascii=False))
        return 0
    print(f"branch: {record.get('branch', repo.branch)}")
    print(f"kind: {record.get('kind')} (exit {record.get('exit')})")
    print(f"at: {record.get('at')}")
    print(f"base: {record.get('base_sha')}")
    print(f"cmd: {record.get('cmd')}")
    print(f"test files: {', '.join(record['test_files'])}")
    print(f"run files: {', '.join(record.get('run_files') or [])}")
    print(f"current: {'yes' if fresh else 'no'}")
    return 0


def cmd_scratch_create(repo, args):
    record = load_record(repo)
    path = repo.scratch
    if os.path.exists(path):
        raise Problem(f"a scratch copy already exists at {path}; harness-red scratch remove first")
    git(repo.top, "worktree", "prune", check=False)          # forget a scratch deleted by hand
    os.makedirs(os.path.dirname(path), exist_ok=True)
    git(repo.top, "worktree", "add", "--detach", path, "HEAD")
    for f in record["test_files"]:                          # the tests that are not committed yet
        src, dst = os.path.join(repo.top, f), os.path.join(path, f)
        if not os.path.isfile(src) or (os.path.isfile(dst) and same_bytes(src, dst)):
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
    print(path)
    return 0


def same_bytes(a, b):
    with open(a, "rb") as fa, open(b, "rb") as fb:
        return fa.read() == fb.read()


def cmd_scratch_run(repo, args):
    record = load_record(repo)
    if not os.path.isdir(repo.scratch):
        raise Problem(f"No scratch copy for {repo.branch}; run harness-red scratch create.")
    cmd, code, output, timed_out = run_tests(repo, runnable(record["test_files"]), repo.scratch)
    if code == 0:
        print("cheat passed")
        print(tail(output))
        return 0
    print("cheat failed" + (f" (the tests timed out after {timed_out:g}s)" if timed_out else ""))
    if not timed_out:
        print(tail(output))
    return 1


def cmd_scratch_remove(repo, args):
    path = repo.scratch
    existed = os.path.exists(path)
    if existed:
        p = git(repo.top, "worktree", "remove", "--force", path, check=False)
        if p.returncode != 0 and os.path.exists(path):
            shutil.rmtree(path)                             # ours, under ~/.claude/harness, and not a worktree now
    git(repo.top, "worktree", "prune", check=False)
    print(f"removed {path}" if existed else f"no scratch copy at {path}")
    return 0


def parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--worktree", metavar="PATH", default=argparse.SUPPRESS,
                        help="the ticket worktree (default: the cwd)")
    as_json = argparse.ArgumentParser(add_help=False)
    as_json.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="print JSON")
    ap = Parser(prog="harness-red", description="Proves a ticket's tests fail before the implementation exists.")
    ap.add_argument("--worktree", metavar="PATH", help="the ticket worktree (default: the cwd)")
    ap.add_argument("--json", action="store_true", help="print JSON (check, status)")
    sub = ap.add_subparsers(dest="cmd", metavar="{check,status,scratch}")
    check = sub.add_parser("check", parents=[common, as_json], help="run the branch's test changes and record red")
    check.add_argument("--base", metavar="REF", help="default: origin/main when it exists, else main")
    sub.add_parser("status", parents=[common, as_json], help="the red record for this branch")
    scratch = sub.add_parser("scratch", parents=[common], help="the test-breaker's working copy")
    ssub = scratch.add_subparsers(dest="scratch_cmd", metavar="{create,run,remove}")
    ssub.add_parser("create", parents=[common], help="a detached worktree of HEAD plus uncommitted tests")
    ssub.add_parser("run", parents=[common], help="the record's tests in the scratch copy")
    ssub.add_parser("remove", parents=[common], help="remove the scratch copy")
    return ap


def main():
    ap = parser()
    args = ap.parse_args()
    if not args.cmd:
        ap.error("choose a subcommand: check, status or scratch")
    if args.cmd == "scratch" and not args.scratch_cmd:
        ap.error("choose scratch create, run or remove")
    for sig in (signal.SIGTERM, signal.SIGHUP):             # unwind, so a running test command is killed too
        signal.signal(sig, lambda signum, frame: sys.exit(128 + signum))
    commands = {"check": cmd_check, "status": cmd_status, "create": cmd_scratch_create, "run": cmd_scratch_run,
                "remove": cmd_scratch_remove}
    try:
        repo = Repo(args.worktree or os.getcwd())
        code = commands[args.scratch_cmd if args.cmd == "scratch" else args.cmd](repo, args)
    except Problem as err:
        sys.stdout.flush()
        sys.exit(f"harness-red: {err}")
    sys.exit(code)


if __name__ == "__main__":
    run_main("harness-red", main)
