#!/usr/bin/env python3
"""
Dead-code candidates in a Harness checkout, each with its evidence, for the daily job to batch into a ticket.
It proposes and removes nothing. The rules and their reasons: docs/design.md, harness-deadcode, and
docs/research/dead-code-agent.md (False positives, Recommendation).

Usage:
    harness-deadcode scan [--lines FILE ...] [--json] [--repo PATH]
    harness-deadcode daily [--dry-run] [--repo PATH]     # file one manual-land `Remove dead code` ticket
    harness-deadcode daily --install-launchd [--repo PATH]   # run daily at 03:30 (a LaunchAgent)
    harness-deadcode daily --uninstall-launchd

A candidate is a top-level function, class or constant, a non-dunder method, a harness_lib module, an unwired
hook file or a bin tool's flag parsed and never read, that nothing outside tests/ and docs/design.md uses.
Subcommands and flags no skill, agent, doc, setting or other tool calls are listed apart, as `no_caller`.
--lines takes coverage.py-shaped line data ({"meta": {...}, "files": {path: {"executed_lines": [...]}}}),
repeatable: data whose meta.kind is "real" (a loop run) drops a candidate whose body ran; other data is the
suite's and only marks each candidate's `ran_in_suite`.

`daily` (#455) adds the fingerprints of closed, unmerged dead-code PRs to
~/.claude/harness/deadcode/<repo-key>/rejected.json, scans (with the newest complete lines.json of
scripts/collect_lines.py), and files at most one ticket a day, none while one is open, under the epic
HARNESS_DEADCODE_EPIC names (the environment, else `env` in the repository's .claude/settings.json).
gh is HARNESS_GH when set, else `gh` on PATH; launchctl is HARNESS_LAUNCHCTL when set.
"""
from __future__ import annotations

import ast
import builtins
import glob
import hashlib
import importlib
import importlib.util
import json
import os
import plistlib
import re
import shutil
import subprocess
import sys
import sysconfig
import tempfile
import time

_LIB = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)
try:
    from harness_lib.cli import Parser, Problem, emit, run_main
    from harness_lib.gh import gh_json
    from harness_lib.paths import repo_key
    from harness_lib.repo import main_checkout
    from harness_lib.settings import setting, settings_env
    from harness_lib.text import first_line, harness_home, home, read_json, write_json
except Exception as exc:  # one line, exit 1 (docs/design.md, the shared lib)
    sys.exit(f"harness-deadcode: cannot load harness_lib from {_LIB}: {' '.join(str(exc).split())}")

P = "plugins/harness/"
WORD = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
KEEP = re.compile(r"#\s*deadcode:\s*keep\s*\([^)]*\w[^)]*\)")
HEADING = re.compile(r"^(#+)\s+(.*)")
# Folders and files whose text can name code (docs/design.md is the contract, docs/research names nothing).
TEXT_DIRS = (P + "skills", P + "agents", P + "templates", "user", ".githooks", ".github")
TEXT_FILES = (P + "hooks/hooks.json", "docs/guide.md", "CLAUDE.md")
CODE_DIRS = (P + "bin", P + "hooks", P + "lib/harness_lib", P + "tests", "scripts")
ARGPARSE_DEFS = {"add_argument", "add_parser", "add_subparsers", "add_argument_group",
                 "add_mutually_exclusive_group", "set_defaults"}


# --------------------------------------------------------------- reading the tree
def role(rel):
    """What a file is to the scan: bin, hooks, lib, scripts or tests code, text, or None."""
    base = os.path.basename(rel)
    if rel.startswith(P + "tests/"):
        return "tests" if rel.endswith(".py") else None
    if rel.startswith(P + "bin/") and "." not in base and rel.count("/") == 3:
        return "bin"
    if rel.startswith(P + "hooks/") and rel.endswith(".py") and rel.count("/") == 3:
        return "hooks"
    if rel.startswith(P + "lib/harness_lib/") and rel.endswith(".py"):
        return "lib"
    if rel.startswith("scripts/"):
        return "scripts" if rel.endswith(".py") else "text" if rel.endswith(".sh") else None
    if rel.startswith(TEXT_DIRS) or rel in TEXT_FILES:
        return "text"
    return None


def read(path):
    try:
        with open(path, "rb") as fh:
            return fh.read().decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def files(root):
    """(rel, role, text) for every file the scan reads, in a stable order."""
    rels = [f for f in TEXT_FILES if os.path.isfile(os.path.join(root, f))]
    for top in CODE_DIRS + TEXT_DIRS:
        for dirpath, dirnames, names in os.walk(os.path.join(root, top)):
            dirnames[:] = sorted(d for d in dirnames if d not in ("__pycache__", "node_modules", ".git"))
            rels += [os.path.relpath(os.path.join(dirpath, n), root).replace(os.sep, "/") for n in sorted(names)]
    for rel in dict.fromkeys(rels):   # hooks.json is both a listed file and in a walked folder
        kind = role(rel)
        text = read(os.path.join(root, rel)) if kind else None
        if text is not None:
            yield rel, kind, text


class Code:
    """One parsed Python file: its references and its own argparse and definition facts."""

    def __init__(self, rel, kind, text):
        self.rel, self.kind, self.text = rel, kind, text
        self.lines = text.splitlines()
        self.words, self.attrs, self.imports = set(), set(), set()
        self.strings = []   # string constants outside docstrings and argparse definitions
        try:
            self.tree = ast.parse(text, filename=rel)
        except (SyntaxError, ValueError):
            self.tree = None
            self.words = set(WORD.findall(text))
            return
        docs = {id(n.body[0].value) for n in ast.walk(self.tree)
                if isinstance(n, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef))
                and n.body and isinstance(n.body[0], ast.Expr) and isinstance(n.body[0].value, ast.Constant)}
        defining = {id(c) for n in ast.walk(self.tree) if isinstance(n, ast.Call) and attr_of(n) in ARGPARSE_DEFS
                    for c in ast.walk(n) if isinstance(c, ast.Constant)}
        package = rel[len(P + "lib/"):-3].split("/")[:-1] if kind == "lib" else []
        for n in ast.walk(self.tree):
            if isinstance(n, ast.Name) and not isinstance(n.ctx, ast.Store):
                self.words.add(n.id)
            elif isinstance(n, ast.Attribute) and not isinstance(n.ctx, ast.Store):
                self.words.add(n.attr)
                self.attrs.add(n.attr)
            elif isinstance(n, ast.Import):
                for a in n.names:
                    self.imports.add(a.name)
                    self.words.update(a.name.split("."))
            elif isinstance(n, ast.ImportFrom):
                parts = (package[:len(package) - n.level + 1] if n.level else []) + (n.module or "").split(".")
                module = ".".join(p for p in parts if p)
                self.imports.add(module)
                self.words.update(module.split("."))
                for a in n.names:
                    self.imports.add(f"{module}.{a.name}")
                    self.words.add(a.name)
            elif isinstance(n, ast.Constant) and isinstance(n.value, str) and id(n) not in docs:
                self.words.update(WORD.findall(n.value))
                if id(n) not in defining:
                    self.strings.append(n.value)

    def segment(self, node, start=None):
        """The node's source text, from `start` (a line) when given."""
        first = start or node.lineno
        lines = self.lines[first - 1:node.end_lineno]
        if not lines:
            return ""
        lines[-1] = lines[-1][:node.end_col_offset]
        if first == node.lineno:
            lines[0] = lines[0][node.col_offset:]
        return "\n".join(lines)

    def kept_file(self):
        first = self.tree.body[0].lineno if self.tree and self.tree.body else len(self.lines) + 1
        return any(KEEP.search(line) for line in self.lines[:first - 1])

    def kept(self, node):
        top = min([node.lineno] + [d.lineno for d in getattr(node, "decorator_list", [])])
        above = self.lines[top - 2].strip() if top > 1 else ""
        return bool(KEEP.search(self.lines[node.lineno - 1]) or (above.startswith("#") and KEEP.search(above)))


def attr_of(call):
    return call.func.attr if isinstance(call.func, ast.Attribute) else None


def dotted(node):
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        head = dotted(node.value)
        return f"{head}.{node.attr}" if head else None
    return None


# --------------------------------------------------------------- definitions
def is_dunder(name):
    return name.startswith("__") and name.endswith("__")


def top_statements(body):
    """Module-level statements, into `if` and `try` bodies, but not `if __name__ == "__main__"` (an entry point)
    nor a `try`'s handlers (the fail-open fallbacks of a harness_lib import)."""
    for node in body:
        if isinstance(node, ast.If):
            if "__name__" not in ast.dump(node.test):
                yield from top_statements(node.body + node.orelse)
        elif isinstance(node, ast.Try):
            yield from top_statements(node.body + node.orelse + node.finalbody)
        else:
            yield node


def is_stdlib(top):
    names = getattr(sys, "stdlib_module_names", None)
    if names is not None:
        return top in names
    if top in sys.builtin_module_names:
        return True
    try:
        spec = importlib.util.find_spec(top)
    except (ImportError, ValueError):
        return False
    if spec is None or not spec.origin:
        return False
    if spec.origin in ("built-in", "frozen"):
        return True
    origin, stdlib = os.path.realpath(spec.origin), os.path.realpath(sysconfig.get_paths()["stdlib"])
    return origin.startswith(stdlib + os.sep) and "site-packages" not in origin


def library_names(cls, aliases):
    """The attribute names of the standard-library classes `cls` derives from: a method that overrides one
    (argparse's `error`) is the library's protocol, called from inside the library."""
    names = set()
    for base in cls.bases:
        path = dotted(base)
        if not path:
            continue
        head, _, rest = path.partition(".")
        full = ".".join(p for p in (aliases.get(head, ""), rest) if p)
        obj = None
        if not full and hasattr(builtins, head):
            obj = getattr(builtins, head)
        elif full and is_stdlib(full.split(".")[0]):
            parts = full.split(".")
            for cut in range(len(parts), 0, -1):
                try:
                    obj = importlib.import_module(".".join(parts[:cut]))
                except ImportError:
                    continue
                for part in parts[cut:]:
                    obj = getattr(obj, part, None)
                break
        if obj is not None:
            names.update(dir(obj))
    return names


def body_lines(stmts):
    if stmts and isinstance(stmts[0], ast.Expr) and isinstance(stmts[0].value, ast.Constant):
        stmts = stmts[1:]
    return {n for s in stmts for n in range(s.lineno, s.end_lineno + 1)}


def definitions(code):
    """(node, kind, name, body lines) for the file's functions, classes, constants and methods, keeps left out."""
    aliases = {}
    for node in code.tree.body:
        if isinstance(node, ast.Import):
            aliases.update({a.asname or a.name.split(".")[0]: a.name if a.asname else a.name.split(".")[0]
                            for a in node.names})
        elif isinstance(node, ast.ImportFrom) and not node.level:
            aliases.update({a.asname or a.name: f"{node.module}.{a.name}" for a in node.names})
    out = []
    for node in top_statements(code.tree.body):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if node.name != "main" and not is_dunder(node.name):
                out.append((node, "function", node.name, body_lines(node.body)))
        elif isinstance(node, ast.ClassDef):
            methods = [m for m in node.body if isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef))]
            if code.kept(node):
                continue   # a kept class keeps its methods
            out.append((node, "class", node.name, set().union(*(body_lines(m.body) for m in methods))))
            protocol = library_names(node, aliases) if node.bases else set()
            out += [(m, "method", f"{node.name}.{m.name}", body_lines(m.body)) for m in methods
                    if not is_dunder(m.name) and m.name not in protocol]
        elif isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is not None:
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            for t in targets:
                for n in ([t] if isinstance(t, ast.Name) else getattr(t, "elts", [])):
                    if isinstance(n, ast.Name) and not is_dunder(n.id):
                        out.append((node, "constant", n.id, set(range(node.lineno, node.end_lineno + 1))))
    return [d for d in out if not code.kept(d[0])]


# --------------------------------------------------------------- the argparse surface
def scopes(tree):
    """The module and each function, every one with its own nodes (nested functions not descended into)."""
    for scope in [tree] + [n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))]:
        nodes, todo = [], list(ast.iter_child_nodes(scope))
        while todo:
            n = todo.pop()
            nodes.append(n)
            if not isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda, ast.ClassDef)):
                todo.extend(ast.iter_child_nodes(n))
        yield nodes


def surface(code):
    """([(path, call)] subcommands, [(path, options, dest, call)] flags) of a bin tool's argparse parsers."""
    subs, flags = [], []
    for nodes in scopes(code.tree):
        target = {id(n.value): n.targets[0].id for n in nodes
                  if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name)}
        env, result = {}, {}

        def owner(expr):
            if isinstance(expr, ast.Name):
                return env.get(expr.id, ())
            return result.get(id(expr), ())

        calls = sorted((n for n in nodes if isinstance(n, ast.Call)),
                       key=lambda c: (c.lineno, c.col_offset, c.end_lineno, c.end_col_offset))
        for call in calls:
            what, path = attr_of(call), ()
            consts = [a.value for a in call.args if isinstance(a, ast.Constant) and isinstance(a.value, str)]
            if what in ("add_subparsers", "add_argument_group", "add_mutually_exclusive_group"):
                path = owner(call.func.value)
            elif what == "add_parser" and consts:
                path = owner(call.func.value) + (consts[0],)
                subs.append((path, call))
            elif what == "add_argument":
                options = [c for c in consts if c.startswith("-")]
                kw = {k.arg: k.value for k in call.keywords}
                action, dest = kw.get("action"), kw.get("dest")
                if options and not (
                        isinstance(action, ast.Constant) and action.value in ("help", "version")):
                    if isinstance(dest, ast.Constant):
                        name = dest.value
                    elif dest is not None:
                        name = None   # argparse.SUPPRESS or computed: not judged
                    else:
                        long = [o for o in options if o.startswith("--")]
                        name = (long or options)[0].lstrip("-").replace("-", "_")
                    if name:
                        flags.append((owner(call.func.value), options, name, call))
            result[id(call)] = path
            if id(call) in target:
                env[target[id(call)]] = path
    return subs, flags


def flag_name(path, options):
    long = [o for o in options if o.startswith("--")]
    return " ".join(path + ((long or options)[0],))


def bounded(word):
    return re.compile(r"(?<![\w-])" + re.escape(word) + r"(?![\w-])")


# --------------------------------------------------------------- line data
def load_lines(paths, rels):
    """({rel: lines} from real runs, {rel: lines} from the suite, whether any suite data was given)."""
    real, suite, any_suite = {}, {}, False
    for path in paths:
        data = read_json(path)
        if not isinstance(data, dict) or not isinstance(data.get("files"), dict):
            raise Problem(f"{path}: not line data (a JSON object with `files`)")
        meta = data.get("meta") if isinstance(data.get("meta"), dict) else {}
        into = real if meta.get("kind") == "real" else suite
        any_suite = any_suite or into is suite
        for name, entry in data["files"].items():
            lines = entry.get("executed_lines") if isinstance(entry, dict) else None
            name = str(name).replace("\\", "/")
            rel = name if name in rels else next(
                (name[i + 1:] for i, ch in enumerate(name) if ch == "/" and name[i + 1:] in rels), None)
            if rel and isinstance(lines, list):
                into.setdefault(rel, set()).update(n for n in lines if isinstance(n, int))
    return real, suite, any_suite


# --------------------------------------------------------------- the scan
def scan(root, line_files=()):
    codes, texts, design = [], [], ""
    for rel, kind, text in files(root):
        if kind == "text":
            texts.append(text)
        else:
            codes.append(Code(rel, kind, text))
    if os.path.isfile(os.path.join(root, "docs", "design.md")):
        design = read(os.path.join(root, "docs", "design.md")) or ""
    prod = [c for c in codes if c.kind != "tests"]
    tests = [c for c in codes if c.kind == "tests"]
    used = set().union(*(c.words for c in prod), *(set(WORD.findall(t)) for t in texts))
    design_words = set(WORD.findall(design))
    caller_lines = [line for t in texts for line in t.splitlines()]
    real, suite, any_suite = load_lines(line_files, {c.rel for c in prod})
    candidates, no_caller = [], []

    def refs(test_files, contract):
        kinds = (["test"] if test_files else []) + (["contract"] if contract else [])
        return "+".join(kinds) or "none"

    def add(code, line, end, kind, name, source, lines, test_files, contract):
        if lines & real.get(code.rel, set()) and kind not in ("constant", "flag"):
            return   # a real loop run executed it
        c = {"path": code.rel, "line": line, "end_line": end, "kind": kind, "name": name,
             "refs": refs(test_files, contract),
             "tests": sorted(test_files),
             "fingerprint": {"path": code.rel, "kind": kind, "name": name,
                             "sha256": hashlib.sha256(source.encode("utf-8")).hexdigest()}}
        if any_suite:
            c["ran_in_suite"] = bool(lines & suite.get(code.rel, set()))
        candidates.append(c)

    for code in prod:
        if code.tree is None or code.kept_file():
            continue
        for node, kind, name, lines in definitions(code):
            own = name.split(".")[-1]
            if own not in used:
                start = min([node.lineno] + [d.lineno for d in getattr(node, "decorator_list", [])])
                add(code, node.lineno, node.end_lineno, kind, name, code.segment(node, start), lines,
                    [t.rel for t in tests if own in t.words], own in design_words)
        module_check(code, prod, texts, tests, design, add)
        if code.kind == "bin":
            tool_surface(code, prod, caller_lines, tests, design, add, no_caller)
    order = {"subcommand": 0, "flag": 1}
    no_caller.sort(key=lambda e: (e["path"], e["line"], order[e["kind"]]))
    return {"candidates": sorted(candidates, key=lambda c: (c["path"], c["line"], c["name"])),
            "no_caller": no_caller}


def module_named(module):
    """`harness_lib.x` or `harness_lib/x` in a text."""
    return re.compile(r"(?<![\w.])" + re.escape(module).replace(r"\.", r"[./]") + r"(?![\w-])")


def module_check(code, prod, texts, tests, design, add):
    """A harness_lib module no code imports, or a hook file nothing wires, names or imports."""
    base = os.path.basename(code.rel)
    if code.kind == "lib" and base != "__init__.py":
        module = "harness_lib." + code.rel[len(P + "lib/harness_lib/"):-3].replace("/", ".")
        named = module_named(module)
        contract = bool(bounded(base).search(design) or named.search(design))
    elif code.kind == "hooks":
        module = base[:-3]   # imported by its name from the hooks folder (tests_first.py imports branch_guard)
        named = bounded(base)
        contract = bool(named.search(design))
    else:
        return
    others = [c for c in prod if c is not code]
    if any(module in c.imports or any(named.search(s) for s in c.strings) for c in others) or any(
            named.search(t) for t in texts):
        return
    hits = [t.rel for t in tests if module in t.imports or any(named.search(s) for s in t.strings)]
    add(code, 1, max(len(code.lines), 1), "module", module, code.text, set(range(1, len(code.lines) + 1)), hits,
        contract)


def tool_section(design, tool):
    """[(line number, line)] of docs/design.md under the headings that name `tool`."""
    in_tool, heading_level, section = bounded(tool), 0, []
    for number, line in enumerate(design.splitlines(), 1):
        m = HEADING.match(line)
        if m and (not heading_level or len(m.group(1)) <= heading_level):
            heading_level = len(m.group(1)) if in_tool.search(m.group(2)) else 0
        if heading_level:
            section.append((number, line))
    return section


def tool_surface(code, prod, caller_lines, tests, design, add, no_caller):
    """A bin tool's flags parsed and never read (candidates), and its subcommands and flags no one calls."""
    tool = os.path.basename(code.rel)
    subs, flags = surface(code)
    others = [c for c in prod if c is not code]
    read = set().union(*(c.attrs for c in prod)) | set(code.strings)
    called_lines = caller_lines + [s for c in others for s in c.strings]
    other_strings = {s for c in others for s in c.strings}
    in_tool = bounded(tool)
    section = "\n".join(line for _, line in tool_section(design, tool))
    for path, call in subs:
        spoken = re.compile(r"(?<![\w-])" + re.escape(tool) + r"\s+" + r"\s+".join(map(re.escape, path)) + r"(?![\w-])")
        if path[-1] not in other_strings and not any(spoken.search(line) for line in called_lines):
            no_caller.append({"path": code.rel, "line": call.lineno, "kind": "subcommand", "name": " ".join(path)})
    for path, options, dest, call in flags:
        name, marks = flag_name(path, options), [bounded(o) for o in options]
        if dest not in read:
            if code.kept(call):
                continue
            hits = [t.rel for t in tests if any(m.search(s) for s in t.strings for m in marks)]
            add(code, call.lineno, call.end_lineno, "flag", name, code.segment(call),
                set(range(call.lineno, call.end_lineno + 1)), hits, any(m.search(section) for m in marks))
            continue
        called = any(s == o or s.startswith(o + "=") for s in other_strings for o in options) or any(
            m.search(line[hit.end():]) for line in called_lines for hit in in_tool.finditer(line) for m in marks)
        if not called:
            no_caller.append({"path": code.rel, "line": call.lineno, "kind": "flag", "name": name})


# --------------------------------------------------------------- output
def text_report(out):
    lines = [f"{len(out['candidates'])} candidates (proposed for removal; nothing is removed)"]
    for c in out["candidates"]:
        extra = f"  tests: {', '.join(c['tests'])}" if c["tests"] else ""
        ran = f"  ran_in_suite: {'yes' if c['ran_in_suite'] else 'no'}" if "ran_in_suite" in c else ""
        lines.append(f"  {c['path']}:{c['line']}  {c['kind']}  {c['name']}  refs: {c['refs']}{extra}{ran}")
    lines.append(f"{len(out['no_caller'])} with no caller (the owner's typed surface: reported, never proposed)")
    lines += [f"  {e['path']}:{e['line']}  {e['kind']}  {e['name']}" for e in out["no_caller"]]
    return "\n".join(lines)


def find_root(start):
    here = os.path.abspath(start)
    while True:
        if os.path.exists(os.path.join(here, ".git")):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            return os.path.abspath(start)
        here = parent


def checkout(repo):
    root = os.path.abspath(repo) if repo else find_root(os.getcwd())
    if not os.path.isdir(os.path.join(root, P)):
        raise Problem(f"{root} is not a Harness checkout (no {P})")
    return root


# --------------------------------------------------------------- the daily run (#455)
TITLE = "Remove dead code"
GATE = "manual-land"
LABEL = "com.ryaneskuri.harness-deadcode"
MAX_CANDIDATES, MAX_LINES = 5, 150   # one ticket's batch (docs/research/dead-code-agent.md, Batch size)
DEAD_BRANCH = re.compile(r"^t/(\d+)-remove-dead-code$")
FINGERPRINTS = re.compile(r"<!--\s*harness-deadcode fingerprints\s*(\[.*?\])\s*-->", re.S)
FP_KEYS = ("path", "kind", "name", "sha256")


def fp_key(fp):
    return tuple(str(fp.get(k, "")) for k in FP_KEYS)


def span(c):
    return c["end_line"] - c["line"] + 1


def newest_lines(folder):
    """The newest lines.json scripts/collect_lines.py wrote for this repository from a complete run, or None."""
    found = []
    for path in glob.glob(os.path.join(folder, "*", "lines.json")):
        data = read_json(path)
        if isinstance(data, dict) and data.get("returncode") == 0 and isinstance(data.get("files"), dict):
            try:
                found.append((os.path.getmtime(path), path))
            except OSError:
                continue
    return max(found)[1] if found else None


def listed(body):
    """The fingerprints a dead-code ticket's body records."""
    m = FINGERPRINTS.search(body or "")
    try:
        items = json.loads(m.group(1)) if m else []
    except ValueError:
        return []
    return [{k: str(i[k]) for k in FP_KEYS} for i in items if isinstance(i, dict) and all(k in i for k in FP_KEYS)]


def add_rejections(root, rejected):
    """Add the fingerprints listed by the ticket of each closed, unmerged dead-code PR not seen before to
    `rejected` ({"fingerprints", "prs"}); whether anything changed."""
    # Unlabelled: the loop opens the PR bare and only the ticket carries GATE; DEAD_BRANCH picks the PRs out.
    prs = gh_json(["pr", "list", "--state", "closed", "--limit", "100",
                   "--json", "number,headRefName,state,mergedAt"], root)
    have = {fp_key(f) for f in rejected["fingerprints"]}
    changed = False
    for pr in prs if isinstance(prs, list) else []:
        m = DEAD_BRANCH.match(str(pr.get("headRefName") or "")) if isinstance(pr, dict) else None
        if not m or pr.get("state") == "MERGED" or pr.get("mergedAt") or pr.get("number") in rejected["prs"]:
            continue
        ticket = int(m.group(1))
        issue = gh_json(["issue", "view", str(ticket), "--json", "body"], root)
        for fp in listed(issue.get("body") if isinstance(issue, dict) else ""):
            if fp_key(fp) not in have:
                have.add(fp_key(fp))
                rejected["fingerprints"].append(dict(fp, ticket=ticket, pr=pr.get("number")))
        rejected["prs"].append(pr.get("number"))
        changed = True
    return changed


def open_ticket(root):
    items = gh_json(["issue", "list", "--state", "open", "--label", GATE, "--limit", "100",
                     "--json", "number,title,url"], root)
    return next((i for i in items if isinstance(i, dict) and i.get("title") == TITLE), None) \
        if isinstance(items, list) else None


def batch(candidates):
    """(the batch, its removed lines): at most MAX_CANDIDATES and MAX_LINES, test-only candidates last."""
    ordered = [c for c in candidates if c["refs"] != "test"] + [c for c in candidates if c["refs"] == "test"]
    chosen, total = [], 0
    for c in ordered:
        if len(chosen) < MAX_CANDIDATES and total + span(c) <= MAX_LINES:
            chosen.append(c)
            total += span(c)
    return chosen, total


def own_name(c):
    return c["name"].split(".")[-1]


def live_names(root, chosen):
    """The names of the functions, classes and module-level constants in non-test code outside the batch."""
    names = set()
    for _, kind, text in files(root):
        if kind in ("tests", "text"):
            continue
        try:
            tree = ast.parse(text)
        except (SyntaxError, ValueError):
            continue
        names.update(n.name for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef,
                                                                       ast.ClassDef)))
        names.update(t.id for n in top_statements(tree.body) if isinstance(n, ast.Assign)
                     for t in n.targets if isinstance(t, ast.Name))
    return {n for n in names if not is_dunder(n)} - {own_name(c) for c in chosen if c["kind"] != "flag"}


def code_words(node):
    out = set()
    for n in ast.walk(node):
        if isinstance(n, ast.Name):
            out.add(n.id)
        elif isinstance(n, ast.Attribute):
            out.add(n.attr)
        elif isinstance(n, ast.alias):
            out.update(n.name.split("."))
    return out


def reach(node, c, live, helpers):
    """None when the test function `node` does not name candidate `c`; else whether it reaches only the batch:
    neither it nor the test file's helpers it calls (`helpers`, name to node) name a live definition. A case
    passing a flag always reaches the code that parses it."""
    strings = [n.value for n in ast.walk(node) if isinstance(n, ast.Constant) and isinstance(n.value, str)]
    if c["kind"] == "flag":
        mark = bounded(c["name"].split()[-1])
        return False if any(mark.search(s) for s in strings) else None
    code = code_words(node)
    if own_name(c) not in code | {w for s in strings for w in WORD.findall(s)}:
        return None
    seen, todo = set(), [w for w in code if w in helpers]
    while todo:
        name = todo.pop()
        if name not in seen:
            seen.add(name)
            more = code_words(helpers[name])
            code |= more
            todo += [w for w in more if w in helpers]
    return not (code & live)


def test_cases(root, rel, c, live):
    """([cases that reach only the batch], [cases that also reach code that stays]) of the test file `rel` naming
    candidate `c`, each `Class.test_x`."""
    try:
        tree = ast.parse(read(os.path.join(root, rel)) or "", filename=rel)
    except (SyntaxError, ValueError):
        return [], []
    only, also = [], []
    helpers = {n.name: n for n in ast.walk(tree)
               if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and not n.name.startswith("test")}

    def visit(body, prefix):
        for node in body:
            if isinstance(node, ast.ClassDef):
                visit(node.body, prefix + node.name + ".")
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name.startswith("test"):
                alone = reach(node, c, live, helpers)
                if alone is not None:
                    (only if alone else also).append(prefix + node.name)

    visit(tree.body, "")
    return only, also


def design_lines(design, c):
    """The numbers of the docs/design.md lines that name candidate `c` (a flag: in its tool's section)."""
    if "contract" not in c["refs"]:
        return []
    if c["kind"] == "flag":
        mark = bounded(c["name"].split()[-1])
        return [n for n, line in tool_section(design, os.path.basename(c["path"])) if mark.search(line)]
    if c["kind"] == "module":
        marks = [bounded(os.path.basename(c["path"]))] + (
            [module_named(c["name"])] if c["name"].startswith("harness_lib.") else [])
    else:
        marks = [re.compile(r"(?<![\w])" + re.escape(own_name(c)) + r"(?![\w])")]
    return [n for n, line in enumerate(design.splitlines(), 1) if any(m.search(line) for m in marks)]


def ticket_body(root, chosen, total, lines_file):
    """The ticket, in templates/ticket_task.md's sections, with each candidate's evidence and its fingerprints."""
    design = read(os.path.join(root, "docs", "design.md")) or ""
    out = ["## Request",
           f"`harness-deadcode daily` found {len(chosen)} dead-code candidates ({total} lines of code) on "
           f"{time.strftime('%Y-%m-%d')}: nothing outside plugins/harness/tests/ and docs/design.md uses them. Remove "
           "them, the docs/design.md lines that name them and the test cases that reach only them. A role that finds "
           "a real use keeps that candidate and says why in the PR.", "",
           "## Outline",
           "1. Test-author: delete the test cases listed under Tests that must pass as removed with the code.",
           "2. Coder: remove each candidate below and update the docs/design.md lines listed with it.",
           "3. Reviewer: check each removal against its evidence, and that each deleted case pinned only removed "
           "code.", "",
           "### Candidates"]
    removed, edited, modules = [], [], []
    live = live_names(root, chosen) if any(c["tests"] for c in chosen) else set()
    for i, c in enumerate(chosen, 1):
        out.append(f"{i}. `{c['name']}`, a {c['kind']} in `{c['path']}`, lines {c['line']}-{c['end_line']} "
                   f"({span(c)} lines)")
        out.append(f"   - references: {c['refs']}" + (f" ({', '.join(c['tests'])})" if c["tests"] else ""))
        if "ran_in_suite" in c:
            out.append(f"   - ran in the suite: {'yes' if c['ran_in_suite'] else 'no'}")
        named = design_lines(design, c)
        if named:
            out.append(f"   - docs/design.md: line{'s' if len(named) > 1 else ''} {', '.join(map(str, named))}")
        for rel in c["tests"]:
            only, also = test_cases(root, rel, c, live)
            removed += [f"- `{rel}::{case}`: reaches only `{c['name']}`" for case in only]
            edited += [f"- `{rel}::{case}`: names `{c['name']}` and reaches code that stays" for case in also]
            if not only and not also:
                edited.append(f"- `{rel}`: names `{c['name']}` outside a test case")
            modules.append(rel)
    out += ["", "## Definition of done",
            "- [ ] Each candidate above is removed, or kept with the reason in the PR's Notes.",
            "- [ ] docs/design.md names no removed candidate.",
            "- [ ] The test cases listed as removed with the code are gone, and the suite passes.", "",
            "## Tests that must pass",
            "Removed with the code (the test-author deletes these before any source changes):"]
    out += removed or ["- none: no test case reaches only a candidate"]
    if edited:
        out += ["Edited with the code (the test-author drops the reference and keeps what the case pins otherwise; "
                "the reviewer checks each):"] + edited
    out += ["Stay green:"] + [f"- `python3 -m unittest discover -s plugins/harness/tests -p {os.path.basename(rel)}`"
                              for rel in dict.fromkeys(modules)]
    out += ["- the existing suite, `python3 scripts/run_suite.py`", "",
            "## Context",
            "- Filed by `harness-deadcode daily` from `harness-deadcode scan --json`"
            + (f" with the line data in `{lines_file}`" if lines_file else " without line data") + ".",
            f"- `{GATE}`: the owner lands it with /harness:land. Closing its PR unmerged rejects these candidates "
            "until their source changes; close this ticket as not planned with it, or no later batch is filed. "
            "`# deadcode: keep (<reason>)` keeps one for good.", "",
            "<!-- harness-deadcode fingerprints",
            json.dumps([c["fingerprint"] for c in chosen], indent=1),
            "-->", ""]
    return "\n".join(out)


def file_ticket(root, folder, body, epic, size):
    """`harness-board task create` the ticket under `epic`; (number, url, the error or None)."""
    board = os.path.join(os.path.dirname(os.path.realpath(__file__)), "harness-board")
    os.makedirs(folder, exist_ok=True)
    fd, path = tempfile.mkstemp(prefix="ticket-", suffix=".md", dir=folder)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(body)
        done = subprocess.run([sys.executable, board, "task", "create", "--repo", root, "--json", "--title", TITLE,
                               "--body-file", path, "--parent", epic, "--type", "refactor", "--size", size,
                               "--risk", "low", "--label", GATE], capture_output=True, text=True,
                              stdin=subprocess.DEVNULL, timeout=600)
    finally:
        os.remove(path)
    try:
        made = json.loads(done.stdout)
    except ValueError:
        made = {}
    error = None if done.returncode == 0 else (first_line(done.stderr) or f"harness-board exit {done.returncode}")
    return made.get("number"), made.get("url"), error


def daily(args):
    root = os.path.realpath(checkout(args.repo))
    if args.install_launchd:
        return install_launchd(os.path.realpath(main_checkout(root) or root))   # not a ticket worktree
    folder = harness_home("deadcode", repo_key(main_checkout(root) or root))
    today = time.strftime("%Y-%m-%d")
    head = "harness-deadcode: dry run: " if args.dry_run else "harness-deadcode: "
    last = read_json(os.path.join(folder, "daily.json"))
    if isinstance(last, dict) and last.get("date") == today:
        print(f"{head}#{last.get('number')} was filed today already; nothing to file until tomorrow")
        return
    rejected_path = os.path.join(folder, "rejected.json")
    rejected = read_json(rejected_path)
    if not (isinstance(rejected, dict) and isinstance(rejected.get("fingerprints"), list)
            and isinstance(rejected.get("prs"), list)):
        rejected = {"fingerprints": [], "prs": []}
    if add_rejections(root, rejected) and not args.dry_run:
        write_json(rejected_path, rejected, prefix=".rejected-")
    found = open_ticket(root)
    if found:
        print(f"{head}#{found.get('number')} ({TITLE}, {GATE}) is open; nothing to file while it is")
        return
    lines_file = newest_lines(folder)
    gone = {fp_key(f) for f in rejected["fingerprints"]}
    candidates = [c for c in scan(root, [lines_file] if lines_file else [])["candidates"]
                  if fp_key(c["fingerprint"]) not in gone]
    chosen, total = batch(candidates)
    if not chosen:
        print(f"{head}no candidates to file ({len(candidates)} left after the rejected, none within "
              f"{MAX_LINES} lines)" if candidates else f"{head}no candidates to file")
        return
    size = "S" if len(chosen) <= 2 else "M"
    epic = setting("HARNESS_DEADCODE_EPIC", settings_env(root))
    body = ticket_body(root, chosen, total, lines_file)
    if args.dry_run:
        print(f"{head}would file `{TITLE}` (refactor, size:{size}, risk:low, {GATE}, status:ready) under "
              f"#{epic or '<HARNESS_DEADCODE_EPIC unset>'}: {len(chosen)} candidates, {total} lines\n")
        print(body)
        return
    if not epic or not epic.isdigit():
        raise Problem(f"HARNESS_DEADCODE_EPIC is {'not an issue number' if epic else 'not set'} (the environment, "
                      f"or env in {root}/.claude/settings.json): the standing epic the ticket goes under")
    number, url, error = file_ticket(root, folder, body, epic, size)
    if number:
        write_json(os.path.join(folder, "daily.json"),
                   {"date": today, "number": number, "url": url,
                    "fingerprints": [c["fingerprint"] for c in chosen]}, prefix=".daily-")
    if error:
        raise Problem(f"harness-board task create: {error}" + (f" (#{number} was created)" if number else ""))
    print(f"{head}filed #{number} {url}: {len(chosen)} candidates, {total} lines, size:{size}, under #{epic}")


# --------------------------------------------------------------- launchd
def plist_path():
    return home("Library", "LaunchAgents", f"{LABEL}.plist")


def launchctl(args):
    """(exit code, first line of output) of a launchctl call; never raises."""
    exe = os.environ.get("HARNESS_LAUNCHCTL") or "launchctl"
    try:
        done = subprocess.run([exe] + args, capture_output=True, encoding="utf-8", errors="replace", timeout=30,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as err:
        return 1, str(getattr(err, "strerror", None) or err)
    return done.returncode, first_line(done.stderr) or first_line(done.stdout) or f"exit {done.returncode}"


def install_launchd(root):
    """Write and load the LaunchAgent that runs `daily --repo <root>` at 03:30, as harness-digest's does."""
    path = plist_path()
    script = os.path.realpath(os.path.abspath(__file__))
    job_path = ":".join(["/opt/homebrew/bin", "/usr/local/bin", home(".local", "bin"), "/usr/bin", "/bin"])
    python = shutil.which("python3", path=job_path) or sys.executable    # the python3 the job's own PATH finds
    log = harness_home("deadcode", "launchd.log")
    job = {"Label": LABEL, "ProgramArguments": [python, script, "daily", "--repo", root],
           "StartCalendarInterval": {"Hour": 3, "Minute": 30}, "EnvironmentVariables": {"PATH": job_path},
           "StandardOutPath": log, "StandardErrorPath": log, "RunAtLoad": False}
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "wb") as fh:
            plistlib.dump(job, fh)
    except OSError as err:
        raise Problem(f"cannot write {path}: {err.strerror or err}")
    domain = f"gui/{os.getuid()}"
    launchctl(["bootout", f"{domain}/{LABEL}"])          # an older copy; failing means none was loaded
    code, why = launchctl(["bootstrap", domain, path])
    if code == 0:
        print(f"harness-deadcode: wrote {path} and loaded it (launchctl bootstrap {domain}); it runs daily at 03:30 "
              f"on {root}, log {log}")
        return
    code2, why2 = launchctl(["load", "-w", path])
    if code2 == 0:
        print(f"harness-deadcode: wrote {path}; launchctl bootstrap failed ({why}), loaded it with launchctl load -w "
              f"instead; it runs daily at 03:30 on {root}, log {log}")
        return
    raise Problem(f"wrote {path} but could not load it: launchctl bootstrap: {why}; launchctl load -w: {why2}")


def uninstall_launchd():
    path = plist_path()
    code, why = launchctl(["bootout", f"gui/{os.getuid()}/{LABEL}"])
    unloaded = "unloaded it (launchctl bootout)" if code == 0 else f"it was not loaded ({why})"
    try:
        os.remove(path)
        removed = f"removed {path}"
    except FileNotFoundError:
        removed = f"no {path} to remove"
    except OSError as err:
        raise Problem(f"{unloaded}; cannot remove {path}: {err.strerror or err}")
    print(f"harness-deadcode: {unloaded}; {removed}")


def main():
    ap = Parser(prog="harness-deadcode", description="Dead-code candidates in a Harness checkout, with evidence.")
    sub = ap.add_subparsers(dest="cmd", metavar="{scan,daily}")
    sub.required = True
    sc = sub.add_parser("scan", help="print the candidates and the subcommands and flags with no caller")
    sc.add_argument("--lines", action="append", default=[], metavar="FILE",
                    help='line data, coverage.py JSON shape; meta.kind "real" marks a loop run (repeatable)')
    sc.add_argument("--json", action="store_true", help='print {"candidates", "no_caller"}')
    sc.add_argument("--repo", metavar="PATH", help="the checkout (default: the one holding the cwd)")
    dy = sub.add_parser("daily", help=f"file one {GATE} `{TITLE}` ticket of new candidates (once a day)")
    dy.add_argument("--repo", metavar="PATH", help="the checkout (default: the one holding the cwd)")
    mode = dy.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="print the batch it would file, file nothing")
    mode.add_argument("--install-launchd", action="store_true", help="run it daily at 03:30 (a LaunchAgent)")
    mode.add_argument("--uninstall-launchd", action="store_true", help="remove the LaunchAgent")
    args = ap.parse_args()
    if args.cmd == "daily":
        if args.uninstall_launchd:
            uninstall_launchd()
        else:
            daily(args)
        return
    root = checkout(args.repo)
    out = scan(root, args.lines)
    emit(args.json, out, text_report(out))


if __name__ == "__main__":
    run_main("harness-deadcode", main)
