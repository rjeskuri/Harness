HERE = Path(__file__).resolve().parent
TEMPLATES = Path(__file__).resolve().parent.parent / "templates"
TICKET_BRANCH = re.compile(r"^t/(\d+)-")
MARKER = "<!-- harness-review -->"
BODY_FINDING = re.compile(r"^- (`[^`]*`|\(no path\)) \[(\w+)\] (.*)$")     # a finding listed in a review's body
REVIEW_COUNT = re.compile(r"^Harness review \([^)]*\): (\d+) findings?\b")       # a review's summary line: the total only
INLINE_SEVERITY = re.compile(r"^\[(\w+)\]")                                        # an inline finding's prefix
LANDED = "Landed in"
RESOLUTION = "**Resolution**"
HIGH_RISK = "High risk: review the data and live-system paths before merging."
NO_RISK = "None noted."
SEVERITIES = ("high", "medium", "low")
SEVERITY_ALIASES = {"critical": "high", "blocker": "high", "major": "medium", "minor": "low", "nit": "low",
                    "info": "low"}
SEVERITY_RANK = ("critical", "high", "medium", "low", "info")
BILLING = re.compile(r"credit|billing|balance", re.I)
RUN_URL = re.compile(r"/actions/runs/(\d+)")
PR_URL = re.compile(r"https?://\S+/pull/(\d+)")
HUNK = re.compile(r"^@@ -\d+(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
PLACEHOLDER = re.compile(r"\{\{(\w+)\}\}")
HEADING = re.compile(r"^##\s+(.*?)\s*#*\s*$")
FENCE = re.compile(r"^\s{0,3}(```|~~~)")
RED_LINE = re.compile(r"^red run\b", re.I)
VERIFY_LABEL = re.compile(r"^(?:#{1,6}\s*)?verify:?\s*$", re.I)
RED_TAIL_LINES = 15
VERIFY_TAIL_LINES = 20
RUN_LOG_LINES = 60
DIRTY_SHOWN = 20             # files named in a dirty-tree refusal
POLL_SECONDS = 20.0          # checks --wait
NO_CHECKS_POLLS = 6          # 120 s at 20 s: no checks registered by then means none will be
MERGEABLE_RETRIES = 2
MERGEABLE_SLEEP = 3.0        # seconds, at most the poll interval
GH_TIMEOUT = 60
PUSH_TIMEOUT = 180
TOOL_TIMEOUT = 180
ULTRA_MINUTES = 30
EXHAUSTED_HOURS = 24
DEFAULT_CHECKED = "the diff against the ticket's definition of done"
LAND_FIELDS = "isDraft,mergeable,headRefName,closingIssuesReferences,statusCheckRollup,title,url,state"
RULING_LINE = re.compile(r"^[ \t]*(?:- )?(Ruling:.*\S)[ \t]*$", re.M)
OUTSIDE_NOTE = "(outside the files this ticket changed)"
SENTENCE_END = re.compile(r"[.!?](?= |$)")
TITLE_SENTENCE = 60          # an out-of-scope ticket's title: at most this much of the finding's first sentence
AWAIT_FIELDS = "number,title,isDraft,createdAt,url,headRefName,closingIssuesReferences,statusCheckRollup"
SHA_TEXT = re.compile(r"[0-9a-fA-F]{7,40}")
INCIDENT = "incident"
NEEDS_INPUT = "**Needs your input**"     # harness-board's needs-input comments start with it
DEFAULT_REASON = "no reason given"
EVIDENCE_TAIL_LINES = 40


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


def tail(text, n):
    """The last n lines, trailing spaces and the blank lines around them dropped."""
    lines = [line.rstrip() for line in (text or "").splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    lines = lines[-n:]
    while lines and not lines[0]:
        lines.pop(0)
    return "\n".join(lines)


def fence_safe(text):
    """Text that cannot close the ``` fence it is shown in."""
    return text.replace("```", "'''")


def short_home(path):
    """~/... for a path under HOME, for messages."""
    root = home()
    return "~" + path[len(root):] if path.startswith(root + os.sep) else path


def poll_interval():
    raw = os.environ.get("HARNESS_POLL_SECONDS", "").strip()
    try:
        value = float(raw) if raw else POLL_SECONDS
    except ValueError:
        return POLL_SECONDS
    return value if value >= 0 else POLL_SECONDS       # also catches nan


# --------------------------------------------------------------- git and the repository
def git(path, *args, timeout=60):
    try:
        return subprocess.run(["git", "-C", str(path)] + list(args), capture_output=True, text=True,
                              encoding="utf-8", errors="replace", stdin=subprocess.DEVNULL, timeout=timeout)
    except FileNotFoundError:
        raise Problem("git not found on PATH") from None
    except subprocess.TimeoutExpired:
        raise Problem(f"git {args[0]} timed out in {path}") from None


def git_ok(path, *args, timeout=60):
    done = git(path, *args, timeout=timeout)
    if done.returncode != 0:
        raise Problem(f"git {' '.join(args[:2])} failed in {path}: "
                      f"{last_line(done.stderr) or f'exit {done.returncode}'}")
    return done.stdout


def current_branch(path):
    return git(path, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip() or None


def dirty_files(path):
    """Paths git status lists (modified, staged or untracked) in the working tree at `path`."""
    out = git_ok(path, "status", "--porcelain=v1", "--untracked-files=all")
    return [line[3:] for line in out.splitlines() if len(line) > 3]


def listing(paths):
    shown = ", ".join(paths[:DIRTY_SHOWN])
    return shown + (f" and {len(paths) - DIRTY_SHOWN} more" if len(paths) > DIRTY_SHOWN else "")


def nul_fields(text):
    return [field for field in text.split("\0") if field]


def tree_entries(path, rev, paths):
    """{path: (mode, oid)} for `paths` in the commit `rev`; a path the commit lacks is absent."""
    out = git_ok(path, "--literal-pathspecs", "ls-tree", "-r", "-z", "--full-tree", rev, "--", *paths)
    entries = {}
    for field in nul_fields(out):
        meta, _, name = field.partition("\t")
        mode, _, oid = meta.split(" ")
        entries[name] = (mode, oid)
    return entries


def fast_forward_blockers(path, target):
    """Before `git pull --ff-only` moves the checkout at `path` to `target`: (identical, blocking). `identical`
    are the dirty paths the fast-forward changes whose working-tree bytes equal `target`'s and whose index holds
    HEAD's or `target`'s version (an untracked path: absent from both index and HEAD); `blocking` the
    paths git would refuse to overwrite that are not identical: a tracked path whose index matches neither the
    landed version nor (with working-tree edits) HEAD, an untracked file in the way. A path whose index already
    holds the landed version is git's to keep, so it blocks nothing."""
    changed = set(nul_fields(git_ok(path, "diff", "--name-only", "-z", "--no-renames", "HEAD", target)))
    tracked, untracked = set(), set()
    fields = nul_fields(git_ok(path, "status", "--porcelain=v1", "-z", "--untracked-files=all"))
    while fields:
        field = fields.pop(0)
        code, name = field[:2], field[3:]
        (untracked if code == "??" else tracked).add(name)
        if code[0] in "RC" and fields:          # a staged rename or copy: its origin follows
            tracked.add(fields.pop(0))
    relevant = sorted((tracked | untracked) & changed)
    if not relevant:
        return [], []
    head, landed = tree_entries(path, "HEAD", relevant), tree_entries(path, target, relevant)
    index = {}
    for field in nul_fields(git_ok(path, "--literal-pathspecs", "ls-files", "-s", "-z", "--", *relevant)):
        meta, _, name = field.partition("\t")
        mode, oid, stage = meta.split(" ")
        index[name] = (mode, oid) if stage == "0" and name not in index else ("unmerged", "")
    files = [name for name in relevant
             if os.path.isfile(os.path.join(path, name)) and not os.path.islink(os.path.join(path, name))]
    hashed = dict(zip(files, git_ok(path, "hash-object", "--no-filters", "--", *files).split())) if files else {}
    identical, blocking = [], []
    for name in relevant:
        if (name in landed and landed[name][0].startswith("100") and hashed.get(name) == landed[name][1]
                and index.get(name) in (head.get(name), landed[name])):    # never drop a staged third version
            identical.append(name)
        elif name in untracked:
            blocking.append(name)
        elif index.get(name) == landed.get(name):
            continue                            # git keeps the index and the working tree's edit
        elif index.get(name) != head.get(name) or os.path.lexists(os.path.join(path, name)):
            blocking.append(name)
    return identical, blocking


class Repo:
    """The repository: its toplevel (`root`, maybe a linked worktree), its main working tree, the state key
    shared by both, and (on demand) OWNER/REPO."""

    def __init__(self, path):
        try:
            self.root, _common_dir, self.main, self.key = repo_facts(path, git, first_line)
        except RepoError as exc:
            raise Problem(str(exc)) from None
        self.name = os.path.basename(self.main)
        self._slug = None

    def slug(self):
        """OWNER/REPO, from gh repo view (once)."""
        if self._slug is None:
            data = gh_json(["repo", "view", "--json", "nameWithOwner"], self.main)
            slug = data.get("nameWithOwner") if isinstance(data, dict) else None
            if not isinstance(slug, str) or "/" not in slug:
                raise Problem("gh repo view did not name the repository (nameWithOwner missing)")
            self._slug = slug
        return self._slug

    def state(self, *parts):
        return harness_home("repos", self.key, *parts)


def open_repo(path=None):
    """--worktree when given; else the cwd's repository; else CLAUDE_PROJECT_DIR's."""
    if path:
        return Repo(path)
    try:
        return Repo(os.getcwd())
    except (Problem, OSError):
        project = os.environ.get("CLAUDE_PROJECT_DIR")
        if project:
            return Repo(project)
        raise Problem("not in a git repository (run it from the project or its ticket worktree)") from None


# --------------------------------------------------------------- gh, claude and the sibling tools
def gh(args, cwd, stdin=None, timeout=GH_TIMEOUT):
    """gh's stdout (through this module's gh_run), or Problem naming the call and gh's first stderr line."""
    return lib_gh(args, cwd, stdin, timeout, pick=first_line, run=gh_run)


def gh_json(args, cwd):
    """gh's output decoded as JSON (through this module's gh); Problem when it is not JSON."""
    return lib_gh_json(args, cwd, pick=first_line, via=gh)


def sibling(name):
    """A sibling bin tool: on PATH, else next to this script."""
    found = shutil.which(name)
    if found:
        return found
    here = HERE / name
    if here.is_file() and os.access(here, os.X_OK):
        return str(here)
    raise Problem(f"{name} not found on PATH or in {HERE}")


def tool(name, args, cwd, check=True, stdin=None):
    """A sibling tool's CompletedProcess; `stdin` is the text it reads, else it gets none."""
    feed = {"stdin": subprocess.DEVNULL} if stdin is None else {"input": stdin}
    try:
        done = subprocess.run([sibling(name)] + list(args), cwd=cwd, capture_output=True, text=True,
                              encoding="utf-8", errors="replace", timeout=TOOL_TIMEOUT, **feed)
    except OSError as err:
        raise Problem(f"cannot run {name}: {err.strerror or err}") from None
    except subprocess.TimeoutExpired:
        raise Problem(f"{name} {args[0]} timed out after {TOOL_TIMEOUT} s") from None
    if check and done.returncode != 0:
        why = one_line(done.stderr) or one_line(done.stdout) or f"exit {done.returncode}"
        raise Problem(f"{name} {' '.join(args[:2])} failed: {why}")
    return done


BOARD_WARNING = "harness-board: warning:"


def board_run(repo, args, check=True, stdin=None):
    """harness-board on this repository; its CompletedProcess. Its `harness-board: warning:` stderr lines go to our
    stderr, in order; its other stderr stays hidden."""
    done = tool("harness-board", list(args) + ["--repo", repo.main], repo.main, check=check, stdin=stdin)
    for line in (done.stderr or "").splitlines():
        if line.startswith(BOARD_WARNING):
            sys.stderr.write(line + "\n")
    sys.stderr.flush()
    return done


def board(repo, *args):
    """harness-board on this repository; its stdout (see board_run)."""
    return board_run(repo, args).stdout


def pr_view(repo, number, fields, cwd=None):
    data = gh_json(["pr", "view", str(number), "--json", fields], cwd or repo.root)
    if not isinstance(data, dict):
        raise Problem(f"gh pr view {number} printed no pull request")
    return data


def closing_numbers(view):
    out = []
    for ref in as_list(view.get("closingIssuesReferences")):
        n = ref.get("number")
        if isinstance(n, int) and n not in out:
            out.append(n)
    return out


# --------------------------------------------------------------- findings
def normal_severity(value):
    sev = str(value or "").strip().lower()
    sev = SEVERITY_ALIASES.get(sev, sev)
    return sev if sev in SEVERITIES else "low"


def load_findings(path):
    """The reviewer's findings: a JSON list (or {"findings": [...]}, or one object per line), normalized to
    {"path", "line", "severity", "body"}."""
    text = read_text(path, "findings file")
    try:
        data = json.loads(text)
    except ValueError:
        data = None
        start = text.find("[")
        if start >= 0:                         # the array, with the reviewer's verdict after it
            try:
                data, _ = json.JSONDecoder().raw_decode(text[start:])
            except ValueError:
                data = None
        if data is None:
            data = []
            for line in text.splitlines():
                if not line.strip():
                    continue
                try:
                    data.append(json.loads(line))
                except ValueError:
                    raise Problem(f"{path}: not JSON (a list of findings, or one finding per line)") from None
    if isinstance(data, dict):
        data = data.get("findings") if isinstance(data.get("findings"), list) else [data]
    if not isinstance(data, list):
        raise Problem(f"{path}: expected a JSON list of findings")
    findings = []
    for i, item in enumerate(data, 1):
        if not isinstance(item, dict):
            raise Problem(f"{path}: finding {i} is not an object")
        line = item.get("line")
        try:
            line = int(line) if line is not None and not isinstance(line, bool) and str(line).strip() else None
        except (TypeError, ValueError):
            line = None
        path_text = str(item.get("path") or "").strip()
        findings.append({"path": path_text[2:] if path_text.startswith("./") else path_text,
                         "line": line if line and line > 0 else None,
                         "severity": normal_severity(item.get("severity")),
                         "body": str(item.get("body") or "").strip()})
    return findings


def severity_counts(findings):
    counts = {s: 0 for s in SEVERITIES}
    for f in findings:
        counts[f["severity"]] += 1
    return counts


def where(f):
    if f["path"] and f["line"]:
        return f"`{f['path']}:{f['line']}`"
    return f"`{f['path']}`" if f["path"] else "(no path)"


def indented(body):
    return "\n  ".join(body.splitlines()) if body else ""


# --------------------------------------------------------------- open
def show_ticket(repo, number):
    out = board(repo, "show", str(number), "--json")
    try:
        data = json.loads(out)
    except ValueError:
        raise Problem(f"harness-board show {number} printed something other than JSON") from None
    if not isinstance(data, dict):
        raise Problem(f"harness-board show {number} printed no ticket")
    return data


def red_record(repo):
    """The branch's red record from harness-red status, or None when there is none."""
    done = tool("harness-red", ["status", "--json", "--worktree", repo.root], repo.root, check=False)
    if done.returncode != 0:
        return None
    try:
        data = json.loads(done.stdout)
    except ValueError:
        return None
    if not isinstance(data, dict) or data.get("no_tests") is True:    # a no-tests ticket has no red run
        return None
    return data


def first_paragraph(text):
    lines = []
    for line in (text or "").strip().splitlines():
        if not line.strip():
            break
        lines.append(line.strip())
    return " ".join(lines)


def tests_block(items, red):
    lines = [f"- {item}" for item in items] or ["None listed on the ticket."]
    files = (red or {}).get("run_files") or (red or {}).get("test_files") or []
    files = [f for f in files if isinstance(f, str) and f]
    if files:
        lines += ["", "Test files run: " + ", ".join(f"`{f}`" for f in files)]
    return "\n".join(lines)


def review_summary(findings):
    if findings is None:
        return "No review attached."
    if not findings:
        return "No findings."
    c = severity_counts(findings)
    lines = [f"{plural(len(findings), 'finding')}: {c['high']} high, {c['medium']} medium, {c['low']} low."]
    highs = [f for f in findings if f["severity"] == "high"]
    if highs:
        lines += ["", "High:"] + [f"- {where(f)}: {indented(f['body'])}" for f in highs]
    return "\n".join(lines)


def render(template, values):
    """One pass of {{name}} substitution, so a value that contains braces is left alone."""
    return PLACEHOLDER.sub(lambda m: values.get(m.group(1), m.group(0)), template)


def pr_body(number, ticket, red, verify_text, findings, notes=None):
    sections = ticket.get("sections") if isinstance(ticket.get("sections"), dict) else {}
    dod = [str(x).strip() for x in sections.get("definition_of_done") or [] if str(x).strip()]
    tests = [str(x).strip() for x in sections.get("tests") or [] if str(x).strip()]
    risky = ticket.get("risk") == "high" or "risk:high" in (ticket.get("labels") or [])
    values = {
        "number": str(number),
        "summary": first_paragraph(sections.get("request")) or ticket.get("title") or f"Ticket #{number}.",
        "notes_section": f"## Notes\n{notes}\n\n" if notes else "",
        "dod_checklist": "\n".join(dod) or "None listed on the ticket.",
        "tests_list": tests_block(tests, red),
        "red_kind": str(red.get("kind") or "unknown") if red else "none",
        "red_exit": str(red.get("exit")) if red else "-",
        "red_tail": "none: the ticket is no-tests" if "no-tests" in (ticket.get("flags") or [])
        else fence_safe(tail(red.get("tail"), RED_TAIL_LINES)) if red else "No red run recorded on this branch.",
        "verify_tail": fence_safe(tail(verify_text, VERIFY_TAIL_LINES)) if verify_text is not None
        else "No verify log attached.",
        "review_summary": review_summary(findings),
        "risks": HIGH_RISK if risky else NO_RISK,
    }
    path = TEMPLATES / "pr_body.md"
    return render(read_text(str(path), "template"), values)


def created_pr(out):
    found = PR_URL.findall(out)
    if not found:
        raise Problem(f"gh pr create printed no pull request URL: {first_line(out)[:80]}")
    url = [m.group(0) for m in PR_URL.finditer(out)][-1]
    return int(found[-1]), url


def cmd_open(args):
    repo = open_repo(args.worktree)
    number = args.number
    branch = current_branch(repo.root)
    m = TICKET_BRANCH.match(branch or "")
    if not m:
        raise Problem(f"{repo.root} is on {branch or 'a detached HEAD'}, not a ticket branch (t/<N>-<slug>)")
    if int(m.group(1)) != number:
        raise Problem(f"{repo.root} is on {branch}, the branch of ticket #{m.group(1)}, not #{number}")
    dirty = dirty_files(repo.root)
    if dirty:
        raise Problem(f"uncommitted changes in {repo.root}: {listing(dirty)}; commit or remove them first")
    verify_text = read_text(args.verify_log, "verify log") if args.verify_log else None
    notes_text = read_text(args.notes, "notes file") if args.notes else None
    notes = notes_text.rstrip().strip("\n") if notes_text and notes_text.strip() else None
    heading = second_level_heading(notes)
    if heading is not None:
        named = f"a `## {heading}` heading" if heading else "a bare `## ` heading"
        raise Problem(f"notes file {args.notes} has {named}, which would end the Notes section early; "
                      "use `###` or put it in a code fence")
    findings = load_findings(args.review) if args.review else None
    ticket = show_ticket(repo, number)
    body = pr_body(number, ticket, red_record(repo), verify_text, findings, notes)
    title = f"{ticket.get('title') or f'Ticket {number}'} (#{number})"

    push = git(repo.root, "push", "-u", "origin", branch, timeout=PUSH_TIMEOUT)
    if push.returncode != 0:
        raise Problem(f"git push -u origin {branch} failed: {last_line(push.stderr) or f'exit {push.returncode}'}")
    existing = gh_json(["pr", "list", "--head", branch, "--state", "open", "--json", "number,url"], repo.root)
    existing = [p for p in existing if isinstance(p, dict) and p.get("number")] if isinstance(existing, list) else []
    if existing:
        pr, url = int(existing[0]["number"]), existing[0].get("url") or ""
        gh(["pr", "edit", str(pr), "--body-file", "-"], repo.root, stdin=body)
    else:
        out = gh(["pr", "create", "--draft", "--base", "main", "--head", branch, "--title", title, "--body-file", "-"],
                 repo.root, stdin=body)
        pr, url = created_pr(out)
        try:
            board(repo, "comment", str(number), "--body", f"Pull request: {url}")
        except Problem as err:
            warn("harness-pr", f"PR #{pr} is open, but the ticket comment failed: {err}")
    if args.json:
        print(json.dumps({"number": pr, "url": url}))
    else:
        print(f"#{pr} {url}")
    return 0


# --------------------------------------------------------------- review
def diff_path(text):
    text = text.rstrip("\n")
    if text.startswith('"') and text.endswith('"') and len(text) >= 2:
        text = text[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    if text == "/dev/null":
        return None
    return text[2:] if text.startswith("b/") else text


def diff_lines(text):
    """{(path, new-side line)} for every added or context line in a unified diff."""
    found = set()
    path, line_no, old_left, new_left = None, 0, 0, 0
    for raw in text.splitlines():
        if old_left > 0 or new_left > 0:
            if raw.startswith("\\"):                  # \ No newline at end of file
                continue
            tag = raw[:1]
            if tag == "-":
                old_left -= 1
                continue
            if path:
                found.add((path, line_no))
            line_no += 1
            new_left -= 1
            if tag != "+":                             # a context line (or an empty one with its space stripped)
                old_left -= 1
            continue
        if raw.startswith("diff --git "):
            path = None
        elif raw.startswith("+++ "):
            path = diff_path(raw[4:])
        else:
            m = HUNK.match(raw)
            if m:
                old_left = int(m.group(1)) if m.group(1) is not None else 1
                line_no = int(m.group(2))
                new_left = int(m.group(3)) if m.group(3) is not None else 1
    return found


def review_body(model, findings, outside):
    c = severity_counts(findings)
    parts = [f"Harness review ({model}): {plural(len(findings), 'finding')}, {c['high']} high, "
             f"{c['medium']} medium, {c['low']} low."]
    if outside:
        parts.append("\n".join(["Not on a changed line:"] + [f"- {where(f)} [{f['severity']}] {indented(f['body'])}"
                                                            for f in outside]))
    parts.append(MARKER)
    return "\n\n".join(parts)


def post_review(repo, number, findings, model, checked):
    """Post `findings` on PR `number` as one COMMENT review carrying the harness marker, inline where they sit on
    the diff, the rest listed in its body; no findings posts `Harness review: no findings. Checked: <checked>`.
    Returns (review_id, inline, outside): the id GitHub gave the review (None for a no-findings post, or when the
    reply names none) and the findings posted inline and in the body. Problem when the post fails."""
    if not findings:
        gh(["pr", "review", str(number), "--comment", "-b",
            f"Harness review: no findings. Checked: {checked}\n\n{MARKER}"], repo.root)
        return None, [], []
    slug = repo.slug()
    diff = gh_run(["pr", "diff", str(number)], repo.root)
    if diff.returncode != 0:
        warn("harness-pr", f"gh pr diff {number} failed ({first_line(diff.stderr) or f'exit {diff.returncode}'}); "
                           "every finding goes in the review body")
        lines = set()
    else:
        lines = diff_lines(diff.stdout)
    inline, outside = [], []
    for f in findings:
        (inline if f["path"] and f["line"] and (f["path"], f["line"]) in lines else outside).append(f)
    comments = [{"path": f["path"], "line": f["line"], "side": "RIGHT",
                 "body": f"[{f['severity']}] {f['body']}\n\n{MARKER}"} for f in inline]
    call = ["api", "-X", "POST", f"repos/{slug}/pulls/{number}/reviews", "--input", "-"]
    payload = {"event": "COMMENT", "body": review_body(model, findings, outside), "comments": comments}
    done = gh_run(call, repo.root, stdin=json.dumps(payload))
    if done.returncode != 0 and comments:
        warn("harness-pr",
             f"GitHub refused the inline comments ({first_line(done.stderr) or f'exit {done.returncode}'}); "
             "posting every finding in the review body")
        inline, outside = [], findings
        payload = {"event": "COMMENT", "body": review_body(model, findings, outside), "comments": []}
        done = gh_run(call, repo.root, stdin=json.dumps(payload))
    if done.returncode != 0:
        raise Problem(f"{describe(call)} failed: {first_line(done.stderr) or f'exit {done.returncode}'}")
    try:
        reply = json.loads(done.stdout)
    except ValueError:
        reply = None
    review_id = reply.get("id") if isinstance(reply, dict) else None
    if not isinstance(review_id, int) or isinstance(review_id, bool):
        review_id = None
    return review_id, inline, outside


def cmd_review(args):
    repo = open_repo()
    number = args.number
    findings = load_findings(args.findings)
    _review_id, inline, outside = post_review(repo, number, findings, args.model, args.checked)
    if not findings:
        print(f"PR #{number}: review posted, no findings")
        return 0
    print(f"PR #{number}: review posted, {plural(len(findings), 'finding')} "
          f"({len(inline)} inline, {len(outside)} in the body)")
    return 0


# --------------------------------------------------------------- findings
def merge_base(path):
    """The merge-base of HEAD and origin/main, else of HEAD and main, in the worktree at `path`."""
    for target in ("origin/main", "main"):
        done = git(path, "merge-base", "HEAD", target)
        if done.returncode == 0 and done.stdout.strip():
            return done.stdout.strip()
    raise Problem(f"no merge-base of HEAD and origin/main or main in {path}")


def touched_files(path, base):
    """The files the branch at `path` changed since `base`."""
    return set(nul_fields(git_ok(path, "diff", "--name-only", "-z", base, "HEAD")))


def split_findings(findings, touched):
    """(blocking, low, outside): high and medium on a touched file, low on one, anything on another path."""
    blocking, low, outside = [], [], []
    for f in findings:
        if f["path"] not in touched:
            outside.append(f)
        else:
            (low if f["severity"] == "low" else blocking).append(f)
    return blocking, low, outside


def ruling_lines(text):
    """The `Ruling:` lines of a rulings file (optionally bulleted with `- `), in order."""
    return [m.group(1).rstrip() for m in RULING_LINE.finditer(text or "")]


def notes_line(f, outside):
    """One notes bullet; the body on one line, so no heading can start a line of it."""
    line = f"- {where(f)} [{f.get('severity')}] {one_line(f.get('body') or '')}"
    return f"{line} {OUTSIDE_NOTE}" if outside else line


def notes_text(rounds, rulings, tickets=()):
    """notes.md from every round and every ruling: Low findings, Out of scope, Rulings, each once and each left out
    when empty. An out-of-scope line whose finding was ticketed ends in ` -> #<n>`."""
    numbers = {tuple(t["key"]): t["number"] for t in tickets}
    low, out_of_scope = [], []
    for rnd in rounds:
        low += [notes_line(f, False) for f in as_findings(rnd.get("low"))]
        for f in as_findings(rnd.get("outside")):
            if f.get("severity") == "low":
                low.append(notes_line(f, True))
                continue
            n = numbers.get(tuple(finding_key(f)))
            out_of_scope.append(notes_line(f, True) + (f" -> #{n}" if n else ""))
    sections = [("Low findings", low), ("Out of scope", out_of_scope), ("Rulings", [f"- {r}" for r in rulings])]
    parts = [f"### {name}\n" + "\n".join(dict.fromkeys(lines)) for name, lines in sections if lines]
    return "\n\n".join(parts) + "\n" if parts else ""


def round_text(number, rnd):
    lines = [f"#{number} review round {rnd.get('round')} at {rnd.get('at')}: "
             + ", ".join(f"{len(as_findings(rnd.get(k)))} {k}" for k in ("blocking", "low", "outside")),
             f"head {rnd.get('head')}, base {rnd.get('base')}"]
    for k in ("blocking", "low", "outside"):
        lines += [f"{k}: {where(f)} [{f.get('severity')}] {one_line(f.get('body') or '')}"
                  for f in as_findings(rnd.get(k))]
    return "\n".join(lines)


def as_findings(value):
    """The finding dicts of a recorded list."""
    return [f for f in value if isinstance(f, dict)] if isinstance(value, list) else []


def branch_pr(repo, number, head):
    """The number of the open PR for the worktree's branch, or None (with a warning) when there is none. Problem,
    before anything is recorded, when gh cannot tell or the PR's head is not the worktree's HEAD."""
    branch = current_branch(repo.root)
    if not branch:
        warn("harness-pr", f"no branch checked out in {repo.root}; nothing posted")
        return None
    data = gh_json(["pr", "list", "--head", branch, "--state", "open", "--json", "number,url,headRefOid"], repo.root)
    prs = [p for p in as_list(data) if isinstance(p.get("number"), int)]
    if not prs:
        warn("harness-pr", f"no open PR for {branch}; nothing posted (harness-pr open {number} first)")
        return None
    pr, sha = prs[0]["number"], str(prs[0].get("headRefOid") or "")
    if sha != head:
        raise Problem(f"PR #{pr} is at {sha[:7] or 'no known commit'}, the worktree at {head[:7]}; push first")
    return pr


def first_sentence(text):
    """The text's first sentence on one line, without its closing `.`, `!` or `?`."""
    text = one_line(text)
    m = SENTENCE_END.search(text)
    return text[:m.start()] if m else text


def ticket_title(f):
    """`<path>: <the body's first sentence>`, the sentence cut to at most 60 characters (at a word when it can)."""
    sentence = first_sentence(f.get("body") or "") or "(no body)"
    if len(sentence) > TITLE_SENTENCE:
        cut = sentence[:TITLE_SENTENCE - 1]
        word = cut.rsplit(" ", 1)[0].rstrip(" .,;:")
        sentence = (word if len(word) >= TITLE_SENTENCE // 2 else cut.rstrip()) + "…"
    return f"{f.get('path') or '(no path)'}: {sentence}"


def ticket_body(f, pr, number):
    """An out-of-scope finding as a task in templates/ticket_task.md's headings; the finding quoted, so no line of
    it can start a heading."""
    sev = f.get("severity")
    quoted = "\n".join(f"> {line}".rstrip() for line in (f.get("body") or "(no body)").splitlines())
    return "\n".join([
        "## Request",
        f"A {sev} finding outside the files #{number} changed, found in the review of PR #{pr} for #{number}:",
        "", quoted, "",
        "## Outline",
        f"1. Confirm the finding at {where(f)}: reproduce the scenario it describes.",
        "2. Fix it, or close this ticket with the reason it does not hold.", "",
        "## Definition of done",
        "- [ ] The scenario the finding describes no longer fails.",
        "- [ ] The project's verify command passes.", "",
        "## Tests that must pass",
        "- A test that reproduces the scenario: red before the fix, green after.",
        "The existing suite stays green.", "",
        "## Context",
        f"- {where(f)}: where the review found it, severity {sev}.",
        f"- Found in the review of PR #{pr} for #{number}.", ""])


def create_ticket(repo, f, epic, pr, number):
    """One proposed bug ticket for an out-of-scope finding, under `epic` when there is one; its number, or None
    after a warning naming the finding. A ticket created whose linking failed still gives its number."""
    args = (["task", "create"] + (["--parent", str(epic)] if epic else [])
            + ["--proposed", "--type", "bug", "--size", "S", "--risk", "low", "--title", ticket_title(f),
               "--body-file", "-", "--json"])
    what = f"the out-of-scope finding at {where(f)}"
    try:
        done = board_run(repo, args, check=False, stdin=ticket_body(f, pr, number))
    except Problem as err:
        warn("harness-pr", f"no ticket for {what}: {err}")
        return None
    try:
        data = json.loads(done.stdout)
    except ValueError:
        data = None
    n = data.get("number") if isinstance(data, dict) else None
    n = n if isinstance(n, int) and not isinstance(n, bool) else None
    if done.returncode != 0:
        why = one_line(done.stderr) or f"exit {done.returncode}"
        warn("harness-pr", f"ticket #{n} for {what}: {why}" if n else f"no ticket for {what}: harness-board task "
                                                                       f"create failed: {why}")
    elif n is None:
        warn("harness-pr", f"no ticket for {what}: harness-board task create printed no ticket number")
    return n


def ticket_outside(repo, key, number, pr):
    """A ticket for each high or medium outside finding of any recorded round not ticketed yet (by path and body),
    so one whose create failed is tried again even when no later review repeats it; the new numbers."""
    recorded = {tuple(t["key"]) for t in load_tickets(key, number)}
    wanted = []
    for f in (f for rnd in load_rounds(key, number) for f in as_findings(rnd.get("outside"))):
        k = tuple(finding_key(f))
        if f.get("severity") in ("high", "medium") and k not in recorded:
            recorded.add(k)
            wanted.append(f)
    if not wanted:
        return []
    try:
        parent = show_ticket(repo, number).get("parent")
    except Problem as err:
        warn("harness-pr", f"no out-of-scope tickets this round: {err}")
        return []
    epic = parent.get("number") if isinstance(parent, dict) else None
    epic = epic if isinstance(epic, int) and not isinstance(epic, bool) else None
    made = []
    for f in wanted:
        n = create_ticket(repo, f, epic, pr, number)
        if n is not None:
            add_ticket(key, number, f, n)
            made.append(n)
    return made


def cmd_findings(args):
    number = args.number
    if args.latest:
        if args.review or args.rulings:
            raise Problem("--latest takes no --review or --rulings")
        repo = open_repo(args.worktree)
        rnd = latest_round(repo.key, number)
        if rnd is None:
            print(f"no review round recorded for #{number}", file=sys.stderr)
            return 1
        emit(args.json, rnd, round_text(number, rnd))
        return 0
    if not args.review:
        raise Problem("findings needs --review F (or --latest)")
    repo = open_repo(args.worktree)
    rulings = ruling_lines(read_text(args.rulings, "rulings file")) if args.rulings else []
    findings = None
    if read_text(args.review, "review file").strip():      # an empty file is a reviewer that wrote nothing
        try:
            findings = load_findings(args.review)
        except Problem:
            pass
    if findings is None:
        print(f"{args.review}: no findings array; the review stage failed", file=sys.stderr)
        return 1
    head = git_ok(repo.root, "rev-parse", "HEAD").strip()
    fork = merge_base(repo.root)
    blocking, low, outside = split_findings(findings, touched_files(repo.root, fork))
    pr = branch_pr(repo, number, head)                 # refuses before anything is posted or recorded
    review_id = None
    if pr is not None:                                 # a failed post raises, and nothing is recorded
        review_id, inline, off = post_review(repo, pr, blocking + low, args.model, DEFAULT_CHECKED)

    key = repo.key
    rounds = load_rounds(key, number)
    earlier = rounds[:-1] if rounds and rounds[-1].get("head") == head else rounds
    base = earlier[-1].get("head") if earlier else fork
    rnd = save_round(key, number, {"at": now_iso(), "head": head, "base": base, "blocking": blocking, "low": low,
                                   "outside": outside, "pr": pr, "review_id": review_id})
    k = rnd["round"]
    folder = reviews_dir(key, number)
    files = {"blocking": os.path.join(folder, f"round-{k}-blocking.json"),
             "review": os.path.join(folder, f"round-{k}-review.json"),
             "notes": os.path.join(folder, "notes.md")}
    write_json(files["blocking"], blocking, prefix=".findings-")
    write_json(files["review"], blocking + low, prefix=".findings-")
    all_rulings = add_rulings(key, number, rulings)
    tickets = ticket_outside(repo, key, number, pr) if pr is not None else []
    write_text(files["notes"], notes_text(load_rounds(key, number), all_rulings, load_tickets(key, number)),
               prefix=".findings-")

    stage, result = ("review", "pass") if k == 1 else ("fix", "fail" if blocking else "pass")
    out = {"ticket": number, "round": k, "head": head, "base": base, "review_base": head, "blocking": blocking,
           "low": low, "outside": outside, "files": files, "record": {"stage": stage, "result": result},
           "pr": pr, "review_id": review_id, "tickets": tickets}
    lines = [f"#{number} review round {k}: {len(blocking)} blocking, {len(low)} low, "
             f"{len(outside)} outside; record: harness-work stage {number} {stage} {result}"]
    if pr is not None:
        lines.append(f"PR #{pr}: review posted, " + (f"{plural(len(blocking + low), 'finding')} ({len(inline)} "
                                                     f"inline, {len(off)} in the body)" if blocking + low
                                                     else "no findings"))
    if tickets:
        lines.append("out-of-scope tickets: " + ", ".join(f"#{n}" for n in tickets))
    text = "\n".join(lines + [f"{name}: {short_home(path)}" for name, path in files.items()])
    emit(args.json, out, text)
    return 0


# --------------------------------------------------------------- checks
def check_entries(rollup):
    """The lib's check_entries (so checks, land and the gate agree) over the rollup read through as_list."""
    return lib_check_entries(as_list(rollup))


def failed_logs(repo, failed):
    """[{"run", "name", "tail"}] for the failed checks that are GitHub Actions runs."""
    logs, seen = [], set()
    for e in failed:
        m = RUN_URL.search(e["url"])
        if not m or m.group(1) in seen:
            continue
        seen.add(m.group(1))
        done = gh_run(["run", "view", m.group(1), "--log-failed"], repo.root, timeout=120)
        text = tail(done.stdout, RUN_LOG_LINES) if done.returncode == 0 else \
            f"(gh run view {m.group(1)} --log-failed failed: {first_line(done.stderr) or f'exit {done.returncode}'})"
        logs.append({"run": m.group(1), "name": e["name"], "tail": text})
    return logs


def cmd_checks(args):
    repo = open_repo()
    number = args.number
    interval = poll_interval()
    deadline = time.monotonic() + args.timeout
    started = time.monotonic()
    empty_polls = 0
    while True:
        entries = check_entries(pr_view(repo, number, "statusCheckRollup").get("statusCheckRollup"))
        state = overall(entries)
        empty_polls = empty_polls + 1 if state == "none" else 0
        if not args.wait or state in ("success", "failure"):
            break
        if state == "none" and empty_polls >= NO_CHECKS_POLLS:
            break
        if time.monotonic() + interval > deadline:
            break
        time.sleep(interval)
    failed = [e for e in entries if e["bucket"] == "fail"]
    pending = [e for e in entries if e["bucket"] == "pending"]
    logs = failed_logs(repo, failed) if failed else []
    if args.json:
        emit(True, {"number": number, "state": state, "checks": entries,
                    "failed": [e["name"] for e in failed], "pending": [e["name"] for e in pending],
                    "logs": logs}, "")
    if state == "none":
        warn("harness-pr", f"no checks registered on PR #{number}")
        return 0
    if state == "success":
        if not args.json:
            print(f"PR #{number}: checks green ({', '.join(e['name'] for e in entries)})")
        return 0
    if state == "pending":
        waited = f" after {round(time.monotonic() - started)} s" if args.wait else ""
        if not args.json:
            print(f"PR #{number}: checks pending{waited}: {', '.join(e['name'] for e in pending)}")
        return 8
    if not args.json:
        print(f"PR #{number}: checks failed: " + ", ".join(f"{e['name']} ({e['state'].lower()})" for e in failed))
        for log in logs:
            print(f"\n--- {log['name']}: gh run view {log['run']} --log-failed (last {RUN_LOG_LINES} lines) ---")
            print(log["tail"])
    sys.stdout.flush()
    sys.stderr.write(f"harness-pr: checks failed on PR #{number}: {', '.join(e['name'] for e in failed)}\n")
    return 1


# --------------------------------------------------------------- the review gate
def api_list(repo, path):
    """Every item of a REST list endpoint, all pages (gh may print one JSON array per page)."""
    call = ["api", "--paginate", path]
    text = gh(call, repo.root).strip()
    decoder, items, at = json.JSONDecoder(), [], 0
    while at < len(text):
        try:
            page, at = decoder.raw_decode(text, at)
        except ValueError:
            raise Problem(f"{describe(call)} printed something other than JSON: {first_line(text[at:])[:80]}") \
                from None
        if not isinstance(page, list):
            raise Problem(f"{describe(call)} printed something other than a list")
        items += page
        while at < len(text) and text[at].isspace():
            at += 1
    return items


def latest_harness_review(reviews):
    """The submitted review with the newest submitted_at whose body carries the harness marker, or None."""
    found = [(parse_iso(r.get("submitted_at")), r) for r in reviews
             if isinstance(r, dict) and MARKER in (r.get("body") or "") and parse_iso(r.get("submitted_at"))]
    return max(found, key=lambda pair: pair[0])[1] if found else None


def short(text, n=100):
    text = one_line(text)
    return text if len(text) <= n else text[:n - 3] + "..."


def gate_severity(value):
    """A finding's severity for the review gate: one of SEVERITIES, else high (fail closed)."""
    sev = str(value or "").lower()
    return sev if sev in SEVERITIES else "high"


def review_findings(repo, slug, number, review):
    """([(severity, "path:line [severity] body")], unlisted) of a harness review: the body's list and the inline
    comments, [] when it says "no findings"; a finding without a recognisable severity is high. unlisted is how
    many more high plus medium findings the summary line counts than are listed, the counts read by
    autoland.review_counts (a summary it cannot read: how many more findings of any severity the total counts,
    each as high)."""
    body = review.get("body") or ""
    if body.startswith("Harness review: no findings."):
        return [], 0
    found = []
    for line in body.splitlines():
        m = BODY_FINDING.match(line)
        if m:
            found.append((gate_severity(m.group(2)), f"{m.group(1).strip('`')} [{m.group(2)}] {short(m.group(3))}"))
    for c in api_list(repo, f"repos/{slug}/pulls/{number}/reviews/{review.get('id')}/comments"):
        if not isinstance(c, dict):
            continue
        text = (c.get("body") or "").replace(MARKER, "").strip()
        line = c.get("line") or c.get("original_line")
        place = f"{c.get('path') or '(no path)'}" + (f":{line}" if line else "")
        m = INLINE_SEVERITY.match(text)
        found.append((gate_severity(m.group(1) if m else None), f"{place} {short(text)}"))
    counts = review_counts(body)
    if counts is not None:
        listed = sum(1 for sev, _ in found if sev != "low")
        return found, max(counts["high"] + counts["medium"] - listed, 0)
    m = REVIEW_COUNT.match(body)
    return found, max(int(m.group(1)) - len(found), 0) if m else 0


def review_gate(repo, number):
    """(the latest harness review, its high and medium findings, its low findings, how many more high or medium
    findings its summary counts than it lists) when that review has findings and no commit on the PR is newer than
    it; else (review or None, [], [], 0). A failing gh call raises Problem."""
    slug = repo.slug()
    review = latest_harness_review(api_list(repo, f"repos/{slug}/pulls/{number}/reviews"))
    if review is None:
        return None, [], [], 0
    found, unlisted = review_findings(repo, slug, number, review)
    if not found and not unlisted:
        return review, [], [], 0
    submitted = parse_iso(review.get("submitted_at"))
    for c in api_list(repo, f"repos/{slug}/pulls/{number}/commits"):
        meta = c.get("commit") if isinstance(c, dict) else None
        meta = meta if isinstance(meta, dict) else {}
        when = None
        for who in ("committer", "author"):
            person = meta.get(who)
            when = when or (parse_iso(person.get("date")) if isinstance(person, dict) else None)
        if when is not None and when > submitted:
            return review, [], [], 0
    return (review, [text for sev, text in found if sev != "low"], [text for sev, text in found if sev == "low"],
            unlisted)


def unaddressed(number, review, blocking, unlisted):
    """The refusal: the high and medium findings listed, then a line for those the summary counts beyond them."""
    items = blocking + ([f"{unlisted} more high or medium not listed (see the review)"] if unlisted else [])
    return (f"PR #{number}: the latest harness review ({review.get('submitted_at')}) has "
            f"{plural(len(blocking) + unlisted, 'high or medium finding')} and no commit after it: " + "; ".join(items))


# --------------------------------------------------------------- ready
def cmd_ready(args):
    repo = open_repo()
    number = args.number
    try:
        review, blocking, lows, unlisted = review_gate(repo, number)
    except Problem as err:
        raise Problem(f"cannot check the harness review findings of PR #{number}: {err}") from None
    if blocking or unlisted:
        raise Problem(unaddressed(number, review, blocking, unlisted)
                      + f"; fix them, push, then harness-pr ready {number}")
    gh(["pr", "ready", str(number)], repo.root)
    view = pr_view(repo, number, "url,title,closingIssuesReferences")
    url, title = view.get("url") or "", view.get("title") or ""
    tickets = [args.ticket] if args.ticket else closing_numbers(view)
    error = None
    for n in tickets:
        try:
            board(repo, "status", str(n), "in-review", "--comment", f"PR #{number} ready for review: {url}")
        except Problem as err:
            error = error or err
    notify(f"{repo.name} PR #{number} ready for review: {title}", f"harness-{repo.key}-pr-{number}")
    print(f"PR #{number} ready for review: {url}")
    if lows:
        warn("harness-pr", f"PR #{number}: {plural(len(lows), 'low finding')} left for the owner: " + "; ".join(lows))
    if not tickets:
        warn("harness-pr", f"PR #{number} names no ticket (no Closes #N, no --ticket); no status changed")
    if error:
        raise Problem(f"PR #{number} is ready, but {error}")
    return 0


# --------------------------------------------------------------- comments
def conversation_of(repo, number):
    owner, name = repo.slug().split("/", 1)
    data = gh_json(["api", "graphql", "-f", f"query={CONVERSATION}", "-f", f"owner={owner}", "-f", f"repo={name}",
                    "-F", f"number={number}"], repo.root)
    pr = ((data.get("data") or {}).get("repository") or {}).get("pullRequest") if isinstance(data, dict) else None
    if not isinstance(pr, dict):
        raise Problem(f"PR #{number} not found in {repo.slug()}")
    return pr


def entry(node):
    author = node.get("author") if isinstance(node.get("author"), dict) else {}
    return {"author": author.get("login") or "ghost", "body": node.get("body") or "",
            "created_at": node.get("createdAt") or "", "url": node.get("url") or ""}


def newer(node, since):
    when = parse_iso(node.get("createdAt") or node.get("created_at"))
    return since is None or (when is not None and when > since)


def conversation(pr, since=None, unresolved=False):
    """Threads, reviews and comments without the harness's own (the marker) and, with `since`, only the newer
    ones (a thread is kept whole when any comment in it is newer)."""
    threads = []
    for t in as_list(pr.get("reviewThreads")):
        nodes = [c for c in as_list(t.get("comments")) if MARKER not in (c.get("body") or "")]
        if not nodes or (unresolved and t.get("isResolved")) or not any(newer(c, since) for c in nodes):
            continue
        anchor = next((c for c in nodes if c.get("path")), nodes[0])
        threads.append({"resolved": bool(t.get("isResolved")), "path": anchor.get("path") or "",
                        "line": anchor.get("line"), "comments": [entry(c) for c in nodes]})
    if unresolved:
        return {"threads": threads, "reviews": [], "comments": []}
    reviews = [dict(entry(r), state=r.get("state") or "") for r in as_list(pr.get("reviews"))
               if (r.get("body") or "").strip() and MARKER not in r.get("body") and newer(r, since)]
    comments = [entry(c) for c in as_list(pr.get("comments"))
                if MARKER not in (c.get("body") or "") and newer(c, since)]
    return {"threads": threads, "reviews": reviews, "comments": comments}


def quoted_body(body):
    lines = (body or "").strip().splitlines() or [""]
    return "\n".join([lines[0]] + ["    " + line for line in lines[1:]])


def cmd_comments(args):
    repo = open_repo()
    number = args.number
    since = None
    if args.since is not None:
        since = parse_iso(args.since)
        if since is None:
            raise Problem(f"--since: not an ISO-8601 time: {args.since!r}")
    found = conversation(conversation_of(repo, number), since, args.unresolved)
    if args.json:
        emit(True, dict({"number": number}, **found), "")
        return 0
    if not any(found.values()):
        print(f"No {'unresolved threads' if args.unresolved else 'comments'} on PR #{number}.")
        return 0
    blocks = []
    for resolved in (False, True):
        group = [t for t in found["threads"] if t["resolved"] == resolved]
        if not group:
            continue
        lines = [f"## {'Resolved' if resolved else 'Unresolved'} threads ({len(group)})"]
        for t in group:
            spot = f"`{t['path']}:{t['line']}`" if t["line"] else f"`{t['path']}`" if t["path"] else "(general)"
            lines.append(f"- {spot} {t['comments'][0]['url']}".rstrip())
            lines += [f"  - **{c['author']}** ({c['created_at'][:10]}): {quoted_body(c['body'])}"
                      for c in t["comments"]]
        blocks.append("\n".join(lines))
    if found["reviews"]:
        blocks.append("\n".join([f"## Reviews ({len(found['reviews'])})"] + [
            f"- **{r['author']}** {r['state']} ({r['created_at'][:10]}): {quoted_body(r['body'])}"
            for r in found["reviews"]]))
    if found["comments"]:
        blocks.append("\n".join([f"## Comments ({len(found['comments'])})"] + [
            f"- **{c['author']}** ({c['created_at'][:10]}): {quoted_body(c['body'])}" for c in found["comments"]]))
    print("\n\n".join(blocks))
    return 0


# --------------------------------------------------------------- awaiting
CHECK_WORDS = {"success": "green", "failure": "red", "pending": "pending", "none": "none"}


def age(created):
    when = parse_iso(created)
    if when is None:
        return "?"
    minutes = max(0, int((dt.datetime.now(dt.timezone.utc) - when).total_seconds() // 60))
    if minutes < 60:
        return f"{minutes}m"
    if minutes < 24 * 60:
        return f"{minutes // 60}h"
    return f"{minutes // (24 * 60)}d"


def awaiting_in(repo, project=None):
    prs = gh_json(["pr", "list", "--author", "@me", "--state", "open", "--json", AWAIT_FIELDS], repo.root)
    rows = []
    for pr in prs if isinstance(prs, list) else []:
        if not isinstance(pr, dict) or pr.get("isDraft") or not pr.get("number"):
            continue
        number = int(pr["number"])
        threads = conversation(conversation_of(repo, number), unresolved=True)["threads"]
        tickets = closing_numbers(pr)
        m = TICKET_BRANCH.match(pr.get("headRefName") or "")
        ticket = tickets[0] if tickets else int(m.group(1)) if m else None
        row = {"number": number, "title": pr.get("title") or "", "ticket": ticket, "url": pr.get("url") or "",
               "created_at": pr.get("createdAt") or "", "age": age(pr.get("createdAt")),
               "checks": CHECK_WORDS[overall(check_entries(pr.get("statusCheckRollup")))],
               "unresolved": len(threads)}
        rows.append(dict({"project": project}, **row) if project else row)
    return rows


def registry_projects():
    path = harness_home("projects.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as err:
        raise Problem(f"cannot read {path}: {err}") from None
    projects = data.get("projects") if isinstance(data, dict) else None
    out = []
    for p in projects if isinstance(projects, list) else []:
        if isinstance(p, dict) and isinstance(p.get("path"), str):
            out.append((p.get("name") or os.path.basename(p["path"].rstrip("/")), os.path.expanduser(p["path"])))
    return out


def cmd_awaiting(args):
    rows, errors = [], []
    if args.all_projects:
        for name, path in registry_projects():
            if not os.path.isdir(path) or git(path, "remote", "get-url", "origin").returncode != 0:
                continue
            try:
                rows += awaiting_in(Repo(path), name)
            except Problem as err:
                errors.append(f"{name}: {err}")
    else:
        rows = awaiting_in(open_repo())
    if args.json:
        emit(True, rows, "")
    elif not rows:
        print("No pull requests awaiting you.")
    else:
        head = (["PROJECT"] if args.all_projects else []) + ["PR", "TITLE", "TICKET", "AGE", "CHECKS", "UNRESOLVED",
                                                             "URL"]
        body = [([r["project"]] if args.all_projects else []) +
                [f"#{r['number']}", r["title"], f"#{r['ticket']}" if r["ticket"] else "-", r["age"], r["checks"],
                 str(r["unresolved"]), r["url"]] for r in rows]
        print(table([head] + body))
    for line in errors:
        warn("harness-pr", line)
    return 0


# --------------------------------------------------------------- ultra
def find_findings(data):
    """The findings in ultrareview's JSON, whatever its shape: a top-level list, a `findings` list (at any
    depth), else every object that has a `severity`."""
    if isinstance(data, list):
        return [d for d in data if isinstance(d, dict)]
    stack = [data]
    while stack:
        node = stack.pop(0)
        if isinstance(node, dict):
            if isinstance(node.get("findings"), list):
                return [d for d in node["findings"] if isinstance(d, dict)]
            stack.extend(node.values())
        elif isinstance(node, list):
            stack.extend(node)
    found, stack = [], [data]
    while stack:
        node = stack.pop(0)
        if isinstance(node, dict):
            if "severity" in node:
                found.append(node)
            else:
                stack.extend(node.values())
        elif isinstance(node, list):
            stack.extend(node)
    return found


def severity_line(findings):
    counts = {}
    for f in findings:
        sev = str(f.get("severity") or "unrated").strip().lower() or "unrated"
        counts[sev] = counts.get(sev, 0) + 1
    rank = {s: i for i, s in enumerate(SEVERITY_RANK)}
    order = sorted(counts, key=lambda s: (rank.get(s, len(rank)), s))
    return ", ".join(f"{counts[s]} {s}" for s in order)


def mark_cloud_exhausted(reason):
    path = harness_home("budgets.json")
    data = read_json(path)
    data = data if isinstance(data, dict) else {}
    until = (dt.datetime.now(dt.timezone.utc) + dt.timedelta(hours=EXHAUSTED_HOURS)).strftime("%Y-%m-%dT%H:%M:%SZ")
    data["cloud"] = {"exhausted_until": until, "reason": reason}
    write_json(path, data, prefix=".harness-pr-")
    return until


def cmd_ultra(args):
    """Run `claude ultrareview`, unless the project's HARNESS_ULTRAREVIEW is off (the environment, else the main
    checkout's settings.json): then one line saying so and nothing run, unless --force. Each problem load_routing
    finds is one `harness-pr: warning:` line, with --force too; an invalid HARNESS_ULTRAREVIEW is ignored."""
    repo = open_repo()
    number = args.number
    routing = load_routing(repo.main)
    for problem in routing["problems"]:
        warn("harness-pr", problem)
    if not routing["ultrareview"] and not args.force:
        print(f"ultrareview PR #{number}: off for this project (HARNESS_ULTRAREVIEW=off); nothing run")
        return 0
    exe = os.environ.get("HARNESS_CLAUDE", "claude")
    cmd = [exe, "ultrareview", str(number), "--json", "--timeout", str(ULTRA_MINUTES)]
    cmd += ["--post"] if args.post else []
    try:
        done = subprocess.run(cmd, cwd=repo.root, capture_output=True, text=True, encoding="utf-8", errors="replace",
                              stdin=subprocess.DEVNULL, timeout=(ULTRA_MINUTES + 10) * 60)
    except FileNotFoundError:
        raise Problem(f"claude not found ({exe})") from None
    except OSError as err:
        raise Problem(f"cannot run claude ({exe}): {err.strerror or err}") from None
    except subprocess.TimeoutExpired:
        raise Problem(f"claude ultrareview {number} did not finish in {ULTRA_MINUTES + 10} minutes") from None
    path = repo.state("ultra", f"{number}.json")
    if done.stdout.strip():
        write_text(path, done.stdout, prefix=".harness-pr-")
    if done.returncode != 0:
        output = (done.stdout or "") + "\n" + (done.stderr or "")
        hit = next((line for line in output.splitlines() if BILLING.search(line)), None)
        if hit:
            reason = one_line(hit)[:200]
            until = mark_cloud_exhausted(reason)
            raise Problem(f"ultrareview PR #{number} failed (exit {done.returncode}): {reason}; "
                          f"the cloud budget is marked exhausted until {until}")
        why = last_line(done.stderr) or last_line(done.stdout) or "no output"
        raise Problem(f"ultrareview PR #{number} failed (exit {done.returncode}): {why}")
    saved = f"saved {short_home(path)}" if done.stdout.strip() else "no output to save"
    try:
        data = json.loads(done.stdout)
    except ValueError:
        print(f"ultrareview PR #{number}: done, the output is not JSON so findings were not counted; {saved}")
        return 0
    findings = find_findings(data)
    posted = "; posted to the PR" if args.post else ""
    if findings:
        print(f"ultrareview PR #{number}: {plural(len(findings), 'finding')} ({severity_line(findings)}){posted}; "
              f"{saved}")
    else:
        print(f"ultrareview PR #{number}: no findings{posted}; {saved}")
    return 0


# --------------------------------------------------------------- land
def worktree_for(main, branch):
    """The path of the worktree that has `branch` checked out, or None."""
    return next((w.path for w in worktree_entries(main, git_ok) if w.branch == branch), None)


def ticket_parent(repo, number):
    """The ticket's epic: `parent` in the ticket cache, else GitHub's sub-issue parent (404: none)."""
    data = read_json(repo.state("tickets", f"{number}.json"))
    parent = data.get("parent") if isinstance(data, dict) else None
    n = parent.get("number") if isinstance(parent, dict) else None
    if isinstance(n, int) and n > 0:
        return n
    call = ["api", f"repos/{repo.slug()}/issues/{number}/parent"]
    done = gh_run(call, repo.main)
    if done.returncode != 0:
        if re.search(r"\b404\b|Not Found", (done.stderr or "") + (done.stdout or "")):
            return None
        raise Problem(f"{describe(call)} failed: {first_line(done.stderr) or f'exit {done.returncode}'}")
    try:
        found = json.loads(done.stdout or "null")
    except ValueError:
        raise Problem(f"{describe(call)} printed something other than JSON") from None
    n = found.get("number") if isinstance(found, dict) else None
    return n if isinstance(n, int) and n > 0 else None


def second_level_heading(text):
    """The text of the first `## ` heading outside a code fence in `text`, else None."""
    fenced = False
    for line in (text or "").splitlines():
        if FENCE.match(line):
            fenced = not fenced
        elif not fenced:
            m = HEADING.match(line)
            if m:
                return m.group(1).strip()
    return None


def without_section(body, name):
    """`body` minus the `## <name>` section (heading to the next `## ` heading, fences respected)."""
    kept, skipping, fenced = [], False, False
    for line in (body or "").splitlines():
        if FENCE.match(line):
            fenced = not fenced
        elif not fenced:
            m = HEADING.match(line)
            if m:
                skipping = m.group(1).strip().rstrip(":").strip().lower() == name
        if not skipping:
            kept.append(line)
    return "\n".join(kept)


def body_sections(body):
    """{lower-cased `## ` heading: its text, surrounding blank lines dropped}; headings in code fences do not
    count."""
    sections, current, fenced = {}, None, False
    for line in (body or "").splitlines():
        if FENCE.match(line):
            fenced = not fenced
        elif not fenced:
            m = HEADING.match(line)
            if m:
                current = m.group(1).strip().rstrip(":").strip().lower()
                sections.setdefault(current, [])
                continue
        if current is not None:
            sections[current].append(line.rstrip())
    return {k: "\n".join(v).strip("\n") for k, v in sections.items()}


def evidence(body):
    """(the red-run line, the verify result) from a PR body: the `Red run ...` line without its colon, and the
    last non-empty line of the fence that follows a `Verify:` label or a `## Verify` heading (blank lines may
    come between). None for what the body lacks."""
    red = verify = block = None
    fenced = label = False
    for line in (body or "").splitlines():
        text = line.strip()
        if FENCE.match(line):
            if block is not None:                  # the verify fence closes
                verify, block = last_line("\n".join(block)) or None, None
            elif label and not fenced:             # the verify fence opens
                block = []
            fenced, label = not fenced, False
        elif block is not None:
            block.append(line)
        elif not fenced and text:
            if red is None and RED_LINE.match(text):
                red = text.rstrip(":").strip()
            label = verify is None and bool(VERIFY_LABEL.match(text))
    return red, verify


def view_files(data):
    """The changed paths a `gh pr view --json files` answer holds (GitHub stops at 100)."""
    return [f["path"] for f in as_list(data.get("files")) if isinstance(f, dict) and isinstance(f.get("path"), str)
            and f["path"]]


def changed_files(repo, number, cwd):
    """Every path PR `number` changes, in GitHub's order, from the paginated files endpoint (`gh pr view --json
    files` stops at 100). --slurp makes gh print one array of the page arrays instead of the pages back to back."""
    endpoint = f"repos/{repo.slug()}/pulls/{number}/files?per_page=100"
    pages = gh_json(["api", endpoint, "--paginate", "--slurp"], cwd)
    if not isinstance(pages, list):
        raise Problem(f"gh api {endpoint} printed no list of files")
    paths = []
    for page in pages:
        for f in (page if isinstance(page, list) else [page]):
            name = f.get("filename") if isinstance(f, dict) else None
            if isinstance(name, str) and name:
                paths.append(name)
    return paths


def resolution_body(data, files, sha, url):
    """The `**Resolution**` comment for a landed PR, from `gh pr view --json body,url` and its changed `files`: the
    Summary and Notes sections, the files changed, the Definition of done as landed, the red-run and verify lines, the PR and
    the squash sha. What the body lacks is left out."""
    body = data.get("body") or ""
    sections = body_sections(body)
    red, verify = evidence(without_section(body, "notes"))     # the proof lines are the Tests', not the Notes'
    url = data.get("url") or url
    parts = [RESOLUTION]
    if sections.get("summary", "").strip():
        parts += ["", sections["summary"]]
    if sections.get("notes", "").strip():
        parts += ["", "Notes:", sections["notes"]]
    if files:
        parts += ["", f"Files changed ({len(files)}):"] + [f"- `{path}`" for path in files]
    if sections.get("definition of done", "").strip():
        parts += ["", "Definition of done:", sections["definition of done"]]
    closing = ([red] if red else []) + ([f"Verify: {verify}"] if verify else []) \
        + ([f"PR: {url}"] if url else []) + ([f"Squash commit: {sha}"] if sha else [])
    if closing:
        parts += [""] + closing
    return "\n".join(parts)


def landed_here(body, sha, pr):
    """Whether a (non-Resolution) comment records this landing: `Landed in <sha>` with this sha as a whole token,
    or `Landed in PR #<pr>` with this number as a whole token; an earlier pass's `Landed in` does not count."""
    marks = [rf"{LANDED} PR #{pr}(?!\d)"] + ([rf"{LANDED} {re.escape(sha)}(?![0-9A-Za-z])"] if sha else [])
    return any(re.search(mark, body) for mark in marks)


def resolution_here(body, url):
    """Whether a comment is this landing's Resolution: a `**Resolution**` whose `PR:` line is this PR's `url`."""
    return bool(url) and body.startswith(RESOLUTION) \
        and any(line.strip() == f"PR: {url}" for line in body.splitlines())


def cost_block(repo, number, pr):
    """`harness-work cost N --pr P --markdown` for the ticket, stripped; "" when it prints nothing. A run that
    fails, times out or cannot start is one warning line and "": the land goes on without the block."""
    try:
        done = tool("harness-work", ["cost", str(number), "--pr", str(pr), "--markdown", "--repo", repo.main],
                    repo.main, check=False)
    except Problem as err:
        warn("harness-pr", f"no cost block for #{number}: {err}")
        return ""
    if done.returncode != 0:
        warn("harness-pr", f"no cost block for #{number}: {first_line(done.stderr) or f'exit {done.returncode}'}")
        return ""
    return (done.stdout or "").strip()


def land_ticket(repo, number, sha, pr, resolution, url=None):
    """Close the ticket when GitHub has not, drop its status labels, comment the Resolution (`resolution()`) and
    then `Landed in <sha>` unless the ticket already has this landing's own (a resumed land; this landing's
    `Landed in` there means both are), check its epic. Only this landing's comments count: `Landed in` this sha
    or this PR (with no sha, the Squash commit of this PR's Resolution), and a Resolution naming this PR's
    `url`; a reopened ticket's earlier pass leaves its own, which
    do not, so its second landing gets a Resolution and `Landed in` of its own. (summary, error)."""
    done = []
    try:
        info = gh_json(["issue", "view", str(number), "--json", "state,labels,comments"], repo.main)
        info = info if isinstance(info, dict) else {}
        if str(info.get("state", "")).upper() != "CLOSED":
            board(repo, "close", str(number))
            done.append("closed")
        else:
            done.append("closed by GitHub")
        statuses = [label.get("name") for label in as_list(info.get("labels"))
                    if str(label.get("name") or "").startswith("status:")]
        if statuses:
            cmd = ["issue", "edit", str(number)]
            for name in statuses:
                cmd += ["--remove-label", name]
            gh(cmd, repo.main)
            done.append("status labels removed")
        bodies = [(c.get("body") or "").lstrip() for c in as_list(info.get("comments"))]
        mine = [b for b in bodies if resolution_here(b, url)]
        # no sha this run: an earlier run of this landing that knew it left it as its Resolution's Squash commit
        shas = [sha] if sha else [m.group(1) for b in mine
                                  for m in re.finditer(r"^\s*Squash commit: (\S+)\s*$", b, re.MULTILINE)]
        if any(landed_here(b, s, pr) for b in bodies if not b.startswith(RESOLUTION) for s in shas or [""]):
            done.append("landed comment already there")
        else:
            # the Resolution goes first: a land that stops between the two still finds `Landed in` missing
            if not mine:
                text = resolution()                # the PR's, shared by its tickets; the Cost block is this one's
                block = cost_block(repo, number, pr)
                board(repo, "comment", str(number), "--body", f"{text}\n\n{block}" if block else text)
            board(repo, "comment", str(number), "--body", f"{LANDED} {sha}" if sha else f"{LANDED} PR #{pr}")
            done.append("commented")
        parent = ticket_parent(repo, number)
        if parent:
            said = first_line(board(repo, "epic-check", str(parent)))
            done.append(f"epic check: {said or f'#{parent} checked'}")
    except Problem as err:
        return f"#{number} {', '.join(done) or 'unchanged'}", str(err)
    return f"#{number} {', '.join(done)}", None


def merge_preconditions(repo, number, view):
    """Refuse a draft, a conflict or checks that are not green; the view, fetched again while GitHub has not
    worked out mergeability."""
    main = repo.main
    if view.get("isDraft"):
        raise Problem(f"PR #{number} is a draft; harness-pr ready {number} first")
    interval = poll_interval()
    for _ in range(MERGEABLE_RETRIES):
        if str(view.get("mergeable") or "").upper() != "UNKNOWN":
            break
        time.sleep(min(MERGEABLE_SLEEP, interval))
        view = pr_view(repo, number, LAND_FIELDS, main)
    mergeable = str(view.get("mergeable") or "").upper()
    if mergeable == "CONFLICTING":
        raise Problem(f"PR #{number} conflicts with main; update the branch, then land again")
    if mergeable == "UNKNOWN":
        warn("harness-pr", f"GitHub has not worked out whether PR #{number} merges cleanly; trying the merge")
    entries = check_entries(view.get("statusCheckRollup"))
    checks = overall(entries)
    if checks == "failure":
        raise Problem(f"checks are red on PR #{number}: " + ", ".join(
            f"{e['name']} ({e['state'].lower()})" for e in entries if e["bucket"] == "fail"))
    if checks == "pending":
        raise Problem(f"checks are still running on PR #{number}: " + ", ".join(
            e["name"] for e in entries if e["bucket"] == "pending") + f"; harness-pr checks {number} --wait")
    if checks == "none":
        warn("harness-pr", f"no checks registered on PR #{number}")
    return view


def land_gate(repo, number, accept):
    """Refuse a PR whose latest harness review has high or medium findings and no newer commit, and fail closed
    when gh cannot tell; with --accept-findings, warn instead. Low findings never refuse."""
    try:
        review, blocking, _lows, unlisted = review_gate(repo, number)
    except Problem as err:
        if not accept:
            raise Problem(f"cannot check the harness review findings of PR #{number}: {err}") from None
        warn("harness-pr",
             f"cannot check the harness review findings of PR #{number} ({err}); landing it (--accept-findings)")
        return
    if (blocking or unlisted) and not accept:
        raise Problem(unaddressed(number, review, blocking, unlisted)
                      + f"; fix them and push, or harness-pr land {number} --accept-findings to land it anyway")
    if blocking or unlisted:
        warn("harness-pr", unaddressed(number, review, blocking, unlisted) + "; landing it (--accept-findings)")


def cmd_land(args):
    """Merge and clean up; on a PR that is already merged (an earlier land stopped at a dirty worktree, or it
    was merged on GitHub), skip the preconditions and the merge and finish the cleanup."""
    repo = open_repo()
    main = repo.main
    number = args.number
    view = pr_view(repo, number, LAND_FIELDS, main)
    state = str(view.get("state") or "OPEN").upper()
    resume = state == "MERGED"
    if resume:
        print("already merged, finishing cleanup")
        sys.stdout.flush()
    elif state == "CLOSED":
        raise Problem(f"PR #{number} was closed without being merged; nothing to land")
    elif state != "OPEN":
        raise Problem(f"PR #{number} is {state.lower()}, not open")
    else:
        view = merge_preconditions(repo, number, view)
        land_gate(repo, number, args.accept_findings)
    tickets = closing_numbers(view)
    if not tickets:
        warn("harness-pr", f"PR #{number} closes no issue (no Closes #N in its body); no ticket to close")
    branch = view.get("headRefName") or ""
    title = view.get("title") or ""

    if not resume:
        gh(["pr", "merge", str(number), "-R", repo.slug(), "--squash", "--delete-branch"], main, timeout=120)
    sha = ""
    try:
        merged = pr_view(repo, number, "mergeCommit", main).get("mergeCommit")
        sha = str(merged.get("oid") or "") if isinstance(merged, dict) else ""
    except Problem as err:
        warn("harness-pr", f"could not read the merge commit: {err}")
    merged_as = f" as {sha[:12]}." if sha else "."
    summary = [(f'PR #{number} "{title}" was already merged into main' if resume
                else f'Merged PR #{number} "{title}" into main') + merged_as]
    problems = []

    git(main, "worktree", "prune")            # forget worktrees whose folder was removed by hand
    wt = worktree_for(main, branch) if branch else None
    vanished = None
    if wt and not os.path.isdir(wt):          # still listed (locked) but gone from disk: nothing to remove
        vanished, wt = wt, None
    if wt and os.path.realpath(wt) == main:
        problems.append(f"the main checkout is on {branch}; switch it to main, then git branch -D {branch}")
        summary.append(f"Worktree: the main checkout is on {branch}; nothing removed.")
    else:
        if wt:
            dirty = dirty_files(wt)
            if dirty and not args.discard:
                print(summary[0])
                print(f"The worktree {wt} has uncommitted changes: {listing(dirty)}")
                print(f"To finish: harness-pr land {number} --discard (drops them and completes the cleanup),"
                      " or by hand:")
                print(f"  git -C {main} worktree remove --force {wt}")
                print(f"  git -C {main} branch -D {branch}")
                sys.stdout.flush()
                raise Problem(f"PR #{number} is merged, but the worktree {wt} is dirty; cleanup stopped "
                              f"(harness-pr land {number} --discard finishes it)")
            removed = git(main, "worktree", "remove", *(["--force"] if args.discard else []), wt)
            if removed.returncode != 0:
                problems.append(f"git worktree remove {wt} failed: {last_line(removed.stderr)}")
        exists = branch and git(main, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0
        deleted = False
        if exists and not problems:
            gone = git(main, "branch", "-D", branch)
            deleted = gone.returncode == 0
            if not deleted:
                problems.append(f"git branch -D {branch} failed: {last_line(gone.stderr)}")
        where_line = (f"removed {wt}" if wt and not problems else f"kept {wt}" if wt
                      else f"{vanished} was already gone" if vanished else f"no worktree for {branch}")
        branch_line = (f"branch {branch} deleted" if deleted else f"branch {branch} kept" if exists
                       else f"no local branch {branch}")
        summary.append(f"Worktree: {where_line}; {branch_line}.")

    fetched = git(main, "fetch", "--prune", timeout=PUSH_TIMEOUT)
    if fetched.returncode != 0:
        problems.append(f"git fetch --prune failed: {last_line(fetched.stderr)}")
    on = current_branch(main)
    cleaned = []
    if on == "main":
        # what the pull brings in: main's upstream after the fetch, else the merge commit; no sha, no comparison
        identical, blocking, restored = [], [], None
        target = sha and (git(main, "rev-parse", "--verify", "--quiet", "@{upstream}^{commit}").stdout.strip()
                          or sha)
        if target and git(main, "merge-base", "--is-ancestor", "HEAD", target).returncode == 0:
            try:
                identical, blocking = fast_forward_blockers(main, target)
            except Problem as err:
                warn("harness-pr", f"could not compare the main checkout with the landed content: {err}")
        if blocking:
            problems.append(f"the main checkout {main} has uncommitted changes that differ from the landed content "
                            f"and that the fast-forward would overwrite: {listing(blocking)}; main not pulled")
        elif identical:
            restored = git(main, "--literal-pathspecs", "checkout", target, "--", *identical)
            if restored.returncode != 0:
                problems.append(f"git checkout {target[:12]} -- {listing(identical)} failed: "
                                f"{last_line(restored.stderr)}; main not pulled")
        if blocking or (restored is not None and restored.returncode != 0):
            main_line = "fetched; main not pulled"
        else:
            cleaned = identical
            pulled = git(main, "pull", "--ff-only", timeout=PUSH_TIMEOUT)
            if pulled.returncode != 0:
                problems.append(f"git pull --ff-only failed: {last_line(pulled.stderr)}")
            main_line = "fetched and fast-forwarded main" if pulled.returncode == 0 else "fetched; main not pulled"
    else:
        main_line = f"fetched; on {on or 'a detached HEAD'}, so main was not pulled"
    summary.append(f"Main checkout: {main_line if fetched.returncode == 0 else 'fetch failed'}.")
    summary.extend(f"  cleaned {name} (identical to the landed content)" for name in cleaned)

    made = {}

    def resolution():
        """The Resolution comment, read from the PR once however many tickets it closes; every changed file from
        the files endpoint, or the PR view's (at most 100) when that fails."""
        if "text" not in made:
            try:
                data = pr_view(repo, number, "body,files,url", main)
            except Problem as err:
                raise Problem(f"the Resolution could not be written, so nothing was commented: {err}") from None
            files = view_files(data)
            try:
                listed = changed_files(repo, number, main)
            except Problem as err:
                warn("harness-pr", f"could not list PR #{number}'s files ({err}); the Resolution lists the "
                                   f"{len(files)} that gh pr view returned")
            else:
                files = listed if len(listed) >= len(files) else files
            made["text"] = resolution_body(data, files, sha, view.get("url"))
        return made["text"]

    ticket_lines = []
    for n in tickets:
        line, error = land_ticket(repo, n, sha, number, resolution, view.get("url"))
        ticket_lines.append(line)
        if error:
            problems.append(f"ticket #{n}: {error}")
    summary.append("Ticket: " + ("; ".join(ticket_lines) if ticket_lines else "none linked") + ".")
    print("\n".join(summary))
    if problems:
        sys.stdout.flush()
        raise Problem(f"PR #{number} is merged, but: " + "; ".join(problems))
    return 0


# --------------------------------------------------------------- revert
def revert_target(text):
    """A PR number (`#` allowed, under 7 digits) or a commit sha (7 to 40 hex digits): ("pr", n) or ("sha", s)."""
    bare = text.strip().lstrip("#")
    if bare.isdigit() and len(bare) < 7 and int(bare) > 0:
        return "pr", int(bare)
    if SHA_TEXT.fullmatch(text.strip()):
        return "sha", text.strip().lower()
    raise argparse.ArgumentTypeError(f"not a PR number or a commit sha: {text!r}")


def merged_pr_sha(repo, number):
    """The merge commit of PR `number`; Problem unless it is merged."""
    view = pr_view(repo, number, "state,mergeCommit", repo.main)
    state = str(view.get("state") or "").upper()
    if state != "MERGED":
        why = "closed without being merged" if state == "CLOSED" else f"{state.lower() or 'not merged'}, not merged"
        raise Problem(f"PR #{number} is {why}; nothing to revert")
    merged = view.get("mergeCommit")
    sha = str(merged.get("oid") or "") if isinstance(merged, dict) else ""
    if not sha:
        raise Problem(f"PR #{number} is merged, but gh names no merge commit")
    return sha


def ready_main_checkout(main):
    """Refuse unless the main checkout is on main with no tracked changes; then fetch origin."""
    on = current_branch(main)
    if on != "main":
        raise Problem(f"the main checkout {main} is on {on or 'a detached HEAD'}, not main; nothing reverted")
    out = git_ok(main, "status", "--porcelain=v1", "--untracked-files=no")
    changed = [line[3:] for line in out.splitlines() if len(line) > 3]
    if changed:
        raise Problem(f"the main checkout {main} has tracked changes: {listing(changed)}; nothing reverted")
    git_ok(main, "fetch", "origin", timeout=PUSH_TIMEOUT)


def local_only(main):
    """The commits on main that origin/main lacks, newest first."""
    return git_ok(main, "rev-list", "origin/main..HEAD").split()


def reverts(main, commit, sha):
    return f"This reverts commit {sha}" in git_ok(main, "log", "-1", "--format=%B", commit)


def sync_main(main, sha):
    """Refuse unless main has no commit that origin/main lacks, or only one: a pending revert of `sha` (an earlier
    run whose pushes failed), so a push of main publishes nothing but the revert; else fast-forward main."""
    local = local_only(main)
    if len(local) == 1 and reverts(main, local[0], sha):
        return
    if local:
        other = next((c for c in local if not reverts(main, c, sha)), local[0])
        raise Problem(f"main in {main} has {len(local)} commit(s) not on origin/main, {other[:7]} among them; a push "
                      f"would publish them with the revert; nothing reverted")
    git_ok(main, "pull", "--ff-only", timeout=PUSH_TIMEOUT)


def existing_revert(main, sha):
    """The newest commit on main (local or pushed) saying `This reverts commit <sha>`, or None."""
    out = git(main, "log", "--format=%H", "--fixed-strings", f"--grep=This reverts commit {sha}", "HEAD").stdout
    found = out.split()
    return found[0] if found else None


def pushed(main, commit):
    return git(main, "merge-base", "--is-ancestor", commit, "origin/main").returncode == 0


def push_main(main, sha):
    """Push main, which holds the revert of `sha` as its one commit not on origin/main; a rejected push gets one
    `git pull --rebase` and one more push, only while the revert is still the one local commit. The pushed HEAD;
    Problem when the second push fails too, naming the revert commit left local."""
    if git(main, "push", "origin", "main", timeout=PUSH_TIMEOUT).returncode == 0:
        return git_ok(main, "rev-parse", "HEAD").strip()
    rebased = git(main, "pull", "--rebase", "origin", "main", timeout=PUSH_TIMEOUT)
    if rebased.returncode != 0:
        git(main, "rebase", "--abort")
    else:
        local = local_only(main)
        if len(local) != 1 or not reverts(main, local[0], sha):
            raise Problem(f"after git pull --rebase, main in {main} has {len(local)} commit(s) not on origin/main, "
                          f"not just the revert of {sha[:7]}; nothing pushed")
        if git(main, "push", "origin", "main", timeout=PUSH_TIMEOUT).returncode == 0:
            return git_ok(main, "rev-parse", "HEAD").strip()
    head = git_ok(main, "rev-parse", "HEAD").strip()
    raise Problem(f"git push origin main was rejected, also after one git pull --rebase; the revert commit "
                  f"{head[:7]} is local and unpushed in {main}")


def revert_on_main(main, sha):
    """(the revert commit on origin/main, whether this run made or pushed it)."""
    found = existing_revert(main, sha)
    if found and pushed(main, found):
        return found, False
    if not found:
        done = git(main, "revert", "--no-edit", sha)
        if done.returncode != 0:
            files = nul_fields(git(main, "diff", "--name-only", "--diff-filter=U", "-z").stdout)
            git(main, "revert", "--abort")
            if files:
                raise Problem(f"reverting {sha[:7]} gives a conflict in {listing(files)}; aborted, main unchanged")
            why = last_line(done.stderr) or last_line(done.stdout) or f"exit {done.returncode}"
            raise Problem(f"git revert {sha[:7]} failed: {why}; main unchanged")
    return push_main(main, sha), True


def landed_pr(repo, sha):
    """The PR that merged `sha` (`gh api repos/O/R/commits/<sha>/pulls`: its merge commit, else a merged one) as
    its `gh pr view`, or None."""
    pulls = [p for p in as_list(gh_json(["api", f"repos/{repo.slug()}/commits/{sha}/pulls"], repo.main))
             if isinstance(p.get("number"), int)]
    pr = next((p for p in pulls if p.get("merge_commit_sha") == sha), None) \
        or next((p for p in pulls if p.get("merged_at")), None)
    if pr is None:
        return None
    view = pr_view(repo, pr["number"], "number,title,url,headRefName,closingIssuesReferences", repo.main)
    return dict({"number": pr["number"], "title": pr.get("title") or "", "url": pr.get("html_url") or ""},
                **{k: v for k, v in view.items() if v})


def open_incident(repo, sha):
    """The open issue whose body has the line `Merge commit: <sha>`: an `incident` one, else any (a bug filed by an
    earlier run whose label edit failed, labelled `incident` now); its number, or None."""
    line = f"Merge commit: {sha}"
    for label in ([INCIDENT], []):
        flags = ["--label"] + label if label else []
        issues = gh_json(["issue", "list"] + flags + ["--state", "open", "--limit", "200", "--json", "number,body"],
                         repo.main)
        for issue in as_list(issues):
            if isinstance(issue.get("number"), int) and any(row.strip() == line
                                                            for row in (issue.get("body") or "").splitlines()):
                if not label:
                    gh(["issue", "edit", str(issue["number"]), "--add-label", INCIDENT], repo.main)
                return issue["number"]
    return None


def bug_body(sha, revert, pr, ticket, reason, evidence):
    """The incident bug, in templates/ticket_task.md's headings; `Merge commit: <sha>` on a line of its own, as
    deploy_guard writes it, so either finds the other's."""
    what = f"PR #{pr['number']} ({pr.get('title') or 'no title'})" if pr else f"Commit {sha[:7]}"
    lines = ["## Request", f"{what} was reverted on main in {revert[:7]}: {reason}.", "",
             "## Outline",
             "1. Read the evidence below and find the cause.",
             "2. Fix it, with a test that would have caught it.",
             "3. Land the change again.", "",
             "## Definition of done",
             "- [ ] The cause is fixed and the change lands again.", "",
             "## Tests that must pass",
             "- A test that would have caught it: red before the fix, green after.",
             "The existing suite stays green.", "",
             "## Context"]
    if pr:
        lines.append(f"PR: #{pr['number']} {pr.get('url') or ''}".rstrip())
    lines += [f"Merge commit: {sha}", f"Revert commit: {revert}"]
    if ticket:
        lines.append(f"Ticket: #{ticket}")
    shown = tail(evidence, EVIDENCE_TAIL_LINES) if evidence else ""
    if shown:
        lines += ["", f"Evidence (the last {EVIDENCE_TAIL_LINES} lines at most):", "```", fence_safe(shown), "```"]
    return "\n".join(lines) + "\n"


def file_bug(repo, title, body, epic):
    """`harness-board task create` for the incident bug, then the `incident` label; its number."""
    args = (["task", "create", "--type", "bug", "--risk", "high", "--size", "S"]
            + (["--parent", str(epic)] if epic else []) + ["--title", title, "--body-file", "-", "--json"])
    done = board_run(repo, args, check=False, stdin=body)
    try:
        data = json.loads(done.stdout)
    except ValueError:
        data = None
    n = data.get("number") if isinstance(data, dict) else None
    n = n if isinstance(n, int) and not isinstance(n, bool) else None
    why = one_line(done.stderr) or f"exit {done.returncode}"
    if n is None:
        raise Problem(f"harness-board task create {'failed: ' + why if done.returncode else 'printed no number'}")
    if done.returncode != 0:
        warn("harness-pr", f"bug #{n} was created, but: {why}")
    gh(["issue", "edit", str(n), "--add-label", INCIDENT], repo.main)
    return n


def ask_ticket(repo, number, question, evidence):
    """Reopen the ticket when it is closed and ask `question` there, unless it is already the newest needs-input
    question; what was done."""
    info = gh_json(["issue", "view", str(number), "--json", "state,comments"], repo.main)
    info = info if isinstance(info, dict) else {}
    done = []
    if str(info.get("state") or "").upper() != "OPEN":
        gh(["issue", "reopen", str(number)], repo.main)
        done.append("reopened")
    asked = [b for b in ((c.get("body") or "").lstrip() for c in as_list(info.get("comments")))
             if b.startswith(NEEDS_INPUT)]
    if asked and question in asked[-1]:
        return done + ["already asked"]
    args = ["needs-input", str(number), "--question", question]
    with tempfile.TemporaryDirectory(prefix="harness-revert-") as folder:
        if evidence and evidence.strip():
            path = os.path.join(folder, "evidence.log")
            write_text(path, evidence, prefix=".harness-pr-")
            args += ["--evidence-file", path]
        board(repo, *args)
    return done + ["asked"]


def revert_landed(repo, sha, reason, evidence):
    """Revert the landed commit `sha` on main through the main checkout and push it, file the incident bug under the
    ticket's epic, reopen the ticket as needs-input and notify; each step skipped when an earlier run did it.
    `evidence` is text (or None). Returns {pr, sha, revert, ticket, bug, summary}; Problem on a refusal."""
    main = repo.main
    ready_main_checkout(main)
    full = git(main, "rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}").stdout.strip()
    if not full:
        raise Problem(f"{sha} is not a commit in {main} (after git fetch origin); nothing reverted")
    if not pushed(main, full):
        raise Problem(f"{full[:7]} is not on origin/main; nothing reverted")
    sha, reason = full, one_line(reason) or DEFAULT_REASON
    sync_main(main, sha)
    pr = landed_pr(repo, sha)
    ticket = None
    if pr:
        numbers = closing_numbers(pr)
        m = TICKET_BRANCH.match(pr.get("headRefName") or "")
        ticket = numbers[0] if numbers else int(m.group(1)) if m else None
    title = pr.get("title") if pr else ""
    title = title or first_line(git_ok(main, "log", "-1", "--format=%s", sha)) or sha[:7]
    revert, made = revert_on_main(main, sha)
    acted = made
    what = f'PR #{pr["number"]} "{title}"' if pr else f'{sha[:7]} "{title}"'
    summary = [(f"Reverted {what} in {revert[:7]} and pushed it to main." if made
                else f"origin/main already reverts {what} in {revert[:7]}.")]

    bug = open_incident(repo, sha)
    if bug:
        summary.append(f"Bug: #{bug} already open.")
    else:
        epic = ticket_parent(repo, ticket) if ticket else None
        bug = file_bug(repo, f"Reverted: {title}", bug_body(sha, revert, pr, ticket, reason, evidence), epic)
        acted = True
        summary.append(f"Bug: #{bug} filed" + (f" under #{epic}" if epic else "") + ", labelled incident.")

    if ticket:
        question = f"Reverted in {revert[:7]}: {reason}. Bug #{bug} tracks the fix."
        done = ask_ticket(repo, ticket, question, evidence)
        acted = acted or done != ["already asked"]
        summary.append(f"Ticket: #{ticket} {', '.join(done)}.")
    else:
        summary.append("Ticket: none (no PR names one).")
    if acted:
        target = f"PR #{pr['number']}" if pr else sha[:7]
        notify(f"{repo.name} reverted {target}: {reason}", f"harness-{repo.key}-revert-{sha[:12]}")
    return {"pr": pr["number"] if pr else None, "sha": sha, "revert": revert, "ticket": ticket, "bug": bug,
            "summary": summary}


def cmd_revert(args):
    repo = open_repo()
    kind, target = args.target
    evidence = read_text(args.evidence_file, "evidence file") if args.evidence_file else None
    sha = merged_pr_sha(repo, target) if kind == "pr" else target
    result = revert_landed(repo, sha, args.reason, evidence)
    emit(args.json, {k: result[k] for k in ("pr", "sha", "revert", "ticket", "bug")}, "\n".join(result["summary"]))
    return 0


# --------------------------------------------------------------- gate
def cmd_gate(args):
    """The auto-land verdict for PR P: `<verdict>: <reason>`, or with --json {pr, verdict, code, reason, rule, head,
    ticket}; exit 0 whatever the verdict. A gh or git call that fails gives wait/gh naming it (fail closed)."""
    repo = open_repo()
    number, facts = args.number, {}
    try:
        fetch_origin(repo.main)
        settings = gate_settings(repo.main)
        if settings["autoland"]:
            facts = gather_facts(repo.main, repo.slug(), number)
        result = evaluate(facts, settings)
    except Problem as err:
        facts = getattr(err, "facts", None) or facts
        result = {"verdict": "wait", "code": "gh", "reason": one_line(err), "rule": None}
    out = dict({"pr": number}, **result, head=facts.get("head_sha"),
               ticket=(facts.get("ticket") or {}).get("number"))
    emit(args.json, out, f"{out['verdict']}: {out['reason']}")
    return 0


# --------------------------------------------------------------- arguments
def number_arg(text):
    digits = text.lstrip("#")
    if not digits.isdigit() or int(digits) <= 0:
        raise argparse.ArgumentTypeError(f"not a number: {text!r}")
    return int(digits)


def seconds_arg(text):
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number of seconds: {text!r}") from None
    if not value > 0:
        raise argparse.ArgumentTypeError(f"not a positive number of seconds: {text!r}")
    return value


def parser():
    ap = Parser(prog="harness-pr", description="Pull requests for tickets: open, review, findings, checks, ready, "
                                               "comments, awaiting, ultra, land, gate, revert.")
    sub = ap.add_subparsers(dest="cmd",
                            metavar="{open,review,findings,checks,ready,comments,awaiting,ultra,land,gate,revert}")
    sub.required = True

    op = sub.add_parser("open", help="push the ticket branch and open (or update) its draft PR")
    op.add_argument("number", type=number_arg, metavar="N", help="the ticket")
    op.add_argument("--worktree", metavar="PATH", help="the ticket worktree (default: the cwd)")
    op.add_argument("--verify-log", metavar="F", help=f"the verify output; its last {VERIFY_TAIL_LINES} lines go in")
    op.add_argument("--review", metavar="F", help="the reviewer's findings JSON")
    op.add_argument("--notes", metavar="F", help="markdown for a Notes section: a second pass, out-of-scope files")
    op.add_argument("--json", action="store_true", help='print {"number", "url"}')

    rv = sub.add_parser("review", help="post the reviewer's findings as a COMMENT review, inline where possible")
    rv.add_argument("number", type=number_arg, metavar="P", help="the pull request")
    rv.add_argument("--findings", required=True, metavar="F", help='[{"path", "line", "severity", "body"}]')
    rv.add_argument("--checked", metavar="TEXT", default=DEFAULT_CHECKED, help="what was checked (no findings)")
    rv.add_argument("--model", metavar="NAME", default="opus", help="the reviewer's model, named in the review")

    fd = sub.add_parser("findings", help="split a review by the ticket's changed files, record the round, notes")
    fd.add_argument("number", type=number_arg, metavar="N", help="the ticket")
    fd.add_argument("--worktree", metavar="PATH", help="the ticket worktree (default: the cwd)")
    fd.add_argument("--review", metavar="F", help="the reviewer's output: its findings array, then the verdict")
    fd.add_argument("--rulings", metavar="R", help="a file whose `Ruling:` lines go in the notes")
    fd.add_argument("--model", metavar="NAME", default="opus", help="the reviewer's model, named in the posted review")
    fd.add_argument("--latest", action="store_true", help="print the latest recorded round; write nothing")
    fd.add_argument("--json", action="store_true")

    ck = sub.add_parser("checks", help="the PR's checks: 0 green, 1 failed, 8 pending")
    ck.add_argument("number", type=number_arg, metavar="P")
    ck.add_argument("--wait", action="store_true", help="poll until the checks finish")
    ck.add_argument("--timeout", type=seconds_arg, default=1200.0, metavar="SECONDS", help="with --wait (1200)")
    ck.add_argument("--json", action="store_true")

    rd = sub.add_parser("ready", help="mark the PR ready, the ticket in-review, and notify")
    rd.add_argument("number", type=number_arg, metavar="P")
    rd.add_argument("--ticket", type=number_arg, metavar="N", help="default: the issue the PR closes")

    cm = sub.add_parser("comments", help="review threads, reviews and comments, without the harness's own")
    cm.add_argument("number", type=number_arg, metavar="P")
    cm.add_argument("--since", metavar="ISO", help="only what is newer")
    cm.add_argument("--unresolved", action="store_true", help="unresolved review threads only")
    cm.add_argument("--json", action="store_true")

    aw = sub.add_parser("awaiting", help="your open, non-draft PRs")
    aw.add_argument("--all-projects", action="store_true", help="every registered project with an origin remote")
    aw.add_argument("--json", action="store_true")

    ul = sub.add_parser("ultra", help="claude ultrareview (bills usage credits)")
    ul.add_argument("number", type=number_arg, metavar="P")
    ul.add_argument("--post", action="store_true", help="post the findings to the PR")
    ul.add_argument("--force", action="store_true", help="run even when the project's HARNESS_ULTRAREVIEW is off")

    ld = sub.add_parser("land", help="squash-merge, remove the worktree and branch, update main, close the ticket")
    ld.add_argument("number", type=number_arg, metavar="P")
    ld.add_argument("--yes", action="store_true", help="accepted and ignored (the land skill confirms)")
    ld.add_argument("--discard", action="store_true", help="remove the worktree even with uncommitted changes")
    ld.add_argument("--accept-findings", action="store_true",
                    help="land even though the latest harness review has findings and no newer commit")

    gt = sub.add_parser("gate", help="the auto-land verdict: land, wait, fix or manual, and why")
    gt.add_argument("number", type=number_arg, metavar="P")
    gt.add_argument("--json", action="store_true", help='print {"pr", "verdict", "code", "reason", "rule", '
                                                        '"head", "ticket"}')

    rt = sub.add_parser("revert", help="revert a landed PR on main, file an incident bug, reopen the ticket")
    rt.add_argument("target", type=revert_target, metavar="P|SHA", help="a merged PR, or the commit it landed as")
    rt.add_argument("--reason", metavar="TEXT", default=DEFAULT_REASON, help="why, for the ticket and the bug")
    rt.add_argument("--evidence-file", metavar="F", help="the failing check's output, for the ticket and the bug")
    rt.add_argument("--json", action="store_true", help='print {"pr", "sha", "revert", "ticket", "bug"}')
    return ap


COMMANDS = {"open": cmd_open, "review": cmd_review, "findings": cmd_findings, "checks": cmd_checks, "ready": cmd_ready,
            "comments": cmd_comments, "awaiting": cmd_awaiting, "ultra": cmd_ultra, "land": cmd_land,
            "gate": cmd_gate, "revert": cmd_revert}


def main():
    args = parser().parse_args()
    try:
        code = COMMANDS[args.cmd](args)
    except Problem as err:
        sys.stdout.flush()
        sys.exit(f"harness-pr: {one_line(err)}")
    sys.exit(code)


if __name__ == "__main__":
    run_main("harness-pr", main)
